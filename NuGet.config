<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!-- 让包缓存落在工作区内，受限环境与离线构建都能复用。 -->
    <add key="globalPackagesFolder" value=".nuget\packages" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
