<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:MiaoWu.App.Controls"
                    xmlns:conv="clr-namespace:MiaoWu.App.Converters">

    <!-- ============================================================
         基础控件样式。
         颜色/字号/尺寸全部来自 Tokens.xaml。
         大表面不使用 DropShadowEffect / BlurEffect。
         ============================================================ -->

    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:BooleanToScrollBarVisibilityConverter x:Key="BoolToScrollBarVisibility" />

    <!-- 焦点环 -->

    <Style x:Key="FocusVisual.Button">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="{StaticResource Margin.Focus}"
                               RadiusX="{StaticResource Metric.FocusRadius.Button}"
                               RadiusY="{StaticResource Metric.FocusRadius.Button}"
                               Stroke="{DynamicResource Brush.Accent}"
                               StrokeThickness="{StaticResource Metric.Focus.Stroke}"
                               SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FocusVisual.Row">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="{StaticResource Margin.Focus}"
                               RadiusX="{StaticResource Metric.FocusRadius.Row}"
                               RadiusY="{StaticResource Metric.FocusRadius.Row}"
                               Stroke="{DynamicResource Brush.Accent}"
                               StrokeThickness="{StaticResource Metric.Focus.Stroke}"
                               SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FocusVisual.Card">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="{StaticResource Margin.Focus}"
                               RadiusX="{StaticResource Metric.FocusRadius.Card}"
                               RadiusY="{StaticResource Metric.FocusRadius.Card}"
                               Stroke="{DynamicResource Brush.Accent}"
                               StrokeThickness="{StaticResource Metric.Focus.Stroke}"
                               SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FocusVisual.WindowButton">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="{StaticResource Margin.Focus.Inset}"
                            CornerRadius="{StaticResource Radius.Focus.WindowButton}"
                            BorderBrush="{DynamicResource Brush.Accent}"
                            BorderThickness="{StaticResource Thickness.Focus}"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 图标 -->

    <!-- 填充图标：几何来自 assets/svg（见 scripts/convert-svg-icons.py）。 -->
    <Style x:Key="Icon" TargetType="Path">
        <Setter Property="Width" Value="{StaticResource Metric.Icon}" />
        <Setter Property="Height" Value="{StaticResource Metric.Icon}" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Stroke" Value="{x:Null}" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- 描边图标：窗口按钮与尚未拿到填充图形的过渡图标。 -->
    <Style x:Key="Icon.Stroke" TargetType="Path" BasedOn="{StaticResource Icon}">
        <Setter Property="Fill" Value="{x:Null}" />
        <Setter Property="StrokeThickness" Value="{StaticResource Metric.Icon.Stroke}" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
    </Style>

    <Style x:Key="Icon.Solid" TargetType="Path" BasedOn="{StaticResource Icon}">
        <Setter Property="Fill" Value="{DynamicResource Brush.Text2}" />
    </Style>

    <Style x:Key="Icon.WindowGlyph" TargetType="Path" BasedOn="{StaticResource Icon}">
        <Setter Property="Width" Value="{StaticResource Metric.WindowGlyph.Size}" />
        <Setter Property="Height" Value="{StaticResource Metric.WindowGlyph.Size}" />
        <Setter Property="Fill" Value="{x:Null}" />
        <Setter Property="StrokeThickness" Value="{StaticResource Metric.WindowGlyph.Stroke}" />
        <Setter Property="StrokeStartLineCap" Value="Flat" />
        <Setter Property="StrokeEndLineCap" Value="Flat" />
        <Setter Property="StrokeLineJoin" Value="Miter" />
    </Style>

    <!-- 文字角色 -->

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <Style x:Key="Text.AppName" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{StaticResource Font.AppName.Size}" />
        <Setter Property="LineHeight" Value="{StaticResource Font.AppName.Line}" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="FontWeight" Value="{StaticResource Font.Weight.SemiBold}" />
    </Style>

    <Style x:Key="Text.Brand" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{StaticResource Font.Brand.Size}" />
        <Setter Property="LineHeight" Value="{StaticResource Font.Brand.Line}" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="FontWeight" Value="{StaticResource Font.Weight.SemiBold}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="TextAlignment" Value="Left" />
    </Style>

    <Style x:Key="Text.Section" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{StaticResource Font.Section.Size}" />
        <Setter Property="LineHeight" Value="{StaticResource Font.Section.Line}" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="FontWeight" Value="{StaticResource Font.Weight.SemiBold}" />
    </Style>

    <Style x:Key="Text.LeftSection" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{StaticResource Font.LeftSection.Size}" />
        <Setter Property="LineHeight" Value="{StaticResource Font.LeftSection.Line}" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="FontWeight" Value="{StaticResource Font.Weight.SemiBold}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text2}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style x:Key="Text.H1" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{StaticResource Font.H1.Size}" />
        <Setter Property="LineHeight" Value="{StaticResource Font.H1.Line}" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="FontWeight" Value="{StaticResource Font.Weight.SemiBold}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Text.H2" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{StaticResource Font.H2.Size}" />
        <Setter Property="LineHeight" Value="{StaticResource Font.H2.Line}" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="FontWeight" Value="{StaticResource Font.Weight.SemiBold}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Text.H3" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{StaticResource Font.H3.Size}" />
        <Setter Property="LineHeight" Value="{StaticResource Font.H3.Line}" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="FontWeight" Value="{StaticResource Font.Weight.SemiBold}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Text.Body" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{StaticResource Font.Body.Size}" />
        <Setter Property="LineHeight" Value="{StaticResource Font.Body.Line}" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Text.ListRow" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{StaticResource Font.List.Size}" />
        <Setter Property="LineHeight" Value="{StaticResource Font.List.Line}" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text2}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="Text.Group" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{StaticResource Font.Group.Size}" />
        <Setter Property="LineHeight" Value="{StaticResource Font.Group.Line}" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="FontWeight" Value="{StaticResource Font.Weight.Medium}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text3}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style x:Key="Text.Meta" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{StaticResource Font.Meta.Size}" />
        <Setter Property="LineHeight" Value="{StaticResource Font.Meta.Line}" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text3}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style x:Key="Text.Time" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{StaticResource Font.Group.Size}" />
        <Setter Property="LineHeight" Value="{StaticResource Font.Group.Line}" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text3}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style x:Key="Text.Tab" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{StaticResource Font.Tab.Size}" />
        <Setter Property="LineHeight" Value="{StaticResource Font.List.Line}" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text2}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="Text.Code" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Family.Code}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Code.Size}" />
        <Setter Property="LineHeight" Value="{StaticResource Font.Code.Line}" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    </Style>

    <Style x:Key="Text.Chip" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{StaticResource Font.Chip.Size}" />
        <Setter Property="LineHeight" Value="{StaticResource Font.Chip.Line}" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text2}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style x:Key="Text.Empty" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{StaticResource Font.Empty.Size}" />
        <Setter Property="LineHeight" Value="{StaticResource Font.Empty.Line}" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text3}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <!-- 按钮 -->

    <Style x:Key="Button.Base" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Button.Size}" />
        <Setter Property="FontWeight" Value="{StaticResource Font.Weight.Medium}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Transparent}" />
        <Setter Property="BorderBrush" Value="{x:Null}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="{StaticResource Pad.Button}" />
        <Setter Property="MinHeight" Value="{StaticResource Metric.Hit.Min}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Button}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            CornerRadius="{StaticResource Radius.Button}"
                            SnapsToDevicePixels="True">
                        <Border.Background>
                            <SolidColorBrush x:Name="BdBrush" Color="{StaticResource Color.Transparent}" />
                        </Border.Background>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBrush"
                                                        Storyboard.TargetProperty="Color"
                                                        To="{StaticResource Color.Hover}"
                                                        Duration="{StaticResource Motion.HoverDuration}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBrush"
                                                        Storyboard.TargetProperty="Color"
                                                        To="{StaticResource Color.Transparent}"
                                                        Duration="{StaticResource Motion.HoverDuration}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Sel}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{StaticResource Opacity.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Button.Ghost" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text2}" />
    </Style>

    <Style x:Key="Button.Toolbar" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
        <Setter Property="Height" Value="{StaticResource Metric.Hit.Min}" />
        <Setter Property="Padding" Value="{StaticResource Pad.Button.Toolbar}" />
    </Style>

    <Style x:Key="Button.NavItem" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Height" Value="{StaticResource Metric.Row.Workspace}" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text2}" />
    </Style>

    <Style x:Key="Button.Icon" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Width" Value="{StaticResource Metric.Hit.Min}" />
        <Setter Property="Height" Value="{StaticResource Metric.Hit.Min}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="Button.Primary" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Button.Size}" />
        <Setter Property="FontWeight" Value="{StaticResource Font.Weight.Medium}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
        <Setter Property="Padding" Value="{StaticResource Pad.Button.Primary}" />
        <Setter Property="Height" Value="{StaticResource Metric.Button.Primary.Height}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Button}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            CornerRadius="{StaticResource Radius.Button}"
                            SnapsToDevicePixels="True">
                        <Border.Background>
                            <SolidColorBrush x:Name="BdBrush" Color="{StaticResource Color.Accent}" />
                        </Border.Background>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBrush"
                                                        Storyboard.TargetProperty="Color"
                                                        To="{StaticResource Color.AccentHover}"
                                                        Duration="{StaticResource Motion.HoverDuration}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBrush"
                                                        Storyboard.TargetProperty="Color"
                                                        To="{StaticResource Color.Accent}"
                                                        Duration="{StaticResource Motion.HoverDuration}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentPressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{StaticResource Opacity.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 左栏主操作：主题色表面 + 白字白图标（深色主题沿用同一组令牌） -->
    <Style x:Key="Button.NavAccent" TargetType="Button" BasedOn="{StaticResource Button.Primary}">
        <Setter Property="Height" Value="{StaticResource Metric.Row.Workspace}" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="{StaticResource Pad.Button.NavAccent}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="Button.Window" TargetType="Button">
        <Setter Property="Width" Value="{StaticResource Metric.WindowButton.Size}" />
        <Setter Property="Height" Value="{StaticResource Metric.WindowButton.Size}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text2}" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.WindowButton}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{DynamicResource Brush.Transparent}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.WindowButtonHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.WindowButtonPressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{StaticResource Opacity.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Button.WindowClose" TargetType="Button" BasedOn="{StaticResource Button.Window}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{DynamicResource Brush.Transparent}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.WindowCloseHover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.White}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.WindowClosePressed}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.White}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{StaticResource Opacity.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Button.TabClose" TargetType="Button">        <Setter Property="Width" Value="{StaticResource Metric.Hit.Min}" />
        <Setter Property="Height" Value="{StaticResource Metric.Hit.Min}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Opacity" Value="{StaticResource Opacity.TabClose}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Button}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="{StaticResource Opacity.TabCloseHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="{StaticResource Opacity.TabClosePressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{StaticResource Opacity.TabCloseDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 文件树展开箭头：16×16，不参与 Tab，命中区仍由 25px 行承担。 -->
    <Style x:Key="Button.TreeChevron" TargetType="Button">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="Transparent"
                            CornerRadius="3"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 分段控件 -->

    <Style x:Key="ToggleButton.Segment" TargetType="ToggleButton">
        <Setter Property="Height" Value="{StaticResource Metric.Segment.Height}" />
        <Setter Property="Padding" Value="{StaticResource Pad.Segment}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Segment.Size}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text2}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Transparent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Transparent}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Button}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.SegmentItem}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Canvas}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.TabBorder}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                            <Setter Property="FontWeight" Value="{StaticResource Font.Weight.SemiBold}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{StaticResource Opacity.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 列表项 -->

    <Style x:Key="ListBoxItem.Base" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{DynamicResource Brush.Transparent}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Row}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource Radius.Row}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Sel}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Sel}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{StaticResource Opacity.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 会话行：32 高、7px 胶囊、选中 600；分组标题行禁用并保持 25 + 上间距 10。 -->
    <Style x:Key="ListBoxItem.Session" TargetType="ListBoxItem">
        <Setter Property="Height" Value="{StaticResource Metric.Row.Session}" />
        <Setter Property="Margin" Value="8,0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="{StaticResource Thickness.Focus}"
                            CornerRadius="{StaticResource Radius.Row}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Sel}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Sel}" />
                        </MultiTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{StaticResource Opacity.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsHeader}" Value="True">
                <Setter Property="Height" Value="{StaticResource Metric.Row.Group}" />
                <Setter Property="Margin" Value="8,10,8,0" />
                <Setter Property="IsEnabled" Value="False" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Opacity" Value="1" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsHidden}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
                <Setter Property="Focusable" Value="False" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- 文件树行：25 高、5px 圆角、选中 sel2；不参与 Tab，键盘由列表统一处理。 -->
    <Style x:Key="ListBoxItem.Tree" TargetType="ListBoxItem">
        <Setter Property="Height" Value="{StaticResource Metric.Row.Tree}" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Width" Value="{Binding RowWidth}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="{StaticResource Thickness.Focus}"
                            CornerRadius="{StaticResource Radius.Tree}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Sel2}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Sel2}" />
                        </MultiTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{StaticResource Opacity.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- diff / 命令输出 / 文本行：无选中态；查找命中由行背景表达。 -->
    <Style x:Key="ListBoxItem.Line" TargetType="ListBoxItem">
        <Setter Property="MinHeight" Value="{Binding LineHeight, FallbackValue=19}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 输入框 -->

    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Body.Size}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Canvas}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line3}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{StaticResource Pad.TextBox}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Text}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Brush.AccentSoft}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.Button}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                      VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="{StaticResource Thickness.Focus}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{StaticResource Opacity.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 滚动条 -->

    <Style x:Key="ScrollThumb.Vertical" TargetType="Thumb">
        <Setter Property="Width" Value="{StaticResource Metric.ScrollThumb.Thickness}" />
        <Setter Property="MinHeight" Value="{StaticResource Metric.Hit.Min}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bd"
                            Background="{DynamicResource Brush.ScrollThumb}"
                            CornerRadius="{StaticResource Radius.ScrollThumb}"
                            SnapsToDevicePixels="True" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.ScrollThumbHover}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.ScrollThumbHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollThumb.Horizontal" TargetType="Thumb">
        <Setter Property="Height" Value="{StaticResource Metric.ScrollThumb.Thickness}" />
        <Setter Property="MinWidth" Value="{StaticResource Metric.Hit.Min}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bd"
                            Background="{DynamicResource Brush.ScrollThumb}"
                            CornerRadius="{StaticResource Radius.ScrollThumb}"
                            SnapsToDevicePixels="True" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.ScrollThumbHover}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.ScrollThumbHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="ScrollBar.VerticalTemplate" TargetType="ScrollBar">
        <Grid Width="{StaticResource Metric.ScrollBar.Size}" Background="Transparent">
            <Track x:Name="PART_Track"
                   IsDirectionReversed="True"
                   Maximum="{TemplateBinding Maximum}"
                   Minimum="{TemplateBinding Minimum}"
                   Value="{TemplateBinding Value}"
                   ViewportSize="{TemplateBinding ViewportSize}">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                  Opacity="0"
                                  Focusable="False" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource ScrollThumb.Vertical}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                  Opacity="0"
                                  Focusable="False" />
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="ScrollBar.HorizontalTemplate" TargetType="ScrollBar">
        <Grid Height="{StaticResource Metric.ScrollBar.Size}" Background="Transparent">
            <Track x:Name="PART_Track"
                   Orientation="Horizontal"
                   Maximum="{TemplateBinding Maximum}"
                   Minimum="{TemplateBinding Minimum}"
                   Value="{TemplateBinding Value}"
                   ViewportSize="{TemplateBinding ViewportSize}">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}"
                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                  Opacity="0"
                                  Focusable="False" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource ScrollThumb.Horizontal}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}"
                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                  Opacity="0"
                                  Focusable="False" />
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="{StaticResource Metric.ScrollBar.Size}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template" Value="{StaticResource ScrollBar.VerticalTemplate}" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="{StaticResource Metric.ScrollBar.Size}" />
                <Setter Property="Template" Value="{StaticResource ScrollBar.HorizontalTemplate}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        覆盖式纵向滚动条：滚动条与内容同格叠放、贴右缘浮在留白里，不占布局宽度。
        默认模板把滚动条放在 Auto 列里，出现 / 消失会让内容宽度跳 10px；整栏共享滚动时
        会话 / 文件列表会随之被挤压，因此这里改为覆盖式。
        只用于横向滚动禁用、且内容右侧自带 ≥10px 留白的滚动区域；横向滚动请继续用默认模板。
    -->
    <Style x:Key="ScrollViewer.Overlay" TargetType="ScrollViewer">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid Background="{TemplateBinding Background}" ClipToBounds="True">
                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                Margin="{TemplateBinding Padding}"
                                                CanContentScroll="{TemplateBinding CanContentScroll}"
                                                Content="{TemplateBinding Content}"
                                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                                ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                                ContentStringFormat="{TemplateBinding ContentStringFormat}" />

                        <!-- 最后声明，保证浮在内容之上；裁切由外层 Grid 的 ClipToBounds 承担。
                             MinWidth=0：系统度量会把 ScrollBar 撑到 17px，覆盖轨道必须保持 10px 令牌宽度。 -->
                        <ScrollBar x:Name="PART_VerticalScrollBar"
                                   Width="{StaticResource Metric.ScrollBar.Size}"
                                   MinWidth="0"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Stretch"
                                   Orientation="Vertical"
                                   Cursor="Arrow"
                                   Minimum="0"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                   Focusable="False"
                                   IsTabStop="False"
                                   AutomationProperties.AutomationId="VerticalScrollBar" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 工具提示 -->

    <Style TargetType="ToolTip">
        <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Meta.Size}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Canvas}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line2}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{StaticResource Pad.ToolTip}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Placement" Value="Mouse" />
        <Setter Property="HorizontalOffset" Value="8" />
        <Setter Property="VerticalOffset" Value="8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.ToolTip}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Tab}" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ============================================================
         菜单卡片：右键菜单与「更多」按钮共用。
         小面积浮层用 0.5px / 4% 黑发丝环代替弥散投影；
         大表面（面板、列表、文档）仍禁用 DropShadowEffect。
         ============================================================ -->

    <Style x:Key="Icon.Menu" TargetType="Path" BasedOn="{StaticResource Icon}">
        <Setter Property="Width" Value="{StaticResource Metric.Menu.Icon}" />
        <Setter Property="Height" Value="{StaticResource Metric.Menu.Icon}" />
        <Setter Property="Fill" Value="{DynamicResource Brush.Text3}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type MenuItem}}}"
                         Value="Danger">
                <Setter Property="Fill" Value="{DynamicResource Brush.Danger}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- 菜单卡片的公共表面：ContextMenu 与其子菜单共用。 -->
    <Style x:Key="Menu.Surface" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Canvas}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line2}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Menu}" />
        <Setter Property="Padding" Value="{StaticResource Pad.Menu}" />
        <Setter Property="MinWidth" Value="{StaticResource Metric.Menu.MinWidth}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="ContextMenu.Card" TargetType="ContextMenu">
        <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource Font.List.Size}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="Transparent"
                            BorderBrush="{DynamicResource Brush.MenuHairline}"
                            BorderThickness="{StaticResource Thickness.MenuHairline}"
                            CornerRadius="{StaticResource Radius.MenuHairline}"
                            SnapsToDevicePixels="False"
                            UseLayoutRounding="False">
                        <Border Style="{StaticResource Menu.Surface}">
                            <ScrollViewer Focusable="False"
                                          CanContentScroll="True"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </ScrollViewer>
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ContextMenu" BasedOn="{StaticResource ContextMenu.Card}" />

    <Style x:Key="MenuItem.Card" TargetType="MenuItem">
        <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource Font.List.Size}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="Padding" Value="{StaticResource Pad.MenuItem}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="ItemSurface"
                                Height="{StaticResource Metric.Menu.RowHeight}"
                                Margin="{StaticResource Margin.MenuItem}"
                                Background="Transparent"
                                CornerRadius="{StaticResource Radius.MenuItem}"
                                SnapsToDevicePixels="True">
                            <Grid Margin="{TemplateBinding Padding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource GridLength.Menu.Icon}" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ContentPresenter Grid.Column="0"
                                                  Width="{StaticResource Metric.Menu.Icon}"
                                                  Height="{StaticResource Metric.Menu.Icon}"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"
                                                  ContentSource="Icon" />

                                <Path x:Name="CheckMark"
                                      Grid.Column="0"
                                      Style="{StaticResource Icon.Menu}"
                                      Data="{StaticResource Ico.Check}"
                                      Fill="{DynamicResource Brush.Accent}"
                                      Visibility="Collapsed" />

                                <ContentPresenter Grid.Column="1"
                                                  VerticalAlignment="Center"
                                                  ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />

                                <TextBlock x:Name="GestureText"
                                           Grid.Column="2"
                                           Margin="20,0,2,0"
                                           VerticalAlignment="Center"
                                           Text="{TemplateBinding InputGestureText}"
                                           FontSize="{StaticResource Font.Meta.Size}"
                                           Foreground="{DynamicResource Brush.Text3}" />

                                <Path x:Name="SubmenuArrow"
                                      Grid.Column="3"
                                      Width="12"
                                      Height="12"
                                      Margin="8,0,0,0"
                                      Style="{StaticResource Icon}"
                                      Data="{StaticResource Ico.ChevronRight}"
                                      Fill="{DynamicResource Brush.Text3}"
                                      Visibility="Collapsed" />
                            </Grid>
                        </Border>

                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Focusable="False"
                               IsOpen="{TemplateBinding IsSubmenuOpen}"
                               Placement="Right"
                               PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                               HorizontalOffset="-6"
                               VerticalOffset="-4"
                               PopupAnimation="{DynamicResource {x:Static SystemParameters.MenuPopupAnimationKey}}">
                            <Border Background="Transparent"
                                    BorderBrush="{DynamicResource Brush.MenuHairline}"
                                    BorderThickness="{StaticResource Thickness.MenuHairline}"
                                    CornerRadius="{StaticResource Radius.MenuHairline}"
                                    SnapsToDevicePixels="False"
                                    UseLayoutRounding="False">
                                <Border Style="{StaticResource Menu.Surface}">
                                    <ScrollViewer Focusable="False"
                                                  CanContentScroll="True"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                                    </ScrollViewer>
                                </Border>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="InputGestureText" Value="">
                            <Setter TargetName="GestureText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource Brush.Hover}" />
                        </Trigger>
                        <Trigger Property="IsSubmenuOpen" Value="True">
                            <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource Brush.Hover}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Tag" Value="Danger" />
                                <Condition Property="IsHighlighted" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource Brush.DangerSoft}" />
                        </MultiTrigger>
                        <Trigger Property="Tag" Value="Danger">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{StaticResource Opacity.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem" BasedOn="{StaticResource MenuItem.Card}" />

    <Style x:Key="Menu.Separator" TargetType="Separator">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1"
                            Margin="{StaticResource Margin.MenuSeparator}"
                            Background="{DynamicResource Brush.Line2}"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Separator" BasedOn="{StaticResource Menu.Separator}" />
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}"
           TargetType="Separator"
           BasedOn="{StaticResource Menu.Separator}" />

    <!-- 栏位内卡片：错误、二进制、设置浮层。不使用投影。 -->
    <Style x:Key="Panel.Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Canvas}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line2}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
        <Setter Property="Padding" Value="18" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- 三栏宿主 -->

    <Style x:Key="PaneSplitter" TargetType="controls:PaneSplitter">
        <Setter Property="Width" Value="{StaticResource Metric.SplitterHit}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:PaneSplitter">
                    <Grid Background="Transparent">
                        <Rectangle x:Name="Line"
                                   Width="1"
                                   HorizontalAlignment="Center"
                                   Fill="{DynamicResource Brush.Line3}"
                                   Opacity="0"
                                   SnapsToDevicePixels="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IdleLineVisible" Value="True">
                            <Setter TargetName="Line" Property="Opacity" Value="1" />
                            <Setter TargetName="Line" Property="Fill" Value="{DynamicResource Brush.Line3}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IdleLineVisible" Value="False" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Line"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         BeginTime="0:0:0.1"
                                                         Duration="0:0:0.01" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Line"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="0" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Line" Property="Width" Value="2" />
                            <Setter TargetName="Line" Property="Fill" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Line" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Line" Property="Width" Value="2" />
                            <Setter TargetName="Line" Property="Fill" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Line" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CollapsiblePane" TargetType="controls:CollapsiblePane">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:CollapsiblePane">
                    <Border Background="{TemplateBinding Background}" ClipToBounds="True">
                        <ContentPresenter Width="{TemplateBinding ExpandedWidth}"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Stretch" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 复选框：15px 方框 + 勾；选中用 accent，禁用降低不透明度。 -->
    <Style TargetType="CheckBox">
        <Setter Property="FontSize" Value="{StaticResource Font.Body.Size}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent" MinHeight="{StaticResource Metric.Hit.Min}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Box"
                                Width="15"
                                Height="15"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Brush.Canvas}"
                                BorderBrush="{DynamicResource Brush.Line3}"
                                BorderThickness="1"
                                CornerRadius="3">
                            <Path x:Name="Check"
                                  Width="10"
                                  Height="10"
                                  Style="{StaticResource Icon}"
                                  Data="{StaticResource Ico.Check}"
                                  Fill="{DynamicResource Brush.White}"
                                  Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Grid.Column="1"
                                          Margin="8,0,0,0"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
