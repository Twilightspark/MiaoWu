    <sys:Double x:Key="Metric.Notification.Width">384</sys:Double>
    <sys:Double x:Key="Metric.Notification.Right">16</sys:Double>
    <sys:Double x:Key="Metric.Notification.Bottom">172</sys:Double>
    <sys:Double x:Key="Metric.Notification.BottomCollapsed">18</sys:Double>
