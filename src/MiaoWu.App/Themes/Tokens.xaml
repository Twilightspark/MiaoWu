    <!-- 读数行：20 行高 + 上下各 1，给异步落地的读数预留高度，避免输入卡跳动。 -->
    <sys:Double x:Key="Metric.Dock.Height">22</sys:Double>
    <sys:Double x:Key="Metric.Dock.Panel.Width">268</sys:Double>
    <sys:Double x:Key="Metric.Doc.CodeRadius">6</sys:Double>
    <sys:Double x:Key="Metric.Doc.BulletIndent">16</sys:Double>
    <sys:Double x:Key="Metric.Window.Min.Width">1080</sys:Double>
    <sys:Double x:Key="Metric.Window.Min.Height">760</sys:Double>
