    <Thickness x:Key="Pad.WorkspaceRow">10,0,10,0</Thickness>
    <Thickness x:Key="Pad.SessionRow">9,0,9,0</Thickness>
    <Thickness x:Key="Pad.Tab">9,0,9,0</Thickness>
