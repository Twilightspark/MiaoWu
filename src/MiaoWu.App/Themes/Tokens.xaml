<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ============================================================
         设计令牌：颜色、字体、尺寸、间距、圆角、动效。
         规则：Views / Controls 中不得出现颜色、字号、行高字面量。
         色值来源：docs/03-ui-design.md 第 5、6、7 节。
         ============================================================ -->

    <!-- 中性色 -->
    <Color x:Key="Color.Side">#F7F8FA</Color>
    <Color x:Key="Color.Canvas">#FFFFFF</Color>
    <Color x:Key="Color.Transparent">Transparent</Color>
    <Color x:Key="Color.Line">#F0F2F4</Color>
    <Color x:Key="Color.Line2">#E6E9EC</Color>
    <Color x:Key="Color.Line3">#DDE1E5</Color>
    <Color x:Key="Color.Text">#1A1E23</Color>
    <Color x:Key="Color.Text2">#5C6873</Color>
    <Color x:Key="Color.Text3">#8A95A0</Color>
    <Color x:Key="Color.Sel">#ECEFF2</Color>
    <Color x:Key="Color.Sel2">#E4E8EC</Color>
    <Color x:Key="Color.Hover">#F0F2F4</Color>
    <Color x:Key="Color.Tab">#F4F6F8</Color>
    <Color x:Key="Color.TabBorder">#E3E7EB</Color>
    <Color x:Key="Color.CodeBackground">#FAFBFC</Color>
    <Color x:Key="Color.ScrollThumb">#C9D0D6</Color>
    <Color x:Key="Color.ScrollThumbHover">#AEB8C0</Color>

    <!-- 语义色 -->
    <Color x:Key="Color.Accent">#2F7D57</Color>
    <Color x:Key="Color.AccentHover">#2A6F4D</Color>
    <Color x:Key="Color.AccentPressed">#245F42</Color>
    <Color x:Key="Color.AccentSoft">#E9F3ED</Color>
    <!-- 主题色表面上的文字与图标：深色主题下同样保持白色 -->
    <Color x:Key="Color.OnAccent">#FFFFFF</Color>
    <Color x:Key="Color.Warning">#B7841F</Color>
    <Color x:Key="Color.WarningSoft">#FFFAF0</Color>
    <Color x:Key="Color.Danger">#B42318</Color>
    <Color x:Key="Color.DangerSoft">#FDECEA</Color>
    <Color x:Key="Color.Success">#3E8E5A</Color>
    <Color x:Key="Color.Info">#2C5F74</Color>

    <!-- 预览专用：diff 增删、hunk、查找命中、浮层遮罩 -->
    <Color x:Key="Color.DiffAdd">#EDF7F0</Color>
    <Color x:Key="Color.DiffRemove">#FDECEA</Color>
    <Color x:Key="Color.DiffHunk">#F4F6F8</Color>
    <Color x:Key="Color.FindMatch">#F6EFD9</Color>
    <Color x:Key="Color.Scrim">#331A1E23</Color>
    <!-- 菜单卡片的发丝环：CSS `0 0 0 .5px #0000000A`，约 4% 黑，无模糊无偏移 -->
    <Color x:Key="Color.MenuShadow">#0A000000</Color>

    <!-- 窗口按钮 -->
    <Color x:Key="Color.WindowButtonHover">#F0F2F4</Color>
    <Color x:Key="Color.WindowButtonPressed">#E4E8EC</Color>
    <Color x:Key="Color.WindowCloseHover">#E81123</Color>
    <Color x:Key="Color.WindowClosePressed">#C50F1F</Color>
    <Color x:Key="Color.WindowBorderActive">#C9D2D9</Color>

