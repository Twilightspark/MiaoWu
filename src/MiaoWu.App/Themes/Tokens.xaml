    <SolidColorBrush x:Key="Brush.Text2" Color="{StaticResource Color.Text2}" />
    <SolidColorBrush x:Key="Brush.Text3" Color="{StaticResource Color.Text3}" />
    <SolidColorBrush x:Key="Brush.Sel" Color="{StaticResource Color.Sel}" />
    <SolidColorBrush x:Key="Brush.Sel2" Color="{StaticResource Color.Sel2}" />
    <SolidColorBrush x:Key="Brush.Hover" Color="{StaticResource Color.Hover}" />
    <SolidColorBrush x:Key="Brush.Tab" Color="{StaticResource Color.Tab}" />
    <SolidColorBrush x:Key="Brush.TabBorder" Color="{StaticResource Color.TabBorder}" />
