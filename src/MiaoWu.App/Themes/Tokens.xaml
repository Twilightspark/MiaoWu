    <Thickness x:Key="Margin.Chat.Process">14,6,14,0</Thickness>
    <!-- 组内成员：缩进 22（36 = 组头 14 + 22），只留 4 底距，
         行间距由成员自己承担，避免思考行与工具行之间叠加出空档。 -->
    <Thickness x:Key="Margin.Chat.ProcessMember">36,0,14,4</Thickness>
    <Thickness x:Key="Thickness.Chat.ProcessRule">0,0,0,1</Thickness>
    <Thickness x:Key="Margin.Chat.Notice">14,10,14,0</Thickness>
    <Thickness x:Key="Margin.Chat.Footer">0,2,0,0</Thickness>
