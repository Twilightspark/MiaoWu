    <CornerRadius x:Key="Radius.ToolTip">6</CornerRadius>
    <CornerRadius x:Key="Radius.Focus.WindowButton">3</CornerRadius>
    <CornerRadius x:Key="Radius.Window">8</CornerRadius>

    <!-- 间距 -->
    <Thickness x:Key="Pad.TopBar">14,0,8,0</Thickness>
    <!-- 白色内容面板与顶栏 / 窗口边缘的留白；左侧由 4px 分隔条充当间隙 -->
