    <sys:Double x:Key="Font.Brand.Line">38</sys:Double>
    <sys:Double x:Key="Font.Section.Line">20</sys:Double>
    <sys:Double x:Key="Font.H1.Line">32</sys:Double>
    <sys:Double x:Key="Font.H2.Line">22</sys:Double>
    <sys:Double x:Key="Font.H3.Line">22</sys:Double>
    <sys:Double x:Key="Font.Body.Line">22</sys:Double>
    <sys:Double x:Key="Font.List.Line">20</sys:Double>
