<UserControl x:Class="MiaoWu.App.Views.ClosePromptView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1440"
             d:DesignHeight="900"
             x:Name="Root"
             Focusable="False"
             Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}"
             AutomationProperties.AutomationId="ClosePrompt"
             AutomationProperties.Name="关闭确认">

    <Grid>
        <Border Background="{DynamicResource Brush.Scrim}"
                MouseLeftButtonDown="OnScrimClick" />

        <Border Width="400"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource Brush.Canvas}"
                BorderBrush="{DynamicResource Brush.Line2}"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius.Notification}">
            <Grid Margin="0,0,0,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="44" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 标题：应用小图标 + 文字；右上角是取消的图标按钮。 -->
                <Grid Grid.Row="0" Margin="18,0,10,0">
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <Image Tag="ClosePromptGlyph"
                               Width="20"
                               Height="20"
                               VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Source="pack://application:,,,/MiaoWu;component/Assets/Branding/MiaoWu.png" />
                        <TextBlock Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="关闭喵悟？"
                                   Style="{StaticResource Text.Section}" />
                    </StackPanel>

                    <Button HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Style="{StaticResource Button.Icon}"
                            Command="{Binding CancelCommand}"
                            AutomationProperties.AutomationId="ClosePromptCancel"
                            AutomationProperties.Name="取消关闭">
                        <Path Style="{StaticResource Icon}"
                              Data="{StaticResource Ico.Close}"
                              Fill="{DynamicResource Brush.Text3}" />
                    </Button>
                </Grid>

                <CheckBox Grid.Row="1"
                          Margin="18,6,18,0"
                          Content="记住我的选择，下次不再询问"
                          IsChecked="{Binding RememberChoice}"
                          AutomationProperties.AutomationId="ClosePromptRemember" />

                <StackPanel Grid.Row="2"
                            Margin="0,20,18,0"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                    <Button Height="{StaticResource Metric.Button.Primary.Height}"
                            Padding="{StaticResource Pad.Button.Primary}"
                            Content="退出应用"
                            Style="{StaticResource Button.Ghost}"
                            Foreground="{DynamicResource Brush.Danger}"
                            Command="{Binding ExitCommand}"
                            AutomationProperties.AutomationId="ClosePromptExit"
                            AutomationProperties.Name="退出应用，取消当前生成并保存" />

                    <Button x:Name="MinimizeButton"
                            Height="{StaticResource Metric.Button.Primary.Height}"
                            Margin="8,0,0,0"
                            Content="后台运行"
                            Style="{StaticResource Button.Primary}"
                            Command="{Binding MinimizeToTrayCommand}"
                            AutomationProperties.AutomationId="ClosePromptMinimize"
                            AutomationProperties.Name="{Binding MinimizeAutomationName}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
