<UserControl x:Class="MiaoWu.App.Views.ConfirmPromptView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1440"
             d:DesignHeight="900"
             x:Name="Root"
             Focusable="False"
             Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}"
             AutomationProperties.AutomationId="ConfirmPrompt"
             AutomationProperties.Name="{Binding Title}">

    <Grid>
        <Border Background="{DynamicResource Brush.Scrim}"
                MouseLeftButtonDown="OnScrimClick" />

        <!-- 与关闭确认浮层同一套卡片：400 宽、Canvas 底、1px Line2 描边、12 圆角。 -->
        <Border Width="400"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource Brush.Canvas}"
                BorderBrush="{DynamicResource Brush.Line2}"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius.Notification}">
            <Grid Margin="0,0,0,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="44" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 标题：应用小图标 + 文字；右上角是取消的图标按钮。 -->
                <Grid Grid.Row="0" Margin="18,0,10,0">
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <Image Tag="ConfirmPromptGlyph"
                               Width="20"
                               Height="20"
                               VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Source="pack://application:,,,/MiaoWu;component/Assets/Branding/MiaoWu.png" />
                        <TextBlock Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="{Binding Title}"
                                   Style="{StaticResource Text.Section}"
                                   AutomationProperties.AutomationId="ConfirmPromptTitle" />
                    </StackPanel>

                    <Button HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Style="{StaticResource Button.Icon}"
                            Command="{Binding CancelCommand}"
                            AutomationProperties.AutomationId="ConfirmPromptClose"
                            AutomationProperties.Name="{Binding CancelText}">
                        <Path Style="{StaticResource Icon}"
                              Data="{StaticResource Ico.Close}"
                              Fill="{DynamicResource Brush.Text3}" />
                    </Button>
                </Grid>

                <TextBlock Grid.Row="1"
                           Margin="18,2,18,0"
                           Text="{Binding Message}"
                           Style="{StaticResource Text.Body}"
                           Foreground="{DynamicResource Brush.Text2}"
                           AutomationProperties.AutomationId="ConfirmPromptBody" />

                <!-- 危险操作放左侧 Ghost + Danger，安全出口（取消）放右侧 Primary，与关闭浮层一致。 -->
                <StackPanel Grid.Row="2"
                            Margin="0,20,18,0"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                    <Button x:Name="AcceptButton"
                            Height="{StaticResource Metric.Button.Primary.Height}"
                            Padding="{StaticResource Pad.Button.Primary}"
                            Content="{Binding ConfirmText}"
                            Command="{Binding ConfirmCommand}"
                            AutomationProperties.AutomationId="ConfirmPromptAccept"
                            AutomationProperties.Name="{Binding ConfirmText}">
                        <!--
                            全局隐式 TextBlock 样式把文字固定成正文色，会盖掉 Button.Foreground；
                            与 Button.Primary 同样的处理：内容模板里显式绑定按钮自身的 Foreground，
                            危险操作的红字才能真正落到“删除”上。
                        -->
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                            </DataTemplate>
                        </Button.ContentTemplate>
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDestructive}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button x:Name="CancelButton"
                            Height="{StaticResource Metric.Button.Primary.Height}"
                            Margin="8,0,0,0"
                            Padding="{StaticResource Pad.Button.Primary}"
                            Content="{Binding CancelText}"
                            Style="{StaticResource Button.Primary}"
                            Command="{Binding CancelCommand}"
                            AutomationProperties.AutomationId="ConfirmPromptCancel"
                            AutomationProperties.Name="{Binding CancelText}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
