<UserControl x:Class="MiaoWu.App.Views.ConversationPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:MiaoWu.App.Views"
             xmlns:vm="clr-namespace:MiaoWu.App.ViewModels"
             xmlns:conv="clr-namespace:MiaoWu.App.Converters"
             xmlns:res="clr-namespace:MiaoWu.App.Resources"
             mc:Ignorable="d"
             d:DesignWidth="428"
             d:DesignHeight="800"
             x:Name="Root"
             Focusable="False"
             Background="{DynamicResource Brush.Canvas}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             AutomationProperties.AutomationId="ConversationPane">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <conv:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibility" />

        <!-- 输入框：工具集中在底部一行；工作区入口在标题栏。 -->
        <Style x:Key="Composer.IconButton" TargetType="Button" BasedOn="{StaticResource Button.Base}">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Button}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{DynamicResource Brush.Tab}"
                                CornerRadius="{StaticResource Radius.ComposerButton}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Sel}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Sel2}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="{StaticResource Opacity.Disabled}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Composer.SendButton" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text3}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Button}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{DynamicResource Brush.AccentSoft}"
                                CornerRadius="{StaticResource Radius.ComposerButton}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentPressed}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text3}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Composer.StopButton" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Button}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{DynamicResource Brush.Danger}"
                                CornerRadius="{StaticResource Radius.ComposerButton}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.76" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 输入框正文：去掉 TextBox 自带焦点描边，只保留外层卡片的一圈 accent。 -->
        <Style x:Key="Composer.TextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="ComposerInputBorder"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                          VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 模型入口：只做当前模型 + 展开箭头；真正的菜单在下方 Popup 里按提供商分区。 -->
        <Style x:Key="Composer.ModelButton" TargetType="Button" BasedOn="{StaticResource Button.Base}">
            <Setter Property="Height" Value="26" />
            <Setter Property="MaxWidth" Value="196" />
            <Setter Property="Padding" Value="8,0,6,0" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text2}" />
        </Style>

        <Style x:Key="Composer.ModelRowButton" TargetType="Button" BasedOn="{StaticResource Button.Base}">
            <Setter Property="Height" Value="{StaticResource Metric.Menu.RowHeight}" />
            <Setter Property="Padding" Value="{StaticResource Pad.MenuItem}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text2}" />
        </Style>

        <DataTemplate x:Key="Composer.ModelRow">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center"
                           Text="{Binding DisplayName}"
                           Style="{StaticResource Text.Chip}"
                           Foreground="{DynamicResource Brush.Text2}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           Text="{Binding Badge}"
                           Style="{StaticResource Text.Time}" />
            </Grid>
        </DataTemplate>

        <Style x:Key="ChatItemContainer" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 用户消息 -->
        <DataTemplate DataType="{x:Type vm:UserChatItemViewModel}">
            <Grid Margin="14,10,14,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Width="{StaticResource Metric.Avatar}"
                            Height="{StaticResource Metric.Avatar}"
                            Background="{DynamicResource Brush.Sel}"
                            CornerRadius="11">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Text="{x:Static res:Strings.UserInitial}"
                                   FontSize="{StaticResource Font.Group.Size}"
                                   Foreground="{DynamicResource Brush.Text2}" />
                    </Border>
                    <TextBlock Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Text="{x:Static res:Strings.UserInitial}"
                               Style="{StaticResource Text.Time}"
                               Foreground="{DynamicResource Brush.Text}"
                               FontWeight="{StaticResource Font.Weight.SemiBold}" />
                    <TextBlock Margin="6,0,0,0"
                               VerticalAlignment="Center"
                               Text="{Binding TimeText}"
                               Style="{StaticResource Text.Time}" />
                    <TextBlock Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Text="排队中"
                               Style="{StaticResource Text.Time}"
                               Foreground="{DynamicResource Brush.Warning}"
                               Visibility="{Binding IsPending, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <TextBlock Grid.Row="1"
                           Margin="30,4,0,0"
                           Text="{Binding Text}"
                           Style="{StaticResource Text.Body}"
                           TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>

        <!-- 助手消息 -->
        <DataTemplate DataType="{x:Type vm:AssistantChatItemViewModel}">
            <StackPanel Margin="14,12,14,0">
                <StackPanel Orientation="Horizontal">
                    <Border Width="{StaticResource Metric.Avatar}"
                            Height="{StaticResource Metric.Avatar}"
                            Background="{DynamicResource Brush.AccentSoft}"
                            CornerRadius="11">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Text="{x:Static res:Strings.AssistantInitial}"
                                   FontSize="{StaticResource Font.Group.Size}"
                                   Foreground="{DynamicResource Brush.Accent}" />
                    </Border>
                    <TextBlock Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Text="{x:Static res:Strings.AppName}"
                               Style="{StaticResource Text.Time}"
                               Foreground="{DynamicResource Brush.Text}"
                               FontWeight="{StaticResource Font.Weight.SemiBold}" />
                    <TextBlock Margin="6,0,0,0"
                               VerticalAlignment="Center"
                               Text="{Binding TimeText}"
                               Style="{StaticResource Text.Time}" />
                    <TextBlock Margin="6,0,0,0"
                               VerticalAlignment="Center"
                               Text="{Binding ModelText}"
                               Style="{StaticResource Text.Time}"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="190" />
                </StackPanel>

                <Border Margin="30,4,0,0"
                        Padding="0"
                        Background="Transparent"
                        Visibility="{Binding HasThinking, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <Button HorizontalAlignment="Left"
                                Style="{StaticResource Button.Toolbar}"
                                Command="{Binding ToggleThinkingCommand}"
                                AutomationProperties.Name="展开思考过程">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource Icon}"
                                      Data="{StaticResource Ico.ChevronDown}"
                                      Fill="{DynamicResource Brush.Text3}" />
                                <TextBlock Margin="4,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="思考过程"
                                           Style="{StaticResource Text.Chip}" />
                            </StackPanel>
                        </Button>
                        <TextBlock Margin="0,2,0,0"
                                   Text="{Binding ThinkingText}"
                                   Style="{StaticResource Text.Meta}"
                                   Foreground="{DynamicResource Brush.Text3}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding IsThinkingExpanded, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>

                <ItemsControl Margin="30,4,0,0"
                              ItemsSource="{Binding Blocks}"
                              Focusable="False"
                              Visibility="{Binding HasBlocks, Converter={StaticResource BoolToVisibility}}" />

                <TextBlock Margin="30,4,0,0"
                           Text="{Binding Text}"
                           Style="{StaticResource Text.Body}"
                           TextWrapping="Wrap"
                           Visibility="{Binding HasBlocks, Converter={StaticResource InverseBoolToVisibility}}" />

                <StackPanel Margin="30,4,0,0" Orientation="Horizontal">
                    <TextBlock Text="{Binding StatusText}"
                               Style="{StaticResource Text.Meta}"
                               Foreground="{DynamicResource Brush.Text3}" />
                    <TextBlock Margin="8,0,0,0"
                               Text="{Binding UsageText}"
                               Style="{StaticResource Text.Meta}"
                               Foreground="{DynamicResource Brush.Text3}" />
                    <Button Margin="8,0,0,0"
                            Style="{StaticResource Button.Toolbar}"
                            Command="{Binding CopyCommand}"
                            Visibility="{Binding HasText, Converter={StaticResource BoolToVisibility}}"
                            AutomationProperties.Name="复制回答">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon.Stroke}"
                                  Data="{StaticResource Ico.Copy}"
                                  Stroke="{DynamicResource Brush.Text3}" />
                            <TextBlock Margin="4,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="复制"
                                       Style="{StaticResource Text.Chip}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <TextBlock Margin="30,2,0,0"
                           Text="{Binding ErrorText}"
                           Style="{StaticResource Text.Meta}"
                           Foreground="{DynamicResource Brush.Danger}"
                           TextWrapping="Wrap"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />

                <Button Margin="30,2,0,0"
                        HorizontalAlignment="Left"
                        Padding="0"
                        Style="{StaticResource Button.Ghost}"
                        Command="{Binding RetryCommand}"
                        Visibility="{Binding ShowRetry, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource Icon}"
                              Data="{StaticResource Ico.Retry}"
                              Fill="{DynamicResource Brush.Accent}" />
                        <TextBlock Margin="4,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="重试"
                                   Style="{StaticResource Text.Chip}"
                                   Foreground="{DynamicResource Brush.Accent}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </DataTemplate>

        <!-- 工具卡 -->
        <DataTemplate DataType="{x:Type vm:ToolCardViewModel}">
            <Border Margin="30,6,14,0"
                    Padding="10,7"
                    Background="{DynamicResource Brush.Tab}"
                    CornerRadius="{StaticResource Radius.Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Path Width="14"
                              Height="14"
                              VerticalAlignment="Center"
                              Style="{StaticResource Icon}"
                              Fill="{DynamicResource Brush.Text3}"
                              Data="{StaticResource Ico.Terminal}" />
                        <TextBlock Grid.Column="1"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="{Binding ToolName}"
                                   Style="{StaticResource Text.Code}"
                                   Foreground="{DynamicResource Brush.Text}" />
                        <TextBlock Grid.Column="2"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="{Binding Summary}"
                                   Style="{StaticResource Text.Meta}"
                                   Foreground="{DynamicResource Brush.Text3}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="3"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="{Binding StatusText}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Meta}">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text3}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPending}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                        <Button Style="{StaticResource Button.Toolbar}"
                                Command="{Binding ToggleExpandedCommand}"
                                AutomationProperties.Name="展开工具输出">
                            <TextBlock Text="展开输出" Style="{StaticResource Text.Chip}" />
                        </Button>
                        <Button Margin="6,0,0,0"
                                Style="{StaticResource Button.Toolbar}"
                                Command="{Binding OpenFullOutputCommand}"
                                Visibility="{Binding CanOpenFullOutput, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="查看完整输出" Style="{StaticResource Text.Chip}" />
                        </Button>
                        <Button Margin="6,0,0,0"
                                Style="{StaticResource Button.Toolbar}"
                                Command="{Binding UndoCommand}"
                                Visibility="{Binding CanUndo, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="撤销写入" Style="{StaticResource Text.Chip}" />
                        </Button>
                        <TextBlock Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="{Binding DecisionText}"
                                   Style="{StaticResource Text.Meta}" />
                        <TextBlock Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="不可信内容"
                                   Style="{StaticResource Text.Meta}"
                                   Foreground="{DynamicResource Brush.Warning}"
                                   Visibility="{Binding IsUntrusted, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="已截断"
                                   Style="{StaticResource Text.Meta}"
                                   Foreground="{DynamicResource Brush.Text3}"
                                   Visibility="{Binding IsTruncated, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <TextBox Margin="0,6,0,0"
                             MaxHeight="200"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Background="{DynamicResource Brush.Canvas}"
                             Text="{Binding Output, Mode=OneWay}"
                             Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- 审批卡 -->
        <DataTemplate DataType="{x:Type vm:ApprovalCardViewModel}">
            <Border Margin="14,8,14,0"
                    Padding="12,10"
                    Background="{DynamicResource Brush.WarningSoft}"
                    BorderBrush="{DynamicResource Brush.Warning}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Path Width="16"
                              Height="16"
                              VerticalAlignment="Center"
                              Style="{StaticResource Icon}"
                              Fill="{DynamicResource Brush.Warning}"
                              Data="{StaticResource Ico.Warning}" />
                        <TextBlock Grid.Column="1"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="{Binding Title}"
                                   Style="{StaticResource Text.H3}" />
                        <TextBlock Grid.Column="2"
                                   VerticalAlignment="Center"
                                   Text="{Binding RiskText}"
                                   Style="{StaticResource Text.Meta}"
                                   Foreground="{DynamicResource Brush.Warning}" />
                    </Grid>

                    <TextBlock Margin="0,6,0,0"
                               Text="{Binding Target}"
                               Style="{StaticResource Text.Code}"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,3,0,0"
                               Text="{Binding Summary}"
                               Style="{StaticResource Text.Meta}"
                               TextWrapping="Wrap" />

                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal"
                                Visibility="{Binding IsPending, Converter={StaticResource BoolToVisibility}}">
                        <Button Content="允许一次"
                                Style="{StaticResource Button.Primary}"
                                Command="{Binding AllowOnceCommand}" />
                        <Button Margin="8,0,0,0"
                                Content="本会话允许"
                                Style="{StaticResource Button.Ghost}"
                                Command="{Binding AllowSessionCommand}"
                                Visibility="{Binding CanApproveForSession, Converter={StaticResource BoolToVisibility}}" />
                        <Button Margin="8,0,0,0"
                                Content="查看 diff"
                                Style="{StaticResource Button.Ghost}"
                                Command="{Binding ToggleDiffCommand}"
                                Visibility="{Binding CanShowDiff, Converter={StaticResource BoolToVisibility}}" />
                        <Button Margin="8,0,0,0"
                                Content="拒绝"
                                Style="{StaticResource Button.Ghost}"
                                Command="{Binding DenyCommand}" />
                    </StackPanel>

                    <TextBlock Margin="0,8,0,0"
                               Text="{Binding ResolutionText}"
                               Style="{StaticResource Text.Meta}"
                               Foreground="{DynamicResource Brush.Text3}"
                               Visibility="{Binding IsResolved, Converter={StaticResource BoolToVisibility}}" />

                    <TextBox Margin="0,8,0,0"
                             MaxHeight="180"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             HorizontalScrollBarVisibility="Auto"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="{StaticResource Font.Family.Code}"
                             Text="{Binding Diff, Mode=OneWay}"
                             Visibility="{Binding IsDiffVisible, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- 错误/提示卡 -->
        <DataTemplate DataType="{x:Type vm:NoticeChatItemViewModel}">
            <Border Margin="14,8,14,0"
                    Padding="12,9"
                    CornerRadius="{StaticResource Radius.Card}"
                    BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource Brush.Tab}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line2}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Brush.DangerSoft}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.H3}" />
                    <TextBlock Margin="0,4,0,0"
                               Text="{Binding Body}"
                               Style="{StaticResource Text.Body}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.Text2}" />
                    <Button Margin="0,8,0,0"
                            HorizontalAlignment="Left"
                            Content="{Binding ActionText}"
                            Style="{StaticResource Button.Ghost}"
                            Command="{Binding ActionCommand}"
                            Visibility="{Binding HasAction, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 会话头 -->
        <Grid Grid.Row="0"
              Height="{StaticResource Metric.RightTitle.Height}"
              Margin="14,0">
            <TextBlock VerticalAlignment="Center"
                       Text="{Binding Title}"
                       Style="{StaticResource Text.Section}"
                       TextTrimming="CharacterEllipsis"
                       Visibility="{Binding IsRenaming, Converter={StaticResource InverseBoolToVisibility}}" />

            <TextBox x:Name="RenameBox"
                     VerticalAlignment="Center"
                     Text="{Binding RenameDraft, UpdateSourceTrigger=PropertyChanged}"
                     PreviewKeyDown="OnRenameKeyDown"
                     Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />

            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <!-- 新建入口保留在左栏与 Ctrl+N；会话头只留「更多」，菜单与左栏会话行共用。 -->
                <Button x:Name="MoreButton"
                        Style="{StaticResource Button.Icon}"
                        Click="OnMoreClick"
                        IsEnabled="{Binding HasSession}"
                        ToolTip="会话操作"
                        AutomationProperties.Name="会话操作"
                        ContextMenu="{StaticResource SessionRowMenu}">
                    <Path Style="{StaticResource Icon.Solid}"
                          Data="{StaticResource Ico.More}"
                          Fill="{DynamicResource Brush.Text3}" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- 消息列表 -->
        <ListBox x:Name="MessageList"
                 Grid.Row="1"
                 ItemsSource="{Binding Items}"
                 ItemContainerStyle="{StaticResource ChatItemContainer}"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.CanContentScroll="True"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 AutomationProperties.AutomationId="ConversationMessages"
                 AutomationProperties.Name="对话消息">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>

        <!-- 空态：新会话不需要先点按钮，直接在下方输入即可创建。 -->
        <StackPanel Grid.Row="1"
                    Margin="28,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
            <TextBlock HorizontalAlignment="Center"
                       Text="{Binding EmptyTitle}"
                       Style="{StaticResource Text.Section}" />
            <TextBlock Margin="0,6,0,0"
                       MaxWidth="288"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Text="{Binding EmptyBody}"
                       Style="{StaticResource Text.Empty}"
                       Foreground="{DynamicResource Brush.Text3}" />
        </StackPanel>

        <!-- 输入框：正文 + 工具行。工作区入口在标题栏，权限说明不占常驻位置。 -->
        <Border x:Name="RightInputShell"
                Grid.Row="2"
                Height="{StaticResource Metric.Input.Height}"
                Margin="14,0,14,14"
                Padding="{StaticResource Pad.Input}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource Brush.Canvas}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line3}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="CornerRadius" Value="{StaticResource Radius.Input}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=ComposerBox}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="{StaticResource GridLength.Input.Tools}" />
                </Grid.RowDefinitions>

                <!-- 正文：固定卡片高度内滚动，避免输入时整栏跳动。 -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <TextBox x:Name="ComposerBox"
                             Style="{StaticResource Composer.TextBox}"
                             Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top"
                             FontFamily="{StaticResource Font.Family}"
                             FontSize="{StaticResource Font.Body.Size}"
                             TextBlock.LineHeight="{StaticResource Font.Body.Line}"
                             TextBlock.LineStackingStrategy="BlockLineHeight"
                             Foreground="{DynamicResource Brush.Text}"
                             PreviewKeyDown="OnComposerKeyDown"
                             AutomationProperties.AutomationId="ComposerInput"
                             AutomationProperties.Name="消息输入框" />
                    <TextBlock Margin="2,0,0,0"
                               VerticalAlignment="Top"
                               IsHitTestVisible="False"
                               Text="{Binding ComposerPlaceholder, FallbackValue=描述你想让 MiaoWu 做的事}"
                               Style="{StaticResource Text.Body}"
                               Foreground="{DynamicResource Brush.Text3}"
                               Visibility="{Binding Draft, Converter={StaticResource EmptyStringToVisibility}}" />
                </Grid>

                <!-- 工具行：预留附件、状态、当前模型、发送。 -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Style="{StaticResource Composer.IconButton}"
                            IsEnabled="False"
                            ToolTip="附件与文件引用将在后续版本提供"
                            ToolTipService.ShowOnDisabled="True"
                            AutomationProperties.Name="添加附件（暂未开放）">
                        <Path Width="14"
                              Height="14"
                              Style="{StaticResource Icon}"
                              Data="{StaticResource Ico.Plus}"
                              Fill="{DynamicResource Brush.Text2}" />
                    </Button>

                    <TextBlock Grid.Column="1"
                               Margin="8,0,10,0"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               MaxWidth="150"
                               Text="{Binding HeaderText}"
                               ToolTip="{Binding HeaderText}"
                               Style="{StaticResource Text.Time}"
                               TextTrimming="CharacterEllipsis" />

                    <Button x:Name="ModelPickerButton"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Style="{StaticResource Composer.ModelButton}"
                            Click="OnModelPickerClick"
                            ToolTip="{Binding ModelToolTip}"
                            AutomationProperties.Name="选择模型">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center"
                                       MaxWidth="148"
                                       Text="{Binding SelectedModelName, FallbackValue=选择模型}"
                                       Style="{StaticResource Text.Chip}"
                                       TextTrimming="CharacterEllipsis" />
                            <Path Width="12"
                                  Height="12"
                                  Margin="4,0,0,0"
                                  Style="{StaticResource Icon}"
                                  Data="{StaticResource Ico.ChevronDown}"
                                  Fill="{DynamicResource Brush.Text3}" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="3"
                            Margin="8,0,0,0"
                            Style="{StaticResource Composer.SendButton}"
                            Command="{Binding SendCommand}"
                            ToolTip="{Binding SendToolTip}"
                            ToolTipService.ShowOnDisabled="True"
                            AutomationProperties.Name="发送"
                            Visibility="{Binding IsIdle, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                        <Path Width="14"
                              Height="14"
                              Style="{StaticResource Icon}"
                              Data="{StaticResource Ico.Send}"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>

                    <Button Grid.Column="3"
                            Margin="8,0,0,0"
                            Style="{StaticResource Composer.StopButton}"
                            Command="{Binding StopCommand}"
                            ToolTip="停止生成"
                            AutomationProperties.Name="停止生成"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                        <Path Width="12"
                              Height="12"
                              Style="{StaticResource Icon}"
                              Data="{StaticResource Ico.Stop}"
                              Fill="{DynamicResource Brush.OnAccent}" />
                    </Button>
                </Grid>

                <!-- 模型菜单：向上展开，按提供商分区；行点击直接选中并关闭。 -->
                <Popup x:Name="ModelPopup"
                       Grid.RowSpan="2"
                       Placement="Custom"
                       PlacementTarget="{Binding ElementName=ModelPickerButton}"
                       AllowsTransparency="True"
                       StaysOpen="False"
                       Focusable="False"
                       PopupAnimation="{DynamicResource {x:Static SystemParameters.MenuPopupAnimationKey}}"
                       DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                    <Border Background="Transparent"
                            BorderBrush="{DynamicResource Brush.MenuHairline}"
                            BorderThickness="{StaticResource Thickness.MenuHairline}"
                            CornerRadius="{StaticResource Radius.MenuHairline}"
                            SnapsToDevicePixels="False"
                            UseLayoutRounding="False">
                        <Border Style="{StaticResource Menu.Surface}"
                                MinWidth="{StaticResource Metric.ModelPicker.Width}">
                            <ScrollViewer MaxHeight="{StaticResource Metric.ModelPicker.MaxHeight}"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding ModelGroups}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBlock Margin="{StaticResource Margin.ModelSection}"
                                                               Text="{Binding ProviderName}"
                                                               Style="{StaticResource Text.Group}" />
                                                    <ItemsControl ItemsSource="{Binding Models}" Focusable="False">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Style="{StaticResource Composer.ModelRowButton}"
                                                                        Content="{Binding}"
                                                                        ContentTemplate="{StaticResource Composer.ModelRow}"
                                                                        Tag="{Binding}"
                                                                        Click="OnModelRowClick"
                                                                        ToolTip="{Binding Detail}"
                                                                        AutomationProperties.Name="{Binding DisplayName}" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <StackPanel Visibility="{Binding HasModelGroups, Converter={StaticResource InverseBoolToVisibility}}">
                                        <TextBlock Margin="{StaticResource Margin.ModelSection}"
                                                   Text="{Binding ModelEmptyText}"
                                                   Style="{StaticResource Text.Meta}"
                                                   TextWrapping="Wrap" />
                                        <Button Margin="8,2,8,4"
                                                HorizontalAlignment="Left"
                                                Content="打开模型设置"
                                                Style="{StaticResource Button.Ghost}"
                                                Click="OnOpenModelSettingsClick" />
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Border>
                </Popup>
            </Grid>
        </Border>
    </Grid>
</UserControl>
