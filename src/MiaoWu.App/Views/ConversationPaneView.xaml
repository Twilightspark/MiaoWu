<UserControl x:Class="MiaoWu.App.Views.ConversationPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:MiaoWu.App.Views"
             xmlns:controls="clr-namespace:MiaoWu.App.Controls"
             xmlns:vm="clr-namespace:MiaoWu.App.ViewModels"
             xmlns:conv="clr-namespace:MiaoWu.App.Converters"
             xmlns:res="clr-namespace:MiaoWu.App.Resources"
             mc:Ignorable="d"
             d:DesignWidth="428"
             d:DesignHeight="800"
             x:Name="Root"
             Focusable="False"
             Background="Transparent"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             AutomationProperties.AutomationId="ConversationPane"
             AutomationProperties.Name="{x:Static res:Strings.MiddlePaneAutomation}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <conv:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibility" />
        <conv:BooleanToStarGridLengthConverter x:Key="BoolToStar" />
        <conv:ResourceKeyToGeometryConverter x:Key="MenuIcon" />
        <conv:PercentToArcConverter x:Key="PercentToArc" />

        <!-- 输入框：工具集中在底部一行；工作区入口在左栏。 -->
        <Style x:Key="Composer.IconButton" TargetType="Button" BasedOn="{StaticResource Button.Base}">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Button}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{DynamicResource Brush.Tab}"
                                CornerRadius="{StaticResource Radius.ComposerButton}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Sel}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Sel2}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="{StaticResource Opacity.Disabled}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Composer.SendButton" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text3}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Button}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{DynamicResource Brush.AccentSoft}"
                                CornerRadius="{StaticResource Radius.ComposerButton}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentPressed}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text3}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Composer.StopButton" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Button}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{DynamicResource Brush.Danger}"
                                CornerRadius="{StaticResource Radius.ComposerButton}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.76" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 输入框正文：去掉 TextBox 自带焦点描边，只保留外层卡片的一圈 accent。 -->
        <Style x:Key="Composer.TextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="ComposerInputBorder"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                          VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 输入框正文（RichTextBox）：去掉自带边框与内边距，只保留外层卡片的一圈 accent；
             chip 由 ComposerEditor 以内联 InlineUIContainer 渲染。 -->
        <Style x:Key="Composer.Editor" TargetType="RichTextBox">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="IsReadOnly" Value="False" />
            <Setter Property="AcceptsTab" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RichTextBox">
                        <Border x:Name="ComposerInputBorder"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                          VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 模型入口：只做当前模型 + 展开箭头；真正的菜单在下方 Popup 里按提供商分区。 -->
        <Style x:Key="Composer.ModelButton" TargetType="Button" BasedOn="{StaticResource Button.Base}">
            <Setter Property="Height" Value="26" />
            <Setter Property="MaxWidth" Value="196" />
            <Setter Property="Padding" Value="8,0,6,0" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text2}" />
        </Style>

        <Style x:Key="Composer.PlanButton" TargetType="Button" BasedOn="{StaticResource Composer.ModelButton}">
            <Setter Property="MaxWidth" Value="80" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPlanMode}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                    <Setter Property="Background" Value="{DynamicResource Brush.Sel}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 输入卡下方读数：三个只读 pill，共用 12/20 与 tertiary 静止态。 -->
        <Style x:Key="Composer.DockPill" TargetType="Button" BasedOn="{StaticResource Button.Base}">
            <Setter Property="Height" Value="{StaticResource Metric.Dock.Height}" />
            <Setter Property="Padding" Value="{StaticResource Pad.DockPill}" />
            <Setter Property="Margin" Value="{StaticResource Margin.DockPill}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text3}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Button}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                CornerRadius="{StaticResource Radius.Button}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Sel}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Sel2}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Composer.DockRowLabel"
               TargetType="TextBlock"
               BasedOn="{StaticResource Text.Dock}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text2}" />
        </Style>

        <Style x:Key="Composer.DockRowValue"
               TargetType="TextBlock"
               BasedOn="{StaticResource Text.Dock}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>

        <Style x:Key="Composer.DockPanelTitle"
               TargetType="TextBlock"
               BasedOn="{StaticResource Text.Dock}">
            <Setter Property="FontSize" Value="{StaticResource Font.Section.Size}" />
            <Setter Property="LineHeight" Value="{StaticResource Font.Section.Line}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        </Style>

        <Style x:Key="Composer.ModelRowButton" TargetType="Button" BasedOn="{StaticResource Button.Base}">
            <Setter Property="Height" Value="{StaticResource Metric.Menu.RowHeight}" />
            <Setter Property="Padding" Value="{StaticResource Pad.MenuItem}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text2}" />
        </Style>

        <DataTemplate x:Key="Composer.ModelRow">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center"
                           Text="{Binding DisplayName}"
                           Style="{StaticResource Text.Chip}"
                           Foreground="{DynamicResource Brush.Text2}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           Text="{Binding Badge}"
                           Style="{StaticResource Text.Time}" />
            </Grid>
        </DataTemplate>

        <Style x:Key="Composer.MenuRow" TargetType="Button" BasedOn="{StaticResource Button.Base}">
            <Setter Property="Height" Value="{StaticResource Metric.Menu.RowHeight}" />
            <Setter Property="Padding" Value="{StaticResource Pad.MenuItem}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text2}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource Radius.MenuItem}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Sel}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Sel}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 触发菜单一行：图标 + 标题 + 别名 / 父目录；目录行带右箭头提示可下钻。 -->
        <DataTemplate x:Key="Composer.TriggerRow">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Path Width="14"
                      Height="14"
                      VerticalAlignment="Center"
                      Stretch="Uniform"
                      Data="{Binding IconKey, Converter={StaticResource MenuIcon}}"
                      Fill="{DynamicResource Brush.Text2}" />
                <TextBlock Grid.Column="1"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           Text="{Binding Label}"
                           Style="{StaticResource Text.Chip}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           Text="{Binding Detail}"
                           Style="{StaticResource Text.Time}"
                           TextTrimming="CharacterEllipsis" />
                <Path Grid.Column="3"
                      Width="10"
                      Height="10"
                      Margin="6,0,0,0"
                      VerticalAlignment="Center"
                      Stretch="Uniform"
                      Data="{StaticResource Ico.ChevronRight}"
                      Fill="{DynamicResource Brush.Text3}"
                      Visibility="{Binding IsDirectory, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </DataTemplate>

        <Style x:Key="ChatItemContainer" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- 执行过程组收起：成员保留在列表里（重试 / 追溯仍找得到），只是折叠成 0 高 -->
                <DataTrigger Binding="{Binding IsHiddenByGroup}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <conv:NonEmptyStringToVisibilityConverter x:Key="NonEmptyToVisibility" />
        <conv:ToolIconConverter x:Key="ToolIcon" />

        <!-- 消息尾部的图标动作：24×24 命中区，16 盒描边 glyph，悬停才出浅底 -->
        <Style x:Key="Chat.ActionButton" TargetType="Button" BasedOn="{StaticResource Button.Icon}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text3}" />
        </Style>

        <!-- 会话内的描边图标：几何是 DSH 的 16 网格（16 盒 / 14 字形），
             走 Icon.Stroke.Exact 按 1:1 渲染，颜色只继承行色。 -->
        <Style x:Key="Chat.Icon" TargetType="Path" BasedOn="{StaticResource Icon.Stroke.Exact}">
            <Setter Property="Stroke" Value="{DynamicResource Brush.Text3}" />
        </Style>

        <!-- 过程行（工具调用）：整行可点，悬停出浅灰底与展开箭头 -->
        <Style x:Key="Chat.Row" TargetType="Button" BasedOn="{StaticResource Button.Base}">
            <Setter Property="MinHeight" Value="{StaticResource Metric.Chat.Row}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text2}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- 思考折叠行：与工具行同高、同字号；行距由过程成员统一。 -->
        <Style x:Key="Chat.Disclosure" TargetType="Button" BasedOn="{StaticResource Chat.Row}">
            <Setter Property="Margin" Value="0" />
        </Style>

        <!-- 展开箭头：收起指向右、展开指向下；默认隐形，悬停或展开时出现。 -->
        <Style x:Key="Chat.Chevron" TargetType="Path" BasedOn="{StaticResource Chat.Icon}">
            <Setter Property="Data" Value="{StaticResource Ico.ChevronStrokeRight}" />
            <Setter Property="Opacity" Value="0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter Property="Data" Value="{StaticResource Ico.ChevronStrokeDown}" />
                    <Setter Property="Opacity" Value="1" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <Setter Property="Opacity" Value="1" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <Setter Property="Opacity" Value="1" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- DSH 的 TurnProcess 行：没有图标、没有底色，只有一条 tertiary 状态文字 + 14 箭头；
             容器 33 高（= 24 文字行 + 8 底距 + 1 发丝线）；悬停只把文字抬到 secondary。 -->
        <Style x:Key="Chat.TurnRow" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text3}" />
            <Setter Property="Background" Value="{DynamicResource Brush.Transparent}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0,0,0,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Button}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text2}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text2}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 过程组头的箭头：始终可见；展开时旋转 180°，与 DSH 的 data-open 一致。 -->
        <Style x:Key="Chat.TurnChevron" TargetType="Path" BasedOn="{StaticResource Chat.Icon}">
            <Setter Property="Width" Value="{StaticResource Metric.Chat.Icon}" />
            <Setter Property="Height" Value="{StaticResource Metric.Chat.Icon}" />
            <Setter Property="Data" Value="{StaticResource Ico.ChevronStrokeDown}" />
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter Property="LayoutTransform">
                        <Setter.Value>
                            <RotateTransform Angle="180" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 思考行的箭头：随思考开合换向；收起时只在悬停出现。 -->
        <Style x:Key="Chat.ThinkingChevron" TargetType="Path" BasedOn="{StaticResource Chat.Icon}">
            <Setter Property="Data" Value="{StaticResource Ico.ChevronStrokeRight}" />
            <Setter Property="Opacity" Value="0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsThinkingExpanded}" Value="True">
                    <Setter Property="Data" Value="{StaticResource Ico.ChevronStrokeDown}" />
                    <Setter Property="Opacity" Value="1" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <Setter Property="Opacity" Value="1" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <Setter Property="Opacity" Value="1" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Chat.CompactionChevron" TargetType="Path" BasedOn="{StaticResource Chat.Icon}">
            <Setter Property="Data" Value="{StaticResource Ico.ChevronStrokeRight}" />
            <Setter Property="Opacity" Value="0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter Property="Data" Value="{StaticResource Ico.ChevronStrokeDown}" />
                    <Setter Property="Opacity" Value="1" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <Setter Property="Opacity" Value="1" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 压缩分隔行：说明从这里往前的对话已收进摘要；展开可看六段摘要。 -->
        <DataTemplate DataType="{x:Type vm:CompactionChatItemViewModel}">
            <StackPanel Margin="0,10,0,4">
                <Button Style="{StaticResource Chat.Disclosure}"
                        Command="{Binding ToggleCommand}"
                        ToolTip="展开或收起压缩摘要"
                        AutomationProperties.Name="展开或收起压缩摘要">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Path Style="{StaticResource Chat.Icon}" Data="{StaticResource Ico.Sparkle}" />
                        <TextBlock Grid.Column="1"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="{Binding HeaderText}"
                                   Style="{StaticResource Text.ChatProcess}" />
                        <Path Grid.Column="2"
                              Margin="6,0,0,0"
                              Style="{StaticResource Chat.CompactionChevron}" />
                    </Grid>
                </Button>
                <TextBlock Margin="22,4,0,0"
                           Text="{Binding DisplaySummary}"
                           Style="{StaticResource Text.Reasoning}"
                           TextWrapping="Wrap"
                           Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </DataTemplate>

        <!-- 用户消息：右对齐气泡，宽度上限为内容列的 70%，与助手正文左右对照；
             时间、复制与本轮计时都在气泡下方；轮内间距（4）必须小于轮次间距（18）。
             本轮一旦有执行过程组，计时交给组头，气泡下不再重复一条。 -->
        <DataTemplate DataType="{x:Type vm:UserChatItemViewModel}">
            <Grid Margin="{StaticResource Margin.Chat.User}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="7*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <Border Padding="{StaticResource Pad.Bubble}"
                            Background="{DynamicResource Brush.Tab}"
                            CornerRadius="{StaticResource Radius.Bubble}">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Images}"
                                          Focusable="False"
                                          Margin="0,0,0,6"
                                          Visibility="{Binding HasImages, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="104"
                                                Height="104"
                                                Margin="0,0,6,0"
                                                Background="{DynamicResource Brush.Canvas}"
                                                CornerRadius="{StaticResource Radius.Card}"
                                                ClipToBounds="True"
                                                ToolTip="{Binding Label}">
                                            <Image Source="{Binding Source}" Stretch="UniformToFill" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding Text}"
                                       Style="{StaticResource Text.Body}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="0,4,0,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <TextBlock x:Name="TurnStatus"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource Text.ChatProcessPreview}"
                                   Visibility="{Binding ShowTurnStatus, Converter={StaticResource BoolToVisibility}}">
                            <Run Text="{Binding TurnStatusLabel, Mode=OneWay}" />
                            <Run FontFamily="{StaticResource Font.Family.Code}"
                                 Text="{Binding TurnDuration, Mode=OneWay}" />
                        </TextBlock>

                        <Button Margin="0,0,4,0"
                                Style="{StaticResource Chat.ActionButton}"
                                Command="{Binding CopyCommand}"
                                ToolTip="复制提问"
                                AutomationProperties.Name="复制提问">
                            <Path Style="{StaticResource Chat.Icon}"
                                  Data="{StaticResource Ico.Copy}" />
                        </Button>
                        <TextBlock VerticalAlignment="Center"
                                   Text="{Binding TimeText}"
                                   Style="{StaticResource Text.Meta}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- 助手回答：左对齐正文、无卡片底色；时间、模型 / 用量与图标动作收束成一行尾部元信息；
             思考默认收起，收起时给一行摘要。 -->
        <DataTemplate DataType="{x:Type vm:AssistantChatItemViewModel}">
            <StackPanel x:Name="AssistantRoot" Margin="{StaticResource Margin.Chat.Assistant}">

                <StackPanel x:Name="ThinkingBlock"
                            Visibility="{Binding ShowThinking, Converter={StaticResource BoolToVisibility}}">
                    <Button Style="{StaticResource Chat.Disclosure}"
                            Command="{Binding ToggleThinkingCommand}"
                            ToolTip="展开或收起思考过程"
                            AutomationProperties.Name="展开或收起思考过程">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Path Style="{StaticResource Chat.Icon}"
                                  Data="{StaticResource Ico.Think}" />
                            <TextBlock Grid.Column="1"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="思考"
                                       Style="{StaticResource Text.ChatProcess}" />
                            <TextBlock Grid.Column="2"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="{Binding ThinkingPreview}"
                                       Style="{StaticResource Text.ChatProcessPreview}"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding IsThinkingExpanded, Converter={StaticResource InverseBoolToVisibility}}" />
                            <Path Grid.Column="3"
                                  Margin="6,0,0,0"
                                  Style="{StaticResource Chat.ThinkingChevron}" />
                        </Grid>
                    </Button>

                    <!-- DSH 的推理正文：组头下方缩进 22，紧贴 12/20，不再加左侧竖线 -->
                    <TextBlock Margin="22,2,0,0"
                               Text="{Binding ThinkingText}"
                               Style="{StaticResource Text.Reasoning}"
                               TextWrapping="Wrap"
                               Visibility="{Binding IsThinkingExpanded, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Blocks}"
                              Focusable="False"
                              Visibility="{Binding HasBlocks, Converter={StaticResource BoolToVisibility}}" />

                <!-- 流式首帧：Markdown 还没重建时先显示纯文本；空步骤不占一行。 -->
                <TextBlock Text="{Binding Text}"
                           Style="{StaticResource Text.Body}"
                           TextWrapping="Wrap"
                           Visibility="{Binding ShowPlainText, Converter={StaticResource BoolToVisibility}}" />

                <TextBlock Margin="0,6,0,0"
                           Text="{Binding ErrorText}"
                           Style="{StaticResource Text.Reasoning}"
                           Foreground="{DynamicResource Brush.Danger}"
                           TextWrapping="Wrap"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />

                <!-- 尾部元信息只留时间与动作：模型 / 用量不再占回答下方一行。 -->
                <Grid Margin="{StaticResource Margin.Chat.Footer}"
                      Visibility="{Binding ShowFooter, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="RunStatus"
                               Grid.Column="0"
                               VerticalAlignment="Center"
                               Text="{Binding StatusText}"
                               Style="{StaticResource Text.Meta}"
                               Visibility="{Binding StatusText, Converter={StaticResource NonEmptyToVisibility}}" />

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <TextBlock Margin="0,0,4,0"
                                   VerticalAlignment="Center"
                                   Text="{Binding TimeText}"
                                   Style="{StaticResource Text.Meta}" />
                        <Button Style="{StaticResource Chat.ActionButton}"
                                Command="{Binding CopyCommand}"
                                ToolTip="复制回答"
                                AutomationProperties.Name="复制回答"
                                Visibility="{Binding HasText, Converter={StaticResource BoolToVisibility}}">
                            <Path Style="{StaticResource Chat.Icon}"
                                  Data="{StaticResource Ico.Copy}" />
                        </Button>
                        <Button Style="{StaticResource Chat.ActionButton}"
                                Command="{Binding RetryCommand}"
                                ToolTip="重试这一轮"
                                AutomationProperties.Name="重试这一轮"
                                Visibility="{Binding ShowRetry, Converter={StaticResource BoolToVisibility}}">
                            <Path Width="14"
                                  Height="14"
                                  Style="{StaticResource Icon}"
                                  Data="{StaticResource Ico.Retry}"
                                  Fill="{DynamicResource Brush.Accent}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </StackPanel>
            <DataTemplate.Triggers>
                <!-- 只带工具调用的助手步骤没有正文与思考：整行不占高，否则组内会多出一段空白。 -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsProcessMember}" Value="True" />
                        <Condition Binding="{Binding HasThinking}" Value="False" />
                        <Condition Binding="{Binding HasVisibleText}" Value="False" />
                        <Condition Binding="{Binding HasError}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="AssistantRoot" Property="Visibility" Value="Collapsed" />
                </MultiDataTrigger>
                <!-- 过程组成员在展开时缩进 22，和组头文字对齐 -->
                <DataTrigger Binding="{Binding IsProcessMember}" Value="True">
                    <Setter TargetName="AssistantRoot"
                            Property="Margin"
                            Value="{StaticResource Margin.Chat.ProcessMember}" />
                </DataTrigger>
                <!-- 答案里的思考块与正文之间留 4；组内的行距由成员自己承担，不再叠加 -->
                <DataTrigger Binding="{Binding IsProcessMember}" Value="False">
                    <Setter TargetName="ThinkingBlock" Property="Margin" Value="0,0,0,4" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 工具调用：24 高单行摘要（族图标 + 名称 + 摘要 + 状态），整行可点展开；
             展开体是代码块 + 风险 / 决策元信息 + 完整输出与撤销入口；
             行内不铺卡片底色，避免过程行比答案更抢眼。 -->
        <DataTemplate DataType="{x:Type vm:ToolCardViewModel}">
            <StackPanel x:Name="ToolRoot" Margin="{StaticResource Margin.Chat.Tool}">
                <Button x:Name="ToolRow"
                        Style="{StaticResource Chat.Row}"
                        Command="{Binding ToggleExpandedCommand}"
                        AutomationProperties.Name="{Binding AutomationName}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Path Style="{StaticResource Chat.Icon}"
                              Data="{Binding ToolName, Converter={StaticResource ToolIcon}}" />

                        <TextBlock Grid.Column="1"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="{Binding DisplayName}"
                                   Style="{StaticResource Text.ChatProcess}"
                                   TextTrimming="CharacterEllipsis" />

                        <TextBlock Grid.Column="2"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="{Binding Summary}"
                                   Style="{StaticResource Text.ChatProcessPreview}"
                                   TextTrimming="CharacterEllipsis" />

                        <TextBlock Grid.Column="3"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="不可信内容"
                                   Style="{StaticResource Text.ChatProcessPreview}"
                                   Foreground="{DynamicResource Brush.Warning}"
                                   Visibility="{Binding IsUntrusted, Converter={StaticResource BoolToVisibility}}" />

                        <Ellipse Grid.Column="4"
                                 Margin="8,0,0,0"
                                 Width="{StaticResource Metric.Chat.StatusDot}"
                                 Height="{StaticResource Metric.Chat.StatusDot}"
                                 VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource Brush.Text3}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPending}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource Brush.Warning}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource Brush.Danger}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource Brush.Danger}" />
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsPending}" Value="False" />
                                                <Condition Binding="{Binding IsError}" Value="False" />
                                                <Condition Binding="{Binding IsBlocked}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Fill" Value="{DynamicResource Brush.Success}" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>

                        <TextBlock Grid.Column="5"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="{Binding StatusText}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.ChatProcessPreview}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPending}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Path Grid.Column="6"
                              Margin="6,0,0,0"
                              Style="{StaticResource Chat.Chevron}" />
                    </Grid>
                </Button>

                <Border Margin="0,4,0,0"
                        Padding="{StaticResource Pad.Chat.Body}"
                        Background="{DynamicResource Brush.CodeBackground}"
                        CornerRadius="{StaticResource Radius.Code}"
                        Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBox MaxHeight="200"
                                 Padding="0"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 FontFamily="{StaticResource Font.Family.Code}"
                                 FontSize="{StaticResource Font.Code.Size}"
                                 TextBlock.LineHeight="{StaticResource Font.Code.Line}"
                                 TextBlock.LineStackingStrategy="BlockLineHeight"
                                 Text="{Binding Output, Mode=OneWay}" />

                        <TextBlock Margin="0,4,0,0"
                                   Text="{Binding ErrorText}"
                                   Style="{StaticResource Text.Reasoning}"
                                   Foreground="{DynamicResource Brush.Danger}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding IsError, Converter={StaticResource BoolToVisibility}}" />

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <TextBlock Text="{Binding RiskText}" Style="{StaticResource Text.Meta}" />
                                <TextBlock Margin="8,0,0,0"
                                           Text="{Binding DecisionText}"
                                           Style="{StaticResource Text.Meta}"
                                           Visibility="{Binding DecisionText, Converter={StaticResource NonEmptyToVisibility}}" />
                                <TextBlock Margin="8,0,0,0"
                                           Text="已截断"
                                           Style="{StaticResource Text.Meta}"
                                           Visibility="{Binding IsTruncated, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="查看完整输出"
                                        Style="{StaticResource Button.Ghost}"
                                        Padding="{StaticResource Pad.Button.Toolbar}"
                                        Command="{Binding OpenFullOutputCommand}"
                                        Visibility="{Binding CanOpenFullOutput, Converter={StaticResource BoolToVisibility}}" />
                                <Button Content="撤销写入"
                                        Style="{StaticResource Button.Ghost}"
                                        Padding="{StaticResource Pad.Button.Toolbar}"
                                        Command="{Binding UndoCommand}"
                                        Visibility="{Binding CanUndo, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsProcessMember}" Value="True">
                    <Setter TargetName="ToolRoot"
                            Property="Margin"
                            Value="{StaticResource Margin.Chat.ProcessMember}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 最后一轮答案的思考：从正文行拆出来，作为执行过程组的成员；
             视觉与正文里的思考折叠行一致，只是归组收起。 -->
        <DataTemplate DataType="{x:Type vm:ProcessThinkingViewModel}">
            <StackPanel Margin="{StaticResource Margin.Chat.ProcessMember}">
                <Button Style="{StaticResource Chat.Disclosure}"
                        Command="{Binding ToggleThinkingCommand}"
                        ToolTip="展开或收起思考过程"
                        AutomationProperties.Name="{Binding AutomationName}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Path Style="{StaticResource Chat.Icon}"
                              Data="{StaticResource Ico.Think}" />
                        <TextBlock Grid.Column="1"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="思考"
                                   Style="{StaticResource Text.ChatProcess}" />
                        <TextBlock Grid.Column="2"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="{Binding ThinkingPreview}"
                                   Style="{StaticResource Text.ChatProcessPreview}"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding IsThinkingExpanded, Converter={StaticResource InverseBoolToVisibility}}" />
                        <Path Grid.Column="3"
                              Margin="6,0,0,0"
                              Style="{StaticResource Chat.ThinkingChevron}" />
                    </Grid>
                </Button>

                <TextBlock Margin="22,2,0,0"
                           Text="{Binding ThinkingText}"
                           Style="{StaticResource Text.Reasoning}"
                           TextWrapping="Wrap"
                           Visibility="{Binding IsThinkingExpanded, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </DataTemplate>

        <!-- 执行过程组：DSH 的 TurnProcess 行（状态 + 用时 + 箭头），可展开的成员行；
             成员是平铺在列表里的助手步骤 / 工具卡，组收起时折叠成 0 高，因此重试与快照回放仍按原顺序工作。 -->
        <DataTemplate DataType="{x:Type vm:ProcessGroupViewModel}">
            <StackPanel Margin="{StaticResource Margin.Chat.Process}">
                <Border x:Name="ProcessHeader"
                        Height="{StaticResource Metric.Chat.ProcessHeader}"
                        BorderThickness="{StaticResource Thickness.Chat.ProcessRule}"
                        BorderBrush="{DynamicResource Brush.Line3}">
                    <Button x:Name="ProcessRow"
                            Style="{StaticResource Chat.TurnRow}"
                            Command="{Binding ToggleExpandedCommand}"
                            ToolTip="{Binding HeaderToolTip}"
                            AutomationProperties.Name="{Binding AutomationName}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ProcessLabel"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                       TextWrapping="NoWrap"
                                       AutomationProperties.LiveSetting="Polite">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
                                        <Setter Property="FontSize" Value="{StaticResource Font.ChatProcess.Size}" />
                                        <Setter Property="LineHeight" Value="{StaticResource Font.ChatProcess.Line}" />
                                        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
                                    </Style>
                                </TextBlock.Style>
                                <Run Text="{Binding HeaderLabel, Mode=OneWay}" />
                                <Run FontFamily="{StaticResource Font.Family.Code}"
                                     Text="{Binding HeaderDuration, Mode=OneWay}" />
                            </TextBlock>

                            <Path x:Name="ProcessChevron"
                                  Margin="4,0,0,0"
                                  Style="{StaticResource Chat.TurnChevron}"
                                  Visibility="{Binding HasMembers, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Button>
                </Border>
            </StackPanel>
        </DataTemplate>

        <!-- 错误/提示卡：只留一条左侧色条与两行字，不再占一张大卡片 -->
        <DataTemplate DataType="{x:Type vm:NoticeChatItemViewModel}">
            <Border Margin="{StaticResource Margin.Chat.Notice}"
                    Padding="10,2,0,2"
                    BorderThickness="2,0,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line3}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.H3}" />
                    <TextBlock Margin="0,2,0,0"
                               Text="{Binding Body}"
                               Style="{StaticResource Text.Reasoning}"
                               TextWrapping="Wrap" />
                    <Button Margin="0,4,0,0"
                            HorizontalAlignment="Left"
                            Content="{Binding ActionText}"
                            Style="{StaticResource Button.Ghost}"
                            Padding="{StaticResource Pad.Button.Toolbar}"
                            Command="{Binding ActionCommand}"
                            Visibility="{Binding HasAction, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <!-- 欢迎态：标题 + 输入卡作为一组落在第 2 行，末尾第 4 行用等高的 * 把这一组顶到中间；
             发出第一条消息后第 4 行收成 0，整组落回底部。 -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="WelcomeSpacerRow"
                           Height="{Binding IsEmpty, Converter={StaticResource BoolToStar}}" />
        </Grid.RowDefinitions>

        <!-- 会话头：标题 + 更多。轮次计时在问题气泡下方，标题栏不再放计时。 -->
        <Grid Grid.Row="0"
              Height="{StaticResource Metric.RightTitle.Height}"
              Margin="14,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Margin="0,0,10,0"
                       VerticalAlignment="Center"
                       Text="{Binding Title}"
                       Style="{StaticResource Text.Section}"
                       TextTrimming="CharacterEllipsis"
                       Visibility="{Binding IsRenaming, Converter={StaticResource InverseBoolToVisibility}}" />

            <TextBox x:Name="RenameBox"
                     Grid.Column="0"
                     Margin="0,0,10,0"
                     VerticalAlignment="Center"
                     Text="{Binding RenameDraft, UpdateSourceTrigger=PropertyChanged}"
                     PreviewKeyDown="OnRenameKeyDown"
                     Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />

            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <!-- 新建入口保留在左栏与 Ctrl+N；会话头只留「更多」，菜单与左栏会话行共用。 -->
                <Button x:Name="MoreButton"
                        Style="{StaticResource Button.Icon}"
                        Click="OnMoreClick"
                        IsEnabled="{Binding HasSession}"
                        ToolTip="会话操作"
                        AutomationProperties.Name="会话操作"
                        ContextMenu="{StaticResource SessionRowMenu}">
                    <Path Style="{StaticResource Icon.Solid}"
                          Data="{StaticResource Ico.More}"
                          Fill="{DynamicResource Brush.Text3}" />
                </Button>

                <!-- 折叠按钮从窗口顶栏移到会话头「更多」右侧；仍由 Ctrl+J 与右栏状态驱动。 -->
                <Button x:Name="PaneToggle"
                        Width="{StaticResource Metric.Pane.ToggleSize}"
                        Height="{StaticResource Metric.Pane.ToggleSize}"
                        Margin="4,0,0,0"
                        Style="{StaticResource Button.Icon}"
                        Command="{Binding DataContext.ToggleRightPaneCommand, RelativeSource={RelativeSource AncestorType={x:Type views:ShellView}}}"
                        ToolTip="{Binding DataContext.ToggleRightPaneToolTip, RelativeSource={RelativeSource AncestorType={x:Type views:ShellView}}}"
                        AutomationProperties.AutomationId="PaneToggle"
                        AutomationProperties.Name="{Binding DataContext.ToggleRightPaneToolTip, RelativeSource={RelativeSource AncestorType={x:Type views:ShellView}}}"
                        KeyboardNavigation.TabIndex="100">
                    <Grid Width="{StaticResource Metric.Icon}" Height="{StaticResource Metric.Icon}">
                        <!-- 图标与「更多」「+」同档：静止态 tertiary，避免折叠按钮比相邻图标更重。 -->
                        <Path Fill="{DynamicResource Brush.Text3}">
                            <Path.Style>
                                <Style TargetType="Path" BasedOn="{StaticResource Icon}">
                                    <Setter Property="Data" Value="{StaticResource Ico.PanelCollapse}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.IsRightPaneCollapsed, RelativeSource={RelativeSource AncestorType={x:Type views:ShellView}}}"
                                                     Value="True">
                                            <Setter Property="Data" Value="{StaticResource Ico.PanelExpand}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                        <Ellipse Width="6"
                                 Height="6"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Top"
                                 Margin="0,-2,-2,0"
                                 Fill="{DynamicResource Brush.Warning}"
                                 Visibility="{Binding DataContext.HasPendingApproval, RelativeSource={RelativeSource AncestorType={x:Type views:ShellView}}, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 消息列表：像素滚动，拖动滚动条是连续的；是否跟随新内容由视图判断贴底，
             用户上滚后不再自动拉回（见 ConversationPaneView.xaml.cs），
             本轮计时在问题气泡下方，列表底部不再放运行状态条。 -->
        <Grid Grid.Row="1">
            <ListBox x:Name="MessageList"
                     ItemsSource="{Binding Items}"
                     ItemContainerStyle="{StaticResource ChatItemContainer}"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0"
                     PreviewMouseWheel="OnMessageListPreviewMouseWheel"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     AutomationProperties.AutomationId="ConversationMessages"
                     AutomationProperties.Name="对话消息">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
        </Grid>

        <!-- 欢迎态：应用图标 + 标题，下面接输入卡；有 / 无工作区保持同一版式。
             没有工作区时只把输入卡挡住，不隐藏、不改高度。 -->
        <StackPanel x:Name="ComposerGroup"
                    Grid.Row="2"
                    MaxWidth="{StaticResource Metric.Composer.MaxWidth}"
                    Margin="28,0,28,0"
                    HorizontalAlignment="Stretch">
            <StackPanel Margin="0,0,0,24"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <Image Width="{StaticResource Metric.Icon.Brand}"
                       Height="{StaticResource Metric.Icon.Brand}"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Source="pack://application:,,,/MiaoWu;component/Assets/Branding/MiaoWu.ico" />
                <TextBlock x:Name="WelcomeTitle"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           Text="{Binding EmptyTitle}"
                           Style="{StaticResource Text.H1}" />
            </StackPanel>

            <!-- 输入框：正文 + 工具行。工作区入口在左栏，权限说明不占常驻位置。 -->
            <Border x:Name="RightInputShell"
                    Height="{StaticResource Metric.Input.Height}"
                    Padding="{StaticResource Pad.Input}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource Brush.Canvas}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line3}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="CornerRadius" Value="{StaticResource Radius.Input}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=ComposerBox}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="{StaticResource GridLength.Input.Tools}" />
                </Grid.RowDefinitions>

                <!-- 正文：固定卡片高度内滚动，避免输入时整栏跳动。文件 / 图片以 chip 内联显示。 -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <controls:ComposerEditor x:Name="ComposerBox"
                                             Style="{StaticResource Composer.Editor}"
                                             PlainText="{Binding Draft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalScrollBarVisibility="Auto"
                                             FontFamily="{StaticResource Font.Family}"
                                             FontSize="{StaticResource Font.Body.Size}"
                                             Foreground="{DynamicResource Brush.Text}"
                                             Focusable="{Binding HasWorkspace}"
                                             IsTabStop="{Binding HasWorkspace}"
                                             PreviewKeyDown="OnComposerKeyDown"
                                             DraftChanged="OnComposerDraftChanged"
                                             CaretMoved="OnComposerCaretMoved"
                                             ExternalPathsDropped="OnComposerFilesDropped"
                                             LostKeyboardFocus="OnComposerLostFocus"
                                             AutomationProperties.AutomationId="ComposerInput"
                                             AutomationProperties.Name="消息输入框" />
                    <TextBlock Margin="2,0,0,0"
                               VerticalAlignment="Top"
                               IsHitTestVisible="False"
                               Text="{Binding ComposerPlaceholder, FallbackValue=发送问题或任务，/调用指令，@引用文件}"
                               Style="{StaticResource Text.Body}"
                               Foreground="{DynamicResource Brush.Text3}"
                               Visibility="{Binding Draft, Converter={StaticResource EmptyStringToVisibility}}" />
                </Grid>

                <!-- 工具行：预留附件、状态、当前模型、发送。 -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Style="{StaticResource Composer.IconButton}"
                            Command="{Binding AttachFilesCommand}"
                            ToolTip="{Binding AttachFilesToolTip}"
                            ToolTipService.ShowOnDisabled="True"
                            AutomationProperties.Name="添加文件或图片">
                        <Path Width="14"
                              Height="14"
                              Style="{StaticResource Icon}"
                              Data="{StaticResource Ico.Plus}"
                              Fill="{DynamicResource Brush.Text2}" />
                    </Button>

                    <TextBlock Grid.Column="1"
                               Margin="8,0,10,0"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               MaxWidth="150"
                               Text="{Binding HeaderText}"
                               ToolTip="{Binding HeaderText}"
                               Style="{StaticResource Text.Time}"
                               TextTrimming="CharacterEllipsis" />

                    <Button x:Name="PlanModeButton"
                            Grid.Column="2"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource Composer.PlanButton}"
                            Command="{Binding TogglePlanModeCommand}"
                            ToolTip="{Binding PlanModeToolTip}"
                            AutomationProperties.Name="计划模式">
                        <TextBlock VerticalAlignment="Center"
                                   Text="{Binding PlanModeLabel}"
                                   Style="{StaticResource Text.Chip}" />
                    </Button>

                    <Button x:Name="ModelPickerButton"
                            Grid.Column="3"
                            VerticalAlignment="Center"
                            Style="{StaticResource Composer.ModelButton}"
                            Click="OnModelPickerClick"
                            ToolTip="{Binding ModelToolTip}"
                            AutomationProperties.Name="选择模型">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center"
                                       MaxWidth="148"
                                       Text="{Binding SelectedModelName, FallbackValue=选择模型}"
                                       Style="{StaticResource Text.Chip}"
                                       TextTrimming="CharacterEllipsis" />
                            <Path Width="12"
                                  Height="12"
                                  Margin="4,0,0,0"
                                  Style="{StaticResource Icon}"
                                  Data="{StaticResource Ico.ChevronDown}"
                                  Fill="{DynamicResource Brush.Text3}" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="4"
                            Margin="8,0,0,0"
                            Style="{StaticResource Composer.SendButton}"
                            Command="{Binding SendCommand}"
                            ToolTip="{Binding SendToolTip}"
                            ToolTipService.ShowOnDisabled="True"
                            AutomationProperties.Name="发送"
                            Visibility="{Binding IsIdle, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                        <Path Width="14"
                              Height="14"
                              Style="{StaticResource Icon}"
                              Data="{StaticResource Ico.Send}"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>

                    <Button Grid.Column="4"
                            Margin="8,0,0,0"
                            Style="{StaticResource Composer.StopButton}"
                            Command="{Binding StopCommand}"
                            ToolTip="停止生成"
                            AutomationProperties.Name="停止生成"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                        <Path Width="12"
                              Height="12"
                              Style="{StaticResource Icon}"
                              Data="{StaticResource Ico.Stop}"
                              Fill="{DynamicResource Brush.OnAccent}" />
                    </Button>
                </Grid>

                <!-- 模型菜单：向上展开，按提供商分区；行点击直接选中并关闭。 -->
                <Popup x:Name="ModelPopup"
                       Grid.RowSpan="2"
                       Placement="Custom"
                       PlacementTarget="{Binding ElementName=ModelPickerButton}"
                       AllowsTransparency="True"
                       StaysOpen="False"
                       Focusable="False"
                       PopupAnimation="{DynamicResource {x:Static SystemParameters.MenuPopupAnimationKey}}"
                       DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                    <Border Background="Transparent"
                            BorderBrush="{DynamicResource Brush.MenuHairline}"
                            BorderThickness="{StaticResource Thickness.MenuHairline}"
                            CornerRadius="{StaticResource Radius.MenuHairline}"
                            SnapsToDevicePixels="False"
                            UseLayoutRounding="False">
                        <Border Style="{StaticResource Menu.Surface}"
                                MinWidth="{StaticResource Metric.ModelPicker.Width}">
                            <ScrollViewer MaxHeight="{StaticResource Metric.ModelPicker.MaxHeight}"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding ModelGroups}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBlock Margin="{StaticResource Margin.ModelSection}"
                                                               Text="{Binding ProviderName}"
                                                               Style="{StaticResource Text.Group}" />
                                                    <ItemsControl ItemsSource="{Binding Models}" Focusable="False">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Style="{StaticResource Composer.ModelRowButton}"
                                                                        Content="{Binding}"
                                                                        ContentTemplate="{StaticResource Composer.ModelRow}"
                                                                        Tag="{Binding}"
                                                                        Click="OnModelRowClick"
                                                                        ToolTip="{Binding Detail}"
                                                                        AutomationProperties.Name="{Binding DisplayName}" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <StackPanel Visibility="{Binding HasModelGroups, Converter={StaticResource InverseBoolToVisibility}}">
                                        <TextBlock Margin="{StaticResource Margin.ModelSection}"
                                                   Text="{Binding ModelEmptyText}"
                                                   Style="{StaticResource Text.Meta}"
                                                   TextWrapping="Wrap" />
                                        <Button Margin="8,2,8,4"
                                                HorizontalAlignment="Left"
                                                Content="打开模型设置"
                                                Style="{StaticResource Button.Ghost}"
                                                Click="OnOpenModelSettingsClick" />
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Border>
                </Popup>

                <!-- `/` 与 `@` 补全菜单：浮在输入卡上方 4px，宽度与输入卡一致；
                     焦点留在编辑器里，行用 mousedown/click 选中，Tab 由代码后置路由。 -->
                <Popup x:Name="TriggerPopup"
                       Placement="Custom"
                       PlacementTarget="{Binding ElementName=RightInputShell}"
                       AllowsTransparency="True"
                       StaysOpen="True"
                       Focusable="False"
                       PopupAnimation="{DynamicResource {x:Static SystemParameters.MenuPopupAnimationKey}}"
                       Width="{Binding ActualWidth, ElementName=RightInputShell}"
                       IsOpen="{Binding ComposerTriggers.IsOpen, Mode=OneWay}"
                       Closed="OnTriggerPopupClosed">
                    <Border Background="Transparent"
                            BorderBrush="{DynamicResource Brush.MenuHairline}"
                            BorderThickness="{StaticResource Thickness.MenuHairline}"
                            CornerRadius="{StaticResource Radius.MenuHairline}"
                            SnapsToDevicePixels="False"
                            UseLayoutRounding="False">
                        <Border Style="{StaticResource Menu.Surface}">
                            <ScrollViewer x:Name="TriggerScroller"
                                          MaxHeight="{StaticResource Metric.ModelPicker.MaxHeight}"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="TriggerRows" ItemsSource="{Binding ComposerTriggers.Rows}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <TextBlock Margin="{StaticResource Margin.ModelSection}"
                                                           Text="{Binding HeaderText}"
                                                           Style="{StaticResource Text.Group}"
                                                           Visibility="{Binding IsHeader, Converter={StaticResource BoolToVisibility}}" />
                                                <Button Style="{StaticResource Composer.MenuRow}"
                                                        Content="{Binding}"
                                                        ContentTemplate="{StaticResource Composer.TriggerRow}"
                                                        Tag="{Binding}"
                                                        ToolTip="{Binding ToolTip}"
                                                        AutomationProperties.Name="{Binding Label}"
                                                        Visibility="{Binding IsHeader, Converter={StaticResource InverseBoolToVisibility}}"
                                                        MouseMove="OnTriggerRowMouseMove"
                                                        Click="OnTriggerRowClick" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Border>
                </Popup>

                <!-- 没有工作区时只挡住输入卡：版式、尺寸、文字都不变，鼠标点击不落到编辑器。 -->
                <Border x:Name="ComposerDisabledOverlay"
                        Grid.RowSpan="2"
                        Panel.ZIndex="20"
                        Background="Transparent"
                        Cursor="Arrow"
                        ToolTip="请先在左栏选择工作区"
                        Visibility="{Binding HasWorkspace, Converter={StaticResource InverseBoolToVisibility}}"
                        AutomationProperties.Name="未选择工作区，输入不可用" />
            </Grid>
        </Border>
        </StackPanel>

        <!-- 输入卡下方读数：居中的三个只读 pill；没有数据整条隐藏。
             高度固定 22（20 行高 + 上下 1），读数异步到达也不会顶动输入卡。 -->
        <Grid x:Name="ComposerDockRowHost"
              Grid.Row="3"
              Height="{StaticResource Metric.Dock.Height}"
              Margin="{StaticResource Margin.Dock}"
              Visibility="{Binding ComposerDock.HasAny, Converter={StaticResource BoolToVisibility}}"
              SizeChanged="OnComposerDockSizeChanged"
              PreviewKeyDown="OnDockKeyDown">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <Button x:Name="StatsPill"
                        Style="{StaticResource Composer.DockPill}"
                        Tag="Stats"
                        Click="OnDockPillClick"
                        AutomationProperties.Name="会话统计"
                        Visibility="{Binding ComposerDock.HasStats, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="14"
                              Height="14"
                              VerticalAlignment="Center"
                              Stretch="Uniform"
                              Stroke="{DynamicResource Brush.Text3}"
                              StrokeThickness="{StaticResource Metric.Icon.Stroke}"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Data="{StaticResource Ico.Clock}" />
                        <TextBlock Margin="4,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="{Binding ComposerDock.StatsSummary}"
                                   Style="{StaticResource Text.Dock}" />
                    </StackPanel>
                </Button>

                <Button x:Name="UsagePill"
                        Style="{StaticResource Composer.DockPill}"
                        Tag="Usage"
                        Click="OnDockPillClick"
                        AutomationProperties.Name="Token 用量"
                        Visibility="{Binding ComposerDock.HasUsage, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="14"
                              Height="14"
                              VerticalAlignment="Center"
                              Stretch="Uniform"
                              Fill="{DynamicResource Brush.Text3}"
                              Data="{StaticResource Ico.Market}" />
                        <TextBlock Margin="4,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="{Binding ComposerDock.UsageSummary}"
                                   Style="{StaticResource Text.Dock}" />
                    </StackPanel>
                </Button>

                <Button x:Name="ContextPill"
                        Style="{StaticResource Composer.DockPill}"
                        Margin="0"
                        Tag="Context"
                        Click="OnDockPillClick"
                        AutomationProperties.Name="上下文已用"
                        Visibility="{Binding ComposerDock.HasContext, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="14" Height="14" VerticalAlignment="Center">
                            <Ellipse Width="12"
                                     Height="12"
                                     Stroke="{DynamicResource Brush.Line3}"
                                     StrokeThickness="{StaticResource Metric.Icon.Stroke}" />
                            <Path Stroke="{DynamicResource Brush.Accent}"
                                  StrokeThickness="{StaticResource Metric.Icon.Stroke}"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Data="{Binding ComposerDock.ContextPercent, Converter={StaticResource PercentToArc}}" />
                        </Grid>
                        <TextBlock Margin="4,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="{Binding ComposerDock.ContextPercentText}"
                                   Style="{StaticResource Text.Dock}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 读数明细：点 pill 才出现，锚在读数行上方；点外部或 Esc 关闭。 -->
        <Popup x:Name="DockPopup"
               Placement="Custom"
               PlacementTarget="{Binding ElementName=ComposerDockRowHost}"
               AllowsTransparency="True"
               StaysOpen="False"
               Focusable="False"
               PopupAnimation="{DynamicResource {x:Static SystemParameters.MenuPopupAnimationKey}}"
               IsOpen="{Binding ComposerDock.IsOpen, Mode=OneWay}"
               Closed="OnDockPopupClosed">
            <Border Background="Transparent"
                    BorderBrush="{DynamicResource Brush.MenuHairline}"
                    BorderThickness="{StaticResource Thickness.MenuHairline}"
                    CornerRadius="{StaticResource Radius.MenuHairline}"
                    SnapsToDevicePixels="False"
                    UseLayoutRounding="False">
                <Border Style="{StaticResource Menu.Surface}"
                        Width="{StaticResource Metric.Dock.Panel.Width}"
                        Padding="{StaticResource Pad.DockPanel}">
                    <Grid>
                        <StackPanel Visibility="{Binding ComposerDock.ShowStats, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <TextBlock Text="会话统计" Style="{StaticResource Composer.DockPanelTitle}" />
                                <TextBlock HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Text="{Binding ComposerDock.StatsTitleRight}"
                                           Style="{StaticResource Text.Dock}"
                                           Foreground="{DynamicResource Brush.Text2}" />
                            </Grid>
                            <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding ComposerDock.StatsRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="{StaticResource Font.Dock.Line}">
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource Composer.DockRowLabel}" />
                                            <TextBlock HorizontalAlignment="Right"
                                                       Text="{Binding Value}"
                                                       Style="{StaticResource Composer.DockRowValue}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Visibility="{Binding ComposerDock.ShowUsage, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <TextBlock Text="Token 用量" Style="{StaticResource Composer.DockPanelTitle}" />
                                <TextBlock HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Text="{Binding ComposerDock.UsageTitleRight}"
                                           Style="{StaticResource Text.Dock}"
                                           Foreground="{DynamicResource Brush.Text2}" />
                            </Grid>
                            <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding ComposerDock.UsageRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="{StaticResource Font.Dock.Line}">
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource Composer.DockRowLabel}" />
                                            <TextBlock HorizontalAlignment="Right"
                                                       Text="{Binding Value}"
                                                       Style="{StaticResource Composer.DockRowValue}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Visibility="{Binding ComposerDock.ShowContext, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <TextBlock Text="上下文已用" Style="{StaticResource Composer.DockPanelTitle}" />
                                <TextBlock HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Text="{Binding ComposerDock.ContextTitleRight}"
                                           Style="{StaticResource Composer.DockPanelTitle}"
                                           Foreground="{DynamicResource Brush.Accent}" />
                            </Grid>
                            <TextBlock Margin="0,2,0,0"
                                       Text="{Binding ComposerDock.ContextRatioText}"
                                       Style="{StaticResource Text.Dock}"
                                       Foreground="{DynamicResource Brush.Text2}" />
                            <Grid Height="4" Margin="0,8,0,10" HorizontalAlignment="Left">
                                <Border Width="244"
                                        Height="4"
                                        Background="{DynamicResource Brush.Line3}"
                                        CornerRadius="2" />
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="{Binding ComposerDock.SystemBarWidth}"
                                            Height="4"
                                            Background="{DynamicResource Brush.Accent}" />
                                    <Border Width="{Binding ComposerDock.ToolsBarWidth}"
                                            Height="4"
                                            Background="{DynamicResource Brush.Text2}" />
                                    <Border Width="{Binding ComposerDock.MessageBarWidth}"
                                            Height="4"
                                            Background="{DynamicResource Brush.Line2}" />
                                </StackPanel>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding ComposerDock.ContextRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="{StaticResource Font.Dock.Line}">
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource Composer.DockRowLabel}" />
                                            <TextBlock HorizontalAlignment="Right"
                                                       Text="{Binding Value}"
                                                       Style="{StaticResource Composer.DockRowValue}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </Border>
            </Border>
        </Popup>
    </Grid>
</UserControl>
