<UserControl x:Class="MiaoWu.App.Views.LeftPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:res="clr-namespace:MiaoWu.App.Resources"
             mc:Ignorable="d"
             d:DesignWidth="262"
             d:DesignHeight="856"
             x:Name="LeftRoot"
             Focusable="False"
             Background="{DynamicResource Brush.Side}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             AutomationProperties.AutomationId="LeftPane"
             AutomationProperties.Name="{x:Static res:Strings.LeftPaneAutomation}">

    <UserControl.Resources>
        <Style x:Key="WorkspaceRowBorder" TargetType="Border">
            <Setter Property="Height" Value="{StaticResource Metric.Row.Workspace}" />
            <Setter Property="Margin" Value="8,0" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Row}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="{StaticResource Thickness.Focus}" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 区块标题：工作区 + 添加 -->
        <Grid Grid.Row="0" Height="30" Margin="{StaticResource Pad.LeftHeader}">
            <TextBlock VerticalAlignment="Center"
                       Text="{x:Static res:Strings.Workspace}"
                       Style="{StaticResource Text.Group}" />
            <Button x:Name="AddWorkspaceButton"
                    Width="24"
                    Height="24"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Style="{StaticResource Button.Icon}"
                    Command="{Binding AddWorkspaceCommand}"
                    ToolTip="{x:Static res:Strings.AddWorkspaceTooltip}"
                    AutomationProperties.AutomationId="AddWorkspace"
                    AutomationProperties.Name="{x:Static res:Strings.AddWorkspaceTooltip}"
                    KeyboardNavigation.TabIndex="0">
                <Path Style="{StaticResource Icon}"
                      Data="{StaticResource Ico.Plus}"
                      Fill="{DynamicResource Brush.Text3}" />
            </Button>
        </Grid>

        <!-- 工作区手风琴（行固定在上方，内容在下方独立滚动） -->
        <ItemsControl Grid.Row="1"
                      x:Name="WorkspaceList"
                      Focusable="False"
                      IsTabStop="False"
                      ItemsSource="{Binding Workspaces}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="WorkspaceRow"
                            Style="{StaticResource WorkspaceRowBorder}"
                            KeyboardNavigation.TabIndex="0"
                            AutomationProperties.AutomationId="WorkspaceRow"
                            AutomationProperties.Name="{Binding AutomationName}">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding ActivateCommand}" />
                            <KeyBinding Key="Enter" Command="{Binding ActivateCommand}" />
                            <KeyBinding Key="Space" Command="{Binding ActivateCommand}" />
                        </Border.InputBindings>
                        <Border.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{x:Static res:Strings.RemoveWorkspace}"
                                          ToolTip="{x:Static res:Strings.RemoveWorkspaceTooltip}"
                                          Command="{Binding PlacementTarget.DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            </ContextMenu>
                        </Border.ContextMenu>

                        <Grid Margin="{StaticResource Pad.WorkspaceRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Path x:Name="WorkspaceChevron"
                                  Grid.Column="0"
                                  Style="{StaticResource Icon}"
                                  Data="{StaticResource Ico.ChevronRight}"
                                  Fill="{DynamicResource Brush.Text3}" />

                            <Path x:Name="WorkspaceIcon"
                                  Grid.Column="1"
                                  Margin="4,0,0,0"
                                  Style="{StaticResource Icon}"
                                  Data="{StaticResource Ico.Folder}"
                                  Fill="{DynamicResource Brush.Text3}" />

                            <TextBlock x:Name="WorkspaceName"
                                       Grid.Column="2"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="{Binding Name}"
                                       ToolTip="{Binding Path}"
                                       Style="{StaticResource Text.ListRow}"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource Brush.Text2}" />

                            <TextBlock Grid.Column="3"
                                       VerticalAlignment="Center"
                                       Text="{Binding SessionCountText}"
                                       Style="{StaticResource Text.Time}" />
                        </Grid>
                    </Border>

                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                            <Setter TargetName="WorkspaceRow" Property="Background" Value="{DynamicResource Brush.Sel}" />
                            <Setter TargetName="WorkspaceChevron" Property="Data" Value="{StaticResource Ico.ChevronDown}" />
                            <Setter TargetName="WorkspaceIcon" Property="Fill" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="WorkspaceName" Property="Foreground" Value="{DynamicResource Brush.Text}" />
                            <Setter TargetName="WorkspaceName" Property="FontWeight" Value="{StaticResource Font.Weight.SemiBold}" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 添加工作区内联错误 -->
        <Border Grid.Row="2"
                Height="{StaticResource Metric.Left.InlineError.Height}"
                Margin="8,2,8,0"
                Padding="8,0"
                Background="{DynamicResource Brush.WarningSoft}"
                CornerRadius="{StaticResource Radius.Button}"
                Visibility="{Binding HasInlineError, Converter={StaticResource BoolToVisibility}}">
            <TextBlock VerticalAlignment="Center"
                       Text="{Binding InlineError}"
                       Style="{StaticResource Text.Meta}"
                       Foreground="{DynamicResource Brush.Warning}"
                       TextTrimming="CharacterEllipsis" />
        </Border>

        <!-- 会话 / 文件 分段；搜索与新建 -->
        <Grid Grid.Row="3"
              Height="{StaticResource Metric.Left.Segment.RowHeight}"
              Margin="8,4,8,0">
            <Border HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="{DynamicResource Brush.Sel}"
                    CornerRadius="{StaticResource Radius.Segment}"
                    Padding="1">
                <StackPanel Orientation="Horizontal">
                    <ToggleButton Style="{StaticResource ToggleButton.Segment}"
                                  Content="{x:Static res:Strings.Sessions}"
                                  IsChecked="{Binding ActiveWorkspace.IsSessionsView, Mode=TwoWay}"
                                  KeyboardNavigation.TabIndex="1"
                                  AutomationProperties.AutomationId="SessionsSegment" />
                    <ToggleButton Style="{StaticResource ToggleButton.Segment}"
                                  Content="{x:Static res:Strings.Files}"
                                  IsChecked="{Binding ActiveWorkspace.IsFilesView, Mode=TwoWay}"
                                  KeyboardNavigation.TabIndex="2"
                                  AutomationProperties.AutomationId="FilesSegment" />
                </StackPanel>
            </Border>

            <StackPanel HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <Button Style="{StaticResource Button.Icon}"
                        Width="24"
                        Height="24"
                        Margin="0,0,4,0"
                        IsEnabled="False"
                        ToolTip="{Binding SearchToolTip}"
                        AutomationProperties.Name="{Binding SearchToolTip}">
                    <Path Style="{StaticResource Icon}"
                          Data="{StaticResource Ico.Search}"
                          Fill="{DynamicResource Brush.Text3}" />
                </Button>

                <Button Style="{StaticResource Button.Icon}"
                        Width="24"
                        Height="24"
                        Command="{Binding ActiveWorkspace.OpenFileCommand}"
                        ToolTip="{x:Static res:Strings.OpenFileTooltip}"
                        AutomationProperties.Name="{x:Static res:Strings.OpenFileTooltip}"
                        Visibility="{Binding ActiveWorkspace.IsFilesView, Converter={StaticResource BoolToVisibility}}">
                    <Path Style="{StaticResource Icon}"
                          Data="{StaticResource Ico.Plus}"
                          Fill="{DynamicResource Brush.Text3}" />
                </Button>

                <Button Style="{StaticResource Button.Icon}"
                        Width="24"
                        Height="24"
                        IsEnabled="{Binding CanCreateSession}"
                        ToolTip="{Binding NewSessionToolTip}"
                        AutomationProperties.Name="{Binding NewSessionToolTip}"
                        Visibility="{Binding ActiveWorkspace.IsSessionsView, Converter={StaticResource BoolToVisibility}}">
                    <Path Style="{StaticResource Icon}"
                          Data="{StaticResource Ico.Plus}"
                          Fill="{DynamicResource Brush.Text3}" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- 活动工作区内容 -->
        <Grid Grid.Row="4" Margin="0,4,0,0">

            <!-- 会话列表 -->
            <ListBox x:Name="SessionsList"
                     ItemsSource="{Binding ActiveWorkspace.SessionRows}"
                     SelectedItem="{Binding ActiveWorkspace.SelectedSession, Mode=TwoWay}"
                     Visibility="{Binding ActiveWorkspace.ShowSessionList, Converter={StaticResource BoolToVisibility}}"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0,0,0,8"
                     ItemContainerStyle="{StaticResource ListBoxItem.Session}"
                     ScrollViewer.CanContentScroll="True"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                     VirtualizingStackPanel.ScrollUnit="Pixel"
                     KeyboardNavigation.DirectionalNavigation="Contained"
                     KeyboardNavigation.TabIndex="3"
                     KeyboardNavigation.IsTabStop="True"
                     FocusVisualStyle="{StaticResource FocusVisual.Card}"
                     AutomationProperties.AutomationId="SessionsList"
                     AutomationProperties.Name="{x:Static res:Strings.SessionsListAutomation}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <TextBlock x:Name="GroupHeader"
                                       Height="{StaticResource Metric.Row.Group}"
                                       Margin="0,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="{Binding HeaderText}"
                                       Style="{StaticResource Text.Group}"
                                       Visibility="Collapsed" />

                            <Grid x:Name="SessionContent" Margin="{StaticResource Pad.SessionRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Path Grid.Column="0"
                                      Width="14"
                                      Height="14"
                                      Margin="0,0,2,0"
                                      Style="{StaticResource Icon}"
                                      Data="{StaticResource Ico.Pin}"
                                      Fill="{DynamicResource Brush.Text3}"
                                      Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibility}}" />

                                <TextBlock x:Name="SessionTitle"
                                           Grid.Column="1"
                                           VerticalAlignment="Center"
                                           Text="{Binding Title}"
                                           ToolTip="{Binding ToolTip}"
                                           Style="{StaticResource Text.ListRow}"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource Brush.Text2}" />

                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Ellipse Width="6"
                                             Height="6"
                                             Margin="4,0,0,0"
                                             Fill="{DynamicResource Brush.Warning}"
                                             Visibility="{Binding HasPendingApproval, Converter={StaticResource BoolToVisibility}}"
                                             ToolTip="{x:Static res:Strings.PendingApproval}" />
                                    <Ellipse Width="6"
                                             Height="6"
                                             Margin="4,0,0,0"
                                             Fill="{DynamicResource Brush.Accent}"
                                             Visibility="{Binding IsUnread, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>

                                <TextBlock Grid.Column="3"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="{Binding TimeText}"
                                           Style="{StaticResource Text.Time}" />
                            </Grid>
                        </Grid>

                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                <Setter TargetName="GroupHeader" Property="Visibility" Value="Visible" />
                                <Setter TargetName="SessionContent" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                <Setter TargetName="SessionTitle" Property="Foreground" Value="{DynamicResource Brush.Text}" />
                                <Setter TargetName="SessionTitle" Property="FontWeight" Value="{StaticResource Font.Weight.SemiBold}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 文件树 -->
            <ListBox x:Name="TreeList"
                     ItemsSource="{Binding ActiveWorkspace.TreeRows}"
                     SelectedItem="{Binding ActiveWorkspace.SelectedFile, Mode=TwoWay}"
                     Visibility="{Binding ActiveWorkspace.ShowFileTree, Converter={StaticResource BoolToVisibility}}"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0,0,0,8"
                     ItemContainerStyle="{StaticResource ListBoxItem.Tree}"
                     ScrollViewer.CanContentScroll="True"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="{Binding ActiveWorkspace.TreeNeedsHorizontalScroll, Converter={StaticResource BoolToScrollBarVisibility}}"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                     VirtualizingStackPanel.ScrollUnit="Pixel"
                     PreviewKeyDown="OnTreePreviewKeyDown"
                     MouseDoubleClick="OnTreeMouseDoubleClick"
                     KeyboardNavigation.TabIndex="3"
                     KeyboardNavigation.IsTabStop="True"
                     FocusVisualStyle="{StaticResource FocusVisual.Card}"
                     AutomationProperties.AutomationId="FileTree"
                     AutomationProperties.Name="{x:Static res:Strings.FileTreeAutomation}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="RowRoot"
                                Background="Transparent">
                            <Grid MinWidth="{Binding MinRowWidth}" Margin="{StaticResource Pad.TreeRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Margin="{Binding Indent}">
                                    <Button x:Name="ChevronButton"
                                            Style="{StaticResource Button.TreeChevron}"
                                            Command="{Binding ToggleCommand}"
                                            Visibility="{Binding CanExpand, Converter={StaticResource BoolToVisibility}}">
                                        <Path x:Name="Chevron"
                                              Width="16"
                                              Height="16"
                                              Style="{StaticResource Icon}"
                                              Data="{StaticResource Ico.ChevronRight}"
                                              Fill="{DynamicResource Brush.Text3}" />
                                    </Button>
                                </Border>

                                <Path x:Name="NodeIcon"
                                      Grid.Column="1"
                                      Margin="2,0,0,0"
                                      Style="{StaticResource Icon}"
                                      Data="{StaticResource Ico.File}"
                                      Fill="{DynamicResource Brush.Text3}" />

                                <TextBlock x:Name="NodeName"
                                           Grid.Column="2"
                                           Margin="6,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="{Binding Name}"
                                           ToolTip="{Binding ToolTip}"
                                           Style="{StaticResource Text.ListRow}"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource Brush.Text2}" />
                            </Grid>
                        </Border>

                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                <Setter TargetName="NodeIcon" Property="Data" Value="{StaticResource Ico.Folder}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                <Setter TargetName="Chevron" Property="Data" Value="{StaticResource Ico.ChevronDown}" />
                                <Setter TargetName="NodeIcon" Property="Data" Value="{StaticResource Ico.FolderOpen}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                <Setter TargetName="NodeIcon" Property="Data" Value="{StaticResource Ico.Warning}" />
                                <Setter TargetName="NodeIcon" Property="Fill" Value="{DynamicResource Brush.Warning}" />
                                <Setter TargetName="NodeName" Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsOpened}" Value="True">
                                <Setter TargetName="NodeIcon" Property="Fill" Value="{DynamicResource Brush.Accent}" />
                                <Setter TargetName="NodeName" Property="Foreground" Value="{DynamicResource Brush.Text}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                <Setter TargetName="NodeName" Property="Foreground" Value="{DynamicResource Brush.Text}" />
                                <Setter TargetName="NodeName" Property="FontWeight" Value="{StaticResource Font.Weight.SemiBold}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 分组标题吸顶 -->
            <Border x:Name="StickyHeader"
                    Height="{StaticResource Metric.Row.Group}"
                    VerticalAlignment="Top"
                    Background="{DynamicResource Brush.Side}"
                    IsHitTestVisible="False"
                    Visibility="{Binding ActiveWorkspace.IsStickyHeaderVisible, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Margin="8,0"
                           VerticalAlignment="Center"
                           Text="{Binding ActiveWorkspace.StickyHeaderText}"
                           Style="{StaticResource Text.Group}" />
            </Border>

            <!-- 会话空态 -->
            <StackPanel MaxWidth="210"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding ActiveWorkspace.ShowSessionEmpty, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{x:Static res:Strings.SessionsEmptyTitle}"
                           Style="{StaticResource Text.Empty}"
                           Foreground="{DynamicResource Brush.Text}" />
                <TextBlock Margin="0,4,0,0"
                           Text="{x:Static res:Strings.SessionsEmptyBody}"
                           Style="{StaticResource Text.Empty}" />
                <Button Margin="0,12,0,0"
                        HorizontalAlignment="Center"
                        Content="{x:Static res:Strings.NewSession}"
                        Style="{StaticResource Button.Primary}"
                        IsEnabled="{Binding CanCreateSession}"
                        ToolTip="{Binding NewSessionToolTip}" />
            </StackPanel>

            <!-- 文件空态 -->
            <StackPanel MaxWidth="210"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding ActiveWorkspace.ShowFileEmpty, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{x:Static res:Strings.FilesEmptyTitle}"
                           Style="{StaticResource Text.Empty}"
                           Foreground="{DynamicResource Brush.Text}" />
                <TextBlock Margin="0,4,0,0"
                           Text="{x:Static res:Strings.FilesEmptyBody}"
                           Style="{StaticResource Text.Empty}" />
                <Button Margin="0,12,0,0"
                        HorizontalAlignment="Center"
                        Content="{x:Static res:Strings.OpenFilePrimary}"
                        Style="{StaticResource Button.Primary}"
                        Command="{Binding ActiveWorkspace.OpenFileCommand}" />
            </StackPanel>

            <!-- 没有工作区 -->
            <StackPanel MaxWidth="220"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{x:Static res:Strings.WorkspaceListEmptyTitle}"
                           Style="{StaticResource Text.Empty}"
                           Foreground="{DynamicResource Brush.Text}" />
                <TextBlock Margin="0,4,0,0"
                           Text="{x:Static res:Strings.WorkspaceListEmptyBody}"
                           Style="{StaticResource Text.Empty}" />
                <Button Margin="0,12,0,0"
                        HorizontalAlignment="Center"
                        Content="{x:Static res:Strings.AddWorkspacePrimary}"
                        Style="{StaticResource Button.Primary}"
                        Command="{Binding AddWorkspaceCommand}" />
            </StackPanel>
        </Grid>

        <!-- 底部固定入口 -->
        <Border Grid.Row="5"
                Padding="8,10,8,8"
                Background="{DynamicResource Brush.Side}">
            <StackPanel>
                <Button Style="{StaticResource Button.NavItem}"
                        Command="{Binding OpenMarketplaceCommand}"
                        ToolTip="{x:Static res:Strings.CapabilityMarketPendingBody}"
                        KeyboardNavigation.TabIndex="20"
                        AutomationProperties.AutomationId="CapabilityMarket">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- 过渡：market.svg 画的是公文包，先保留旧四宫格 -->
                        <Path Style="{StaticResource Icon.Stroke}"
                              Data="{StaticResource Ico.Market}"
                              Stroke="{DynamicResource Brush.Text3}" />
                        <TextBlock Grid.Column="1"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="{x:Static res:Strings.CapabilityMarket}"
                                   Style="{StaticResource Text.ListRow}" />
                        <TextBlock Grid.Column="2"
                                   VerticalAlignment="Center"
                                   Text="{x:Static res:Strings.MarketplaceComingSoon}"
                                   Style="{StaticResource Text.Time}"
                                   Foreground="{DynamicResource Brush.Text3}" />
                    </Grid>
                </Button>

                <Button Style="{StaticResource Button.NavItem}"
                        Command="{Binding OpenSettingsCommand}"
                        KeyboardNavigation.TabIndex="21"
                        AutomationProperties.AutomationId="OpenSettings">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Path Style="{StaticResource Icon}"
                              Data="{StaticResource Ico.Settings}"
                              Fill="{DynamicResource Brush.Text3}" />
                        <TextBlock Grid.Column="1"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="{x:Static res:Strings.Settings}"
                                   Style="{StaticResource Text.ListRow}" />
                    </Grid>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
