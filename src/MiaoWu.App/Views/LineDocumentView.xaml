<UserControl x:Class="MiaoWu.App.Views.LineDocumentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:res="clr-namespace:MiaoWu.App.Resources"
             xmlns:vm="clr-namespace:MiaoWu.App.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="648"
             d:DesignHeight="800"
             x:Name="Root"
             Focusable="False"
             Background="Transparent"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <Grid MaxWidth="{StaticResource Metric.Doc.Width}"
          Margin="{StaticResource Pad.Document}"
          HorizontalAlignment="Left"
          VerticalAlignment="Stretch"
          Tag="DocumentRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 命令输出头部：命令行 + 退出码 / 耗时 -->
        <Border Grid.Row="0"
                Height="30"
                Margin="0,0,0,8"
                BorderBrush="{DynamicResource Brush.Line2}"
                BorderThickness="0,0,0,1"
                Visibility="{Binding HasHeader, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{x:Static res:Strings.CommandPrompt}"
                               Style="{StaticResource Text.Code}"
                               Foreground="{DynamicResource Brush.Text3}" />
                    <TextBlock Margin="6,0,0,0"
                               Text="{Binding HeaderCommand}"
                               Style="{StaticResource Text.Code}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <TextBlock Margin="0,0,10,0"
                               Text="{Binding ExitCodeText}"
                               Style="{StaticResource Text.Meta}" />
                    <TextBlock Text="{Binding DurationText}"
                               Style="{StaticResource Text.Meta}" />
                </StackPanel>
            </Grid>
        </Border>

        <ListBox x:Name="LineList"
                 Grid.Row="1"
                 ItemsSource="{Binding Lines}"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="0,0,0,24"
                 ItemContainerStyle="{StaticResource ListBoxItem.Line}"
                 ScrollViewer.CanContentScroll="True"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 VirtualizingStackPanel.IsVirtualizing="True"
                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                 VirtualizingStackPanel.ScrollUnit="Pixel"
                 AutomationProperties.AutomationId="LineList"
                 AutomationProperties.Name="{x:Static res:Strings.DocumentScrollAutomation}">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:DocumentLineViewModel}">
                    <Border x:Name="Row"
                            MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ListBox}}"
                            Background="Transparent">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Width="{StaticResource Metric.Diff.NumberWidth}"
                                       Margin="0,0,6,0"
                                       Text="{Binding OldNumberText}"
                                       TextAlignment="Right"
                                       Style="{StaticResource Text.Time}"
                                       Visibility="{Binding ShowNumbers, Converter={StaticResource BoolToVisibility}}" />

                            <TextBlock Grid.Column="1"
                                       Width="{StaticResource Metric.Diff.NumberWidth}"
                                       Margin="0,0,6,0"
                                       Text="{Binding NewNumberText}"
                                       TextAlignment="Right"
                                       Style="{StaticResource Text.Time}"
                                       Visibility="{Binding ShowNumbers, Converter={StaticResource BoolToVisibility}}" />

                            <TextBlock x:Name="SignText"
                                       Grid.Column="2"
                                       Width="12"
                                       Text="{Binding Sign}"
                                       TextAlignment="Center"
                                       Style="{StaticResource Text.Code}"
                                       Foreground="{DynamicResource Brush.Text3}" />

                            <TextBlock x:Name="LineText"
                                       Grid.Column="3"
                                       Margin="6,0,10,0"
                                       Text="{Binding Text}"
                                       Style="{StaticResource Text.Code}"
                                       Foreground="{DynamicResource Brush.Text}" />
                        </Grid>
                    </Border>

                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsAdded}" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.DiffAdd}" />
                            <Setter TargetName="SignText" Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRemoved}" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.DiffRemove}" />
                            <Setter TargetName="SignText" Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsHeaderLine}" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.DiffHunk}" />
                            <Setter TargetName="LineText" Property="Foreground" Value="{DynamicResource Brush.Text2}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsNoNewline}" Value="True">
                            <Setter TargetName="LineText" Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsMonospace}" Value="False">
                            <Setter TargetName="LineText" Property="FontFamily" Value="{StaticResource Font.Family}" />
                            <Setter TargetName="LineText" Property="FontSize" Value="{StaticResource Font.Body.Size}" />
                            <Setter TargetName="LineText" Property="LineHeight" Value="{StaticResource Font.Body.Line}" />
                            <Setter TargetName="LineText" Property="TextWrapping" Value="Wrap" />
                            <Setter TargetName="SignText" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsFindMatch}" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.FindMatch}" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
