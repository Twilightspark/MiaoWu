<UserControl x:Class="MiaoWu.App.Views.MarketPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:MiaoWu.App.Converters"
             xmlns:controls="clr-namespace:MiaoWu.App.Controls"
             xmlns:res="clr-namespace:MiaoWu.App.Resources"
             xmlns:skills="clr-namespace:MiaoWu.Core.Skills;assembly=MiaoWu.Core"
             mc:Ignorable="d"
             d:DesignWidth="1040"
             d:DesignHeight="760"
             x:Name="Root"
             Focusable="False"
             Background="{DynamicResource Brush.Canvas}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             PreviewKeyDown="OnPreviewKeyDown">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <conv:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibility" />

        <Style x:Key="MarketTabItem" TargetType="ListBoxItem">
            <Setter Property="Height" Value="{StaticResource Metric.Segment.Height}" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="{StaticResource Pad.Segment}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text2}" />
            <Setter Property="FontSize" Value="{StaticResource Font.Segment.Size}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Button}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.SegmentItem}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Canvas}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.TabBorder}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                                <Setter Property="FontWeight" Value="{StaticResource Font.Weight.SemiBold}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MarketTabList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource MarketTabItem}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 列表行：两行正文 + 右侧来源，整行可点。 -->
        <Style x:Key="MarketSkillItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Padding" Value="{StaticResource Pad.Schedules.Row}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Button}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Row}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Sel}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MarketSkillList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource MarketSkillItem}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        </Style>

        <!-- 36×20 开关：关闭是灰色轨道，开启是主题色；圆点 16。 -->
        <Style x:Key="MarketSwitch" TargetType="ToggleButton">
            <Setter Property="Width" Value="{StaticResource Metric.Market.Switch.Width}" />
            <Setter Property="Height" Value="{StaticResource Metric.Market.Switch.Height}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Button}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track"
                                Width="{StaticResource Metric.Market.Switch.Width}"
                                Height="{StaticResource Metric.Market.Switch.Height}"
                                Background="{DynamicResource Brush.TabBorder}"
                                CornerRadius="{StaticResource Radius.Market.Switch}"
                                SnapsToDevicePixels="True">
                            <Ellipse x:Name="Knob"
                                     Width="{StaticResource Metric.Market.Switch.Knob}"
                                     Height="{StaticResource Metric.Market.Switch.Knob}"
                                     Margin="2,0,0,0"
                                     HorizontalAlignment="Left"
                                     Fill="{DynamicResource Brush.Canvas}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.Accent}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,2,0" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource Brush.Canvas}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                <Setter TargetName="Track" Property="BorderThickness" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="{StaticResource Opacity.Disabled}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MarketSectionLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
            <Setter Property="Margin" Value="{StaticResource Margin.Schedules.Section}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text2}" />
            <Setter Property="FontWeight" Value="{StaticResource Font.Weight.Medium}" />
        </Style>

        <Style x:Key="MarketCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Canvas}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line2}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Schedules.Card}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="MarketRow" TargetType="Border">
            <Setter Property="Height" Value="{StaticResource Metric.Schedules.Form.RowHeight}" />
            <Setter Property="Padding" Value="{StaticResource Pad.Market.CardRow}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line2}" />
            <Setter Property="BorderThickness" Value="{StaticResource Thickness.Schedules.RowDivider}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="MarketRowLast" TargetType="Border" BasedOn="{StaticResource MarketRow}">
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style x:Key="MarketRowLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        </Style>

        <Style x:Key="MarketRowValue" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text2}" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <ContextMenu x:Key="MarketPageMenu" x:Shared="False">
            <MenuItem Header="{x:Static res:Strings.MarketImportFolder}"
                      Command="{Binding PlacementTarget.DataContext.ImportCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="{x:Static res:Strings.MarketRefresh}"
                      InputGestureText="F5"
                      Command="{Binding PlacementTarget.DataContext.RefreshCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <Separator />
            <MenuItem Header="{x:Static res:Strings.MarketOpenSkillsFolder}"
                      Command="{Binding PlacementTarget.DataContext.OpenSkillsFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="{x:Static res:Strings.MarketOpenUserFolder}"
                      Command="{Binding PlacementTarget.DataContext.OpenUserSkillsFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        </ContextMenu>

        <ContextMenu x:Key="MarketDetailMenu" x:Shared="False">
            <MenuItem Header="{x:Static res:Strings.MarketOpenFolder}"
                      Command="{Binding PlacementTarget.DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="{x:Static res:Strings.MarketOpenInEditor}"
                      Command="{Binding PlacementTarget.DataContext.OpenInEditorCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="{x:Static res:Strings.MarketCopyPath}"
                      Command="{Binding PlacementTarget.DataContext.CopyPathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        </ContextMenu>
    </UserControl.Resources>

    <Grid Margin="{StaticResource Pad.Schedules.Page}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头：能力市场 + 说明；右侧页面菜单与关闭。 -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Path Style="{StaticResource Icon.Solid}"
                      Data="{StaticResource Ico.Market}"
                      Fill="{DynamicResource Brush.Text2}" />
                <TextBlock Margin="9,0,0,0"
                           VerticalAlignment="Center"
                           Text="{x:Static res:Strings.CapabilityMarket}"
                           Style="{StaticResource Text.PageTitle}" />
                <TextBlock Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           Text="技能按工作区启用；模型只在需要时读取正文。"
                           Style="{StaticResource Text.Meta}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <Button x:Name="PageMenuButton"
                        Style="{StaticResource Button.Icon}"
                        Click="OnPageMenuClick"
                        ContextMenu="{StaticResource MarketPageMenu}"
                        ToolTip="{x:Static res:Strings.MarketActions}"
                        AutomationProperties.Name="{x:Static res:Strings.MarketActions}"
                        KeyboardNavigation.TabIndex="0">
                    <Path Style="{StaticResource Icon.Solid}"
                          Data="{StaticResource Ico.More}"
                          Fill="{DynamicResource Brush.Text3}" />
                </Button>
                <Button Margin="8,0,0,0"
                        Style="{StaticResource Button.Icon}"
                        Command="{Binding CloseCommand}"
                        ToolTip="{x:Static res:Strings.MarketCloseTooltip}"
                        AutomationProperties.Name="{x:Static res:Strings.MarketCloseTooltip}"
                        KeyboardNavigation.TabIndex="1">
                    <Path Style="{StaticResource Icon}"
                          Data="{StaticResource Ico.Close}"
                          Fill="{DynamicResource Brush.Text3}" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1"
              x:Name="MarketContent"
              SizeChanged="OnMarketContentSizeChanged"
              MaxWidth="{StaticResource Metric.Schedules.Content.MaxWidth}"
              HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 左列：搜索 + 导入 + 技能目录。没有筛选 chip，也没有范围切换。 -->
            <Grid Grid.Column="0" Margin="0,0,18,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <TextBox x:Name="SearchBox"
                                 Height="{StaticResource Metric.Field.Height}"
                                 Padding="{StaticResource Pad.Schedules.Field}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center"
                                 AutomationProperties.Name="{x:Static res:Strings.MarketSearchHint}"
                                 KeyboardNavigation.TabIndex="2" />
                        <TextBlock Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Text="{x:Static res:Strings.MarketSearchHint}"
                                   Style="{StaticResource Text.Body}"
                                   Foreground="{DynamicResource Brush.Text3}"
                                   Visibility="{Binding SearchText, Converter={StaticResource EmptyStringToVisibility}}" />
                    </Grid>
                    <Button Grid.Column="1"
                            Margin="8,0,0,0"
                            Style="{StaticResource Button.Primary}"
                            Height="{StaticResource Metric.Field.Height}"
                            Command="{Binding ImportCommand}"
                            Content="{x:Static res:Strings.MarketImport}"
                            AutomationProperties.Name="{x:Static res:Strings.MarketImport}"
                            KeyboardNavigation.TabIndex="3" />
                </Grid>

                <Grid Grid.Row="1">
                    <ListBox x:Name="SkillList"
                             Style="{StaticResource MarketSkillList}"
                             ItemsSource="{Binding Items}"
                             SelectedItem="{Binding Selected, Mode=TwoWay}"
                             AutomationProperties.Name="{x:Static res:Strings.CapabilityMarket}"
                             KeyboardNavigation.TabIndex="4">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Path Grid.Column="0"
                                          Margin="0,3,0,0"
                                          VerticalAlignment="Top"
                                          Style="{StaticResource Icon.Stroke.Exact}"
                                          Data="{StaticResource Ico.Browse}"
                                          Stroke="{DynamicResource Brush.Text3}" />

                                    <StackPanel Grid.Column="1" Margin="10,0,10,0">
                                        <TextBlock x:Name="SkillName"
                                                   Text="{Binding Name}"
                                                   Style="{StaticResource Text.H3}"
                                                   FontWeight="{StaticResource Font.Weight.Medium}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="SkillSubtitle"
                                                   Margin="0,2,0,0"
                                                   Text="{Binding Subtitle}"
                                                   Style="{StaticResource Text.Meta}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Path Margin="0,0,6,0"
                                              Style="{StaticResource Icon}"
                                              Data="{StaticResource Ico.Warning}"
                                              Fill="{DynamicResource Brush.Warning}"
                                              Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="{Binding SourceLabel}"
                                                   Style="{StaticResource Text.Time}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                        <Setter TargetName="SkillName" Property="Foreground" Value="{DynamicResource Brush.Text2}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsValid}" Value="False">
                                        <Setter TargetName="SkillName" Property="Foreground" Value="{DynamicResource Brush.Text}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsValid}" Value="False">
                                        <Setter TargetName="SkillSubtitle" Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 空态：品牌插画 + 一句话 + 导入；没有工作区时只提示先选工作区。 -->
                    <StackPanel Margin="{StaticResource Pad.Market.Empty}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVisibility}}">
                        <Image Width="{StaticResource Metric.Market.Empty.Icon}"
                               Height="{StaticResource Metric.Market.Empty.Icon}"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Source="pack://application:,,,/MiaoWu;component/Assets/Branding/MiaoWu.ico"
                               Visibility="{Binding ShowEmptyBrand, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Margin="{StaticResource Margin.Market.Empty}"
                                   HorizontalAlignment="Center"
                                   Text="{Binding EmptyTitle}"
                                   Style="{StaticResource Text.H2}"
                                   TextAlignment="Center" />
                        <TextBlock MaxWidth="420"
                                   Margin="0,6,0,0"
                                   HorizontalAlignment="Center"
                                   Text="{Binding EmptyText}"
                                   Style="{StaticResource Text.Empty}" />
                        <Button Margin="0,16,0,0"
                                MinWidth="96"
                                HorizontalAlignment="Center"
                                Style="{StaticResource Button.Primary}"
                                Height="{StaticResource Metric.Field.Height}"
                                Command="{Binding ImportCommand}"
                                Content="{x:Static res:Strings.MarketEmptyImport}"
                                AutomationProperties.Name="{x:Static res:Strings.MarketEmptyImport}"
                                Visibility="{Binding ShowEmptyImport, Converter={StaticResource BoolToVisibility}}"
                                KeyboardNavigation.TabIndex="5" />
                        <Button Margin="0,16,0,0"
                                MinWidth="96"
                                HorizontalAlignment="Center"
                                Style="{StaticResource Button.Ghost}"
                                Height="{StaticResource Metric.Field.Height}"
                                Command="{Binding ClearSearchCommand}"
                                Content="清除搜索"
                                AutomationProperties.Name="清除搜索"
                                Visibility="{Binding ShowEmptyClear, Converter={StaticResource BoolToVisibility}}"
                                KeyboardNavigation.TabIndex="6" />
                    </StackPanel>
                </Grid>

                <TextBlock Grid.Row="2"
                           Margin="0,8,0,0"
                           Text="{Binding StatusText}"
                           Style="{StaticResource Text.Meta}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding LoadError}" />
            </Grid>

            <!-- 右列：详情从右侧 180ms 滑出到 47%。 -->
            <controls:CollapsiblePane x:Name="MarketDetailPane"
                                      Grid.Column="1"
                                      IsCollapsed="{Binding IsDetailCollapsed}">
                <Border Width="{Binding ElementName=MarketDetailPane, Path=ExpandedWidth}"
                        HorizontalAlignment="Right"
                        BorderBrush="{DynamicResource Brush.Line2}"
                        BorderThickness="1,0,0,0">
                    <Grid Margin="{StaticResource Pad.Schedules.Detail}"
                          Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"
                                       Text="{Binding Detail.Name}"
                                       Style="{StaticResource Text.H2}"
                                       TextTrimming="CharacterEllipsis" />
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Border Margin="0,0,8,0"
                                        Padding="1"
                                        Background="{DynamicResource Brush.Sel}"
                                        CornerRadius="{StaticResource Radius.Segment}">
                                    <ListBox Style="{StaticResource MarketTabList}"
                                             ItemsSource="{Binding Detail.Tabs}"
                                             SelectedItem="{Binding Detail.SelectedTab, Mode=TwoWay}"
                                             AutomationProperties.Name="{x:Static res:Strings.MarketTabsAutomation}"
                                             KeyboardNavigation.TabIndex="10">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Label}" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                                <Button x:Name="DetailMenuButton"
                                        DataContext="{Binding Detail}"
                                        Style="{StaticResource Button.Icon}"
                                        Click="OnDetailMenuClick"
                                        ContextMenu="{StaticResource MarketDetailMenu}"
                                        ToolTip="{x:Static res:Strings.MarketActions}"
                                        AutomationProperties.Name="{x:Static res:Strings.MarketActions}"
                                        KeyboardNavigation.TabIndex="11">
                                    <Path Style="{StaticResource Icon.Solid}"
                                          Data="{StaticResource Ico.More}"
                                          Fill="{DynamicResource Brush.Text3}" />
                                </Button>
                                <Button Margin="8,0,0,0"
                                        Style="{StaticResource Button.Icon}"
                                        Command="{Binding CollapseCommand}"
                                        ToolTip="{x:Static res:Strings.MarketCollapse}"
                                        AutomationProperties.Name="{x:Static res:Strings.MarketCollapse}"
                                        KeyboardNavigation.TabIndex="12">
                                    <Path Style="{StaticResource Icon}"
                                          Data="{StaticResource Ico.ChevronRight}"
                                          Fill="{DynamicResource Brush.Text3}" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- 概览 -->
                        <ScrollViewer Grid.Row="1"
                                      Padding="0,0,12,0"
                                      Style="{StaticResource ScrollViewer.Overlay}"
                                      Visibility="{Binding Detail.IsOverview, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <Border Style="{StaticResource MarketCard}">
                                    <Border Style="{StaticResource MarketRowLast}">
                                        <Grid>
                                            <TextBlock Text="在本工作区启用" Style="{StaticResource MarketRowLabel}" />
                                            <ToggleButton HorizontalAlignment="Right"
                                                          VerticalAlignment="Center"
                                                          Style="{StaticResource MarketSwitch}"
                                                          IsChecked="{Binding Detail.IsEnabled, Mode=OneWay}"
                                                          IsEnabled="{Binding Detail.CanToggle}"
                                                          Command="{Binding Detail.ToggleEnabledCommand}"
                                                          AutomationProperties.Name="在本工作区启用" />
                                        </Grid>
                                    </Border>
                                </Border>
                                <TextBlock Margin="2,6,0,0"
                                           Text="{Binding Detail.EnabledHint}"
                                           Style="{StaticResource Text.Meta}"
                                           TextWrapping="Wrap" />

                                <TextBlock Margin="2,14,0,0"
                                           Text="{Binding Detail.Description}"
                                           Style="{StaticResource Text.Body}"
                                           Foreground="{DynamicResource Brush.Text2}"
                                           TextWrapping="Wrap" />

                                <TextBlock Text="使用" Style="{StaticResource MarketSectionLabel}" />
                                <Border Style="{StaticResource MarketCard}">
                                    <StackPanel>
                                        <Border Style="{StaticResource MarketRow}">
                                            <Grid>
                                                <TextBlock Text="自动加载" Style="{StaticResource MarketRowLabel}" />
                                                <TextBlock Text="模型按描述判断" Style="{StaticResource MarketRowValue}" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource MarketRowLast}">
                                            <Grid>
                                                <TextBlock Text="正文读取" Style="{StaticResource MarketRowLabel}" />
                                                <TextBlock Text="需要时读取 SKILL.md" Style="{StaticResource MarketRowValue}" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="来源" Style="{StaticResource MarketSectionLabel}" />
                                <Border Style="{StaticResource MarketCard}">
                                    <StackPanel>
                                        <Border Style="{StaticResource MarketRow}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="位置" Style="{StaticResource MarketRowLabel}" />
                                                <TextBlock Grid.Column="1"
                                                           Margin="12,0,8,0"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding Detail.LocationText}"
                                                           FontFamily="{StaticResource Font.Family.Code}"
                                                           FontSize="{StaticResource Font.InlineCode.Size}"
                                                           Foreground="{DynamicResource Brush.Text2}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Detail.Model.BodyPath}" />
                                                <Button Grid.Column="2"
                                                        Style="{StaticResource Button.Icon}"
                                                        Command="{Binding Detail.CopyPathCommand}"
                                                        ToolTip="{x:Static res:Strings.MarketCopyPath}"
                                                        AutomationProperties.Name="{x:Static res:Strings.MarketCopyPath}">
                                                    <Path Grid.Column="2"
                                                          Style="{StaticResource Icon.Stroke.Exact}"
                                                          Data="{StaticResource Ico.Copy}"
                                                          Stroke="{DynamicResource Brush.Text3}"
                                                          VerticalAlignment="Center" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource MarketRow}">
                                            <Grid>
                                                <TextBlock Text="类型" Style="{StaticResource MarketRowLabel}" />
                                                <TextBlock Text="{Binding Detail.SourceLabel}" Style="{StaticResource MarketRowValue}" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource MarketRow}">
                                            <Grid>
                                                <TextBlock Text="更新" Style="{StaticResource MarketRowLabel}" />
                                                <TextBlock Text="{Binding Detail.UpdatedText}" Style="{StaticResource MarketRowValue}" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource MarketRowLast}">
                                            <Grid>
                                                <TextBlock Text="大小" Style="{StaticResource MarketRowLabel}" />
                                                <TextBlock Text="{Binding Detail.SizeText}" Style="{StaticResource MarketRowValue}" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <StackPanel Visibility="{Binding Detail.HasFiles, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="包含文件" Style="{StaticResource MarketSectionLabel}" />
                                    <Border Style="{StaticResource MarketCard}">
                                        <StackPanel>
                                            <ItemsControl ItemsSource="{Binding Detail.Files}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Height="{StaticResource Metric.Market.FileRow.Height}"
                                                            Padding="14,0"
                                                            HorizontalContentAlignment="Stretch"
                                                            Style="{StaticResource Button.Ghost}"
                                                            Command="{Binding DataContext.Detail.OpenFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            AutomationProperties.Name="{Binding RelativePath}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Path Style="{StaticResource Icon}"
                                                                  Data="{StaticResource Ico.File}"
                                                                  Fill="{DynamicResource Brush.Text3}" />
                                                            <TextBlock Grid.Column="1"
                                                                       Margin="8,0,8,0"
                                                                       VerticalAlignment="Center"
                                                                       Text="{Binding RelativePath}"
                                                                       Style="{StaticResource Text.ListRow}"
                                                                       Foreground="{DynamicResource Brush.Text2}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Column="2"
                                                                       VerticalAlignment="Center"
                                                                       Text="{Binding SizeText}"
                                                                       Style="{StaticResource Text.Meta}" />
                                                            <Path Grid.Column="3"
                                                                  Margin="8,0,0,0"
                                                                  Style="{StaticResource Icon}"
                                                                  Data="{StaticResource Ico.ChevronRight}"
                                                                  Fill="{DynamicResource Brush.Text3}" />
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Margin="14,4,14,0"
                                                       Text="{Binding Detail.ExtraFilesText}"
                                                       Style="{StaticResource Text.Meta}"
                                                       Visibility="{Binding Detail.HasExtraFiles, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Margin="2,6,0,0"
                                               Text="技能目录里的脚本不会被自动执行。"
                                               Style="{StaticResource Text.Meta}" />
                                </StackPanel>

                                <StackPanel Margin="0,14,0,0"
                                            Visibility="{Binding Detail.HasDiagnostics, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsControl ItemsSource="{Binding Detail.Diagnostics}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="Diag"
                                                        Margin="0,0,0,4"
                                                        Padding="10,8"
                                                        Background="{DynamicResource Brush.WarningSoft}"
                                                        CornerRadius="{StaticResource Radius.Button}">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Message}"
                                                                   Style="{StaticResource Text.Body}"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource Brush.Text}" />
                                                        <TextBlock Text="{Binding Path}"
                                                                   Style="{StaticResource Text.Meta}"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Level}" Value="{x:Static skills:SkillDiagnosticLevel.Error}">
                                                        <Setter TargetName="Diag" Property="Background" Value="{DynamicResource Brush.DangerSoft}" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- 正文：只读，原始 SKILL.md（含 frontmatter）。 -->
                        <ScrollViewer Grid.Row="1"
                                      Padding="0,0,12,0"
                                      Style="{StaticResource ScrollViewer.Overlay}"
                                      Visibility="{Binding Detail.IsBody, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="SKILL.md"
                                                   Style="{StaticResource Text.ListRow}"
                                                   FontWeight="{StaticResource Font.Weight.Medium}"
                                                   Foreground="{DynamicResource Brush.Text}" />
                                        <TextBlock Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding Detail.SizeText}"
                                                   Style="{StaticResource Text.Meta}" />
                                    </StackPanel>
                                    <Button HorizontalAlignment="Right"
                                            Height="{StaticResource Metric.Button.Primary.Height}"
                                            Style="{StaticResource Button.Ghost}"
                                            Content="{x:Static res:Strings.MarketOpenInEditor}"
                                            Command="{Binding Detail.OpenInEditorCommand}"
                                            AutomationProperties.Name="{x:Static res:Strings.MarketOpenInEditor}" />
                                </Grid>
                                <TextBlock Margin="0,0,0,8"
                                           Text="技能正文是不可信内容；MiaoWu 不会执行技能目录里的脚本。"
                                           Style="{StaticResource Text.Meta}"
                                           TextWrapping="Wrap" />
                                <Border Padding="12"
                                        Background="{DynamicResource Brush.CodeBackground}"
                                        BorderBrush="{DynamicResource Brush.Line2}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource Radius.Code}">
                                    <TextBox Text="{Binding Detail.BodyText, Mode=OneWay}"
                                             IsReadOnly="True"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             FontFamily="{StaticResource Font.Family.Code}"
                                             FontSize="{StaticResource Font.Code.Size}"
                                             VerticalScrollBarVisibility="Auto"
                                             AutomationProperties.Name="技能正文" />
                                </Border>
                                <TextBlock Margin="0,8,0,0"
                                           Text="{Binding Detail.BodyError}"
                                           Style="{StaticResource Text.Body}"
                                           Foreground="{DynamicResource Brush.Warning}"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding Detail.HasBodyError, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </ScrollViewer>

                        <!-- 底栏：自有 / 继承 / 无效技能都只提供打开动作，右对齐。 -->
                        <Border Grid.Row="2" Padding="{StaticResource Margin.Schedules.Footer}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource Button.Ghost}"
                                        Command="{Binding Detail.OpenFolderCommand}"
                                        Content="{x:Static res:Strings.MarketOpenFolder}"
                                        AutomationProperties.Name="{x:Static res:Strings.MarketOpenFolder}"
                                        KeyboardNavigation.TabIndex="20" />
                                <Button Margin="8,0,0,0"
                                        Style="{StaticResource Button.Primary}"
                                        Height="{StaticResource Metric.Field.Height}"
                                        MinWidth="96"
                                        Command="{Binding Detail.OpenInEditorCommand}"
                                        Content="{x:Static res:Strings.MarketOpenInEditor}"
                                        AutomationProperties.Name="{x:Static res:Strings.MarketOpenInEditor}"
                                        KeyboardNavigation.TabIndex="21" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </controls:CollapsiblePane>
        </Grid>
    </Grid>
</UserControl>
