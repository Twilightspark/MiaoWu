<UserControl x:Class="MiaoWu.App.Views.NotificationHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="440"
             d:DesignHeight="400"
             Focusable="False"
             Background="Transparent"
             IsHitTestVisible="True">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <ItemsControl ItemsSource="{Binding Notifications}"
                  Width="{StaticResource Metric.Notification.Width}"
                  Margin="0,0,16,146"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Bottom"
                  Focusable="False">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border Margin="0,9,0,0"
                        Padding="12,10"
                        Background="{DynamicResource Brush.Canvas}"
                        BorderBrush="{DynamicResource Brush.Line2}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Notification}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Path x:Name="NoticeIcon"
                                  Width="14"
                                  Height="14"
                                  VerticalAlignment="Top"
                                  Margin="0,3,0,0"
                                  Style="{StaticResource Icon}"
                                  Data="{StaticResource Ico.Check}"
                                  Fill="{DynamicResource Brush.Success}" />
                            <TextBlock Grid.Column="1"
                                       Margin="8,0,0,0"
                                       Text="{Binding Title}"
                                       Style="{StaticResource Text.H3}"
                                       TextWrapping="Wrap" />
                            <Button Grid.Column="2"
                                    Width="20"
                                    Height="20"
                                    Style="{StaticResource Button.Icon}"
                                    Command="{Binding DismissCommand}"
                                    AutomationProperties.Name="关闭通知">
                                <Path Width="12"
                                      Height="12"
                                      Style="{StaticResource Icon}"
                                      Data="{StaticResource Ico.Close}"
                                      Fill="{DynamicResource Brush.Text3}" />
                            </Button>
                        </Grid>

                        <TextBlock Grid.Row="1"
                                   Margin="22,4,0,0"
                                   Text="{Binding Body}"
                                   Style="{StaticResource Text.Meta}"
                                   TextWrapping="Wrap"
                                   MaxHeight="72" />

                        <StackPanel Grid.Row="2"
                                    Margin="22,8,0,0"
                                    Orientation="Horizontal"
                                    Visibility="{Binding IsApproval, Converter={StaticResource BoolToVisibility}}">
                            <Button Content="允许一次"
                                    Style="{StaticResource Button.Primary}"
                                    Command="{Binding AllowOnceCommand}" />
                            <Button Margin="6,0,0,0"
                                    Content="本会话允许"
                                    Style="{StaticResource Button.Ghost}"
                                    Command="{Binding AllowSessionCommand}"
                                    Visibility="{Binding CanApproveForSession, Converter={StaticResource BoolToVisibility}}" />
                            <Button Margin="6,0,0,0"
                                    Content="拒绝"
                                    Style="{StaticResource Button.Ghost}"
                                    Command="{Binding DenyCommand}" />
                        </StackPanel>

                        <TextBlock Grid.Row="2"
                                   Margin="22,6,0,0"
                                   Text="{Binding ResolutionText}"
                                   Style="{StaticResource Text.Meta}"
                                   Foreground="{DynamicResource Brush.Text3}"
                                   Visibility="{Binding IsResolved, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsApproval}" Value="True">
                        <Setter TargetName="NoticeIcon" Property="Data" Value="{StaticResource Ico.Warning}" />
                        <Setter TargetName="NoticeIcon" Property="Fill" Value="{DynamicResource Brush.Warning}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
