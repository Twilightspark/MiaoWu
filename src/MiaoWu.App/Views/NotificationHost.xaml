<UserControl x:Class="MiaoWu.App.Views.NotificationHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="440"
             d:DesignHeight="400"
             Focusable="False">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <!-- 根元素不要铺 Transparent：UserControl 的边界包含通知栈底距，
         透明背景仍参与命中测试，会把下方输入框的点击整块吃掉。
         正文完整换行显示，不设 MaxHeight；条数多到超过可用高度时整栈可滚动。 -->
    <Grid Focusable="False">
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Margin" Value="{StaticResource Margin.Notification}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsRightPaneCollapsed}" Value="True">
                        <Setter Property="Margin" Value="{StaticResource Margin.NotificationCollapsed}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>

        <ScrollViewer x:Name="NoticeScroll"
                      MaxHeight="{StaticResource Metric.Notification.StackMaxHeight}"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Bottom"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      Focusable="False">
            <ItemsControl ItemsSource="{Binding Notifications}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,9,0,0"
                                Padding="12,10"
                                Background="{DynamicResource Brush.Canvas}"
                                BorderBrush="{DynamicResource Brush.Line2}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Notification}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Path x:Name="NoticeIcon"
                                          Width="14"
                                          Height="14"
                                          VerticalAlignment="Top"
                                          Margin="0,3,0,0"
                                          Style="{StaticResource Icon}"
                                          Data="{StaticResource Ico.Check}"
                                          Fill="{DynamicResource Brush.Success}" />
                                    <TextBlock Grid.Column="1"
                                               Margin="8,0,0,0"
                                               Text="{Binding Title}"
                                               Style="{StaticResource Text.H3}"
                                               TextWrapping="Wrap" />
                                    <!-- 审批必须显式允许或拒绝，不给“关掉就算”的出口。 -->
                                    <Button Grid.Column="2"
                                            Width="20"
                                            Height="20"
                                            Style="{StaticResource Button.Icon}"
                                            Command="{Binding DismissCommand}"
                                            Visibility="{Binding IsNotice, Converter={StaticResource BoolToVisibility}}"
                                            AutomationProperties.Name="关闭通知">
                                        <Path Width="12"
                                              Height="12"
                                              Style="{StaticResource Icon}"
                                              Data="{StaticResource Ico.Close}"
                                              Fill="{DynamicResource Brush.Text3}" />
                                    </Button>
                                </Grid>

                                <TextBlock Grid.Row="1"
                                           Margin="22,4,0,0"
                                           Text="{Binding Body}"
                                           Style="{StaticResource Text.Reasoning}"
                                           Foreground="{DynamicResource Brush.Text2}"
                                           TextWrapping="Wrap" />

                                <StackPanel Grid.Row="2"
                                            Margin="22,8,0,0"
                                            Orientation="Horizontal"
                                            Visibility="{Binding ShowApprovalActions, Converter={StaticResource BoolToVisibility}}">
                                    <Button Content="允许一次"
                                            Style="{StaticResource Button.Primary}"
                                            Command="{Binding AllowOnceCommand}" />
                                    <Button Margin="6,0,0,0"
                                            Content="本会话允许"
                                            Style="{StaticResource Button.Ghost}"
                                            Command="{Binding AllowSessionCommand}"
                                            Visibility="{Binding CanApproveForSession, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Margin="6,0,0,0"
                                            Content="{Binding DiffToggleLabel}"
                                            Style="{StaticResource Button.Ghost}"
                                            Command="{Binding ToggleDiffCommand}"
                                            Visibility="{Binding HasDiff, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Margin="6,0,0,0"
                                            Content="拒绝"
                                            Style="{StaticResource Button.Ghost}"
                                            Command="{Binding DenyCommand}" />
                                </StackPanel>

                                <!-- 提问：选项即动作；多选时先切换选中，再点“确认”。 -->
                                <StackPanel Grid.Row="2"
                                            Margin="22,6,0,0"
                                            Visibility="{Binding ShowQuestionActions, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsControl ItemsSource="{Binding Options}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Margin="0,2,0,0"
                                                        Padding="4,6"
                                                        HorizontalContentAlignment="Left"
                                                        Style="{StaticResource Button.Ghost}"
                                                        Command="{Binding ChooseCommand}"
                                                        AutomationProperties.Name="{Binding Label}">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Label}"
                                                                   Style="{StaticResource Text.Body}"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Margin="0,2,0,0"
                                                                   Text="{Binding Description}"
                                                                   Style="{StaticResource Text.Meta}"
                                                                   Foreground="{DynamicResource Brush.Text3}"
                                                                   TextWrapping="Wrap"
                                                                   Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisibility}}" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Grid Margin="0,6,0,0"
                                          Visibility="{Binding AllowFreeText, Converter={StaticResource BoolToVisibility}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Height="30"
                                                 VerticalContentAlignment="Center"
                                                 Padding="{StaticResource Pad.Field}"
                                                 Text="{Binding FreeText, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="自由回答" />
                                        <Button Grid.Column="1"
                                                Margin="6,0,0,0"
                                                Content="提交"
                                                Style="{StaticResource Button.Primary}"
                                                Command="{Binding SubmitFreeTextCommand}" />
                                    </Grid>
                                    <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                        <Button Content="确认"
                                                Style="{StaticResource Button.Primary}"
                                                Command="{Binding SubmitAnswerCommand}"
                                                Visibility="{Binding QuestionMultiSelect, Converter={StaticResource BoolToVisibility}}" />
                                        <Button Margin="6,0,0,0"
                                                Content="跳过"
                                                Style="{StaticResource Button.Ghost}"
                                                Command="{Binding SkipQuestionCommand}" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- 改动预览留在通知里：审批不再进消息流，diff 只能在这里看。 -->
                                <Border Grid.Row="3"
                                        Margin="22,8,0,0"
                                        Padding="8,6"
                                        Background="{DynamicResource Brush.CodeBackground}"
                                        CornerRadius="{StaticResource Radius.Code}"
                                        Visibility="{Binding IsDiffVisible, Converter={StaticResource BoolToVisibility}}">
                                    <TextBox MaxHeight="180"
                                             Padding="0"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             IsReadOnly="True"
                                             AcceptsReturn="True"
                                             TextWrapping="NoWrap"
                                             HorizontalScrollBarVisibility="Auto"
                                             VerticalScrollBarVisibility="Auto"
                                             FontFamily="{StaticResource Font.Family.Code}"
                                             FontSize="{StaticResource Font.Code.Size}"
                                             TextBlock.LineHeight="{StaticResource Font.Code.Line}"
                                             Text="{Binding Diff, Mode=OneWay}" />
                                </Border>

                                <TextBlock Grid.Row="4"
                                           Margin="22,6,0,0"
                                           Text="{Binding ResolutionText}"
                                           Style="{StaticResource Text.Meta}"
                                           Foreground="{DynamicResource Brush.Text3}"
                                           Visibility="{Binding IsResolved, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsApproval}" Value="True">
                                <Setter TargetName="NoticeIcon" Property="Data" Value="{StaticResource Ico.Warning}" />
                                <Setter TargetName="NoticeIcon" Property="Fill" Value="{DynamicResource Brush.Warning}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsQuestion}" Value="True">
                                <Setter TargetName="NoticeIcon" Property="Data" Value="{StaticResource Ico.Sparkle}" />
                                <Setter TargetName="NoticeIcon" Property="Fill" Value="{DynamicResource Brush.Info}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
