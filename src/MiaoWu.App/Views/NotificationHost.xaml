<UserControl x:Class="MiaoWu.App.Views.NotificationHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:MiaoWu.App.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="720"
             d:DesignHeight="420"
             Focusable="False">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:EmptyStringToVisibilityConverter x:Key="EmptyToVisibility" />
    </UserControl.Resources>

    <!-- 审批与提问覆盖输入卡弹出：宽度跟内容列（与输入卡同宽），底边贴输入卡底边，
         内容高时向上长并压住消息流，最高一栈 440，超过自己滚动。
         根元素不要铺 Transparent：透明背景仍参与命中测试，会把弹窗上方的消息流点击整块吃掉。
         正文完整换行显示，不设 MaxHeight。 -->
    <Grid Focusable="False">
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Margin" Value="{StaticResource Margin.PendingPrompt}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Conversation.ComposerDock.HasAny}" Value="True">
                        <Setter Property="Margin" Value="{StaticResource Margin.PendingPromptDocked}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>

        <ScrollViewer x:Name="NoticeScroll"
                      MaxHeight="{StaticResource Metric.Notification.StackMaxHeight}"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Bottom"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      Focusable="False">
            <ItemsControl ItemsSource="{Binding Notifications}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,9,0,0"
                                Padding="{StaticResource Pad.NotificationCard}"
                                Background="{DynamicResource Brush.Canvas}"
                                BorderBrush="{DynamicResource Brush.Line2}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Notification}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path x:Name="NoticeIcon"
                                          Width="14"
                                          Height="14"
                                          VerticalAlignment="Top"
                                          Margin="0,3,0,0"
                                          Style="{StaticResource Icon}"
                                          Data="{StaticResource Ico.Check}"
                                          Fill="{DynamicResource Brush.Success}" />
                                    <TextBlock Grid.Column="1"
                                               Margin="8,0,0,0"
                                               Text="{Binding Title}"
                                               Style="{StaticResource Text.H3}"
                                               TextWrapping="Wrap" />
                                </Grid>

                                <TextBlock Grid.Row="1"
                                           Margin="22,4,0,0"
                                           Text="{Binding Body}"
                                           Style="{StaticResource Text.Reasoning}"
                                           Foreground="{DynamicResource Brush.Text2}"
                                           TextWrapping="Wrap" />

                                <StackPanel Grid.Row="2"
                                            Margin="22,8,0,0"
                                            Orientation="Horizontal"
                                            Visibility="{Binding ShowApprovalActions, Converter={StaticResource BoolToVisibility}}">
                                    <Button Content="允许一次"
                                            Style="{StaticResource Button.Primary}"
                                            Command="{Binding AllowOnceCommand}" />
                                    <Button Margin="6,0,0,0"
                                            Content="本会话允许"
                                            Style="{StaticResource Button.Ghost}"
                                            Command="{Binding AllowSessionCommand}"
                                            Visibility="{Binding CanApproveForSession, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Margin="6,0,0,0"
                                            Content="{Binding DiffToggleLabel}"
                                            Style="{StaticResource Button.Ghost}"
                                            Command="{Binding ToggleDiffCommand}"
                                            Visibility="{Binding HasDiff, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Margin="6,0,0,0"
                                            Content="拒绝"
                                            Style="{StaticResource Button.Ghost}"
                                            Command="{Binding DenyCommand}" />
                                </StackPanel>

                                <!-- 提问：选项即动作（多选时先切换选中、再点“确认”）；选项下面是
                                     始终可用的手动输入，选项覆盖不了答案时直接写一句提交。 -->
                                <StackPanel Grid.Row="2"
                                            Margin="22,6,0,0"
                                            Visibility="{Binding ShowQuestionActions, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsControl ItemsSource="{Binding Options}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Margin="0,2,0,0"
                                                        Padding="4,6"
                                                        HorizontalContentAlignment="Left"
                                                        Style="{StaticResource Button.Ghost}"
                                                        Command="{Binding ChooseCommand}"
                                                        AutomationProperties.Name="{Binding Label}">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Label}"
                                                                   Style="{StaticResource Text.Body}"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Margin="0,2,0,0"
                                                                   Text="{Binding Description}"
                                                                   Style="{StaticResource Text.Meta}"
                                                                   Foreground="{DynamicResource Brush.Text3}"
                                                                   TextWrapping="Wrap"
                                                                   Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisibility}}" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Grid Margin="0,8,0,0"
                                          Visibility="{Binding ShowsManualInput, Converter={StaticResource BoolToVisibility}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid>
                                            <TextBox Height="30"
                                                     VerticalContentAlignment="Center"
                                                     Padding="{StaticResource Pad.Field}"
                                                     Text="{Binding FreeText, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.Name="手动输入的回答">
                                                <TextBox.InputBindings>
                                                    <KeyBinding Key="Return" Command="{Binding SubmitFreeTextCommand}" />
                                                </TextBox.InputBindings>
                                            </TextBox>
                                            <TextBlock Margin="11,0,0,0"
                                                       VerticalAlignment="Center"
                                                       IsHitTestVisible="False"
                                                       Text="其他答案，自己写一句"
                                                       Style="{StaticResource Text.Body}"
                                                       Foreground="{DynamicResource Brush.Text3}"
                                                       Visibility="{Binding FreeText, Converter={StaticResource EmptyToVisibility}}" />
                                        </Grid>
                                        <Button Grid.Column="1"
                                                Margin="6,0,0,0"
                                                Content="提交"
                                                Style="{StaticResource Button.Primary}"
                                                Command="{Binding SubmitFreeTextCommand}" />
                                    </Grid>

                                    <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                        <Button Content="确认"
                                                Style="{StaticResource Button.Primary}"
                                                Command="{Binding SubmitAnswerCommand}"
                                                Visibility="{Binding QuestionMultiSelect, Converter={StaticResource BoolToVisibility}}" />
                                        <Button Margin="6,0,0,0"
                                                Content="跳过"
                                                Style="{StaticResource Button.Ghost}"
                                                Command="{Binding SkipQuestionCommand}" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- 改动预览留在弹窗里：审批不再进消息流，diff 只能在这里看。 -->
                                <Border Grid.Row="3"
                                        Margin="22,8,0,0"
                                        Padding="8,6"
                                        Background="{DynamicResource Brush.CodeBackground}"
                                        CornerRadius="{StaticResource Radius.Code}"
                                        Visibility="{Binding IsDiffVisible, Converter={StaticResource BoolToVisibility}}">
                                    <TextBox MaxHeight="180"
                                             Padding="0"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             IsReadOnly="True"
                                             AcceptsReturn="True"
                                             TextWrapping="NoWrap"
                                             HorizontalScrollBarVisibility="Auto"
                                             VerticalScrollBarVisibility="Auto"
                                             FontFamily="{StaticResource Font.Family.Code}"
                                             FontSize="{StaticResource Font.Code.Size}"
                                             TextBlock.LineHeight="{StaticResource Font.Code.Line}"
                                             Text="{Binding Diff, Mode=OneWay}" />
                                </Border>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsApproval}" Value="True">
                                <Setter TargetName="NoticeIcon" Property="Data" Value="{StaticResource Ico.Warning}" />
                                <Setter TargetName="NoticeIcon" Property="Fill" Value="{DynamicResource Brush.Warning}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsQuestion}" Value="True">
                                <Setter TargetName="NoticeIcon" Property="Data" Value="{StaticResource Ico.Sparkle}" />
                                <Setter TargetName="NoticeIcon" Property="Fill" Value="{DynamicResource Brush.Info}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
