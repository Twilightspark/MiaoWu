<UserControl x:Class="MiaoWu.App.Views.OnboardingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             xmlns:conv="clr-namespace:MiaoWu.App.Converters"
             xmlns:res="clr-namespace:MiaoWu.App.Resources"
             mc:Ignorable="d"
             d:DesignWidth="1440"
             d:DesignHeight="900"
             x:Name="Root"
             Focusable="False"
             Background="{DynamicResource Brush.Canvas}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             KeyboardNavigation.TabNavigation="Cycle"
             AutomationProperties.AutomationId="Onboarding">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />

        <!-- 与输入框同高的次级按钮：用于“选择文件夹 / 更换”。 -->
        <Style x:Key="OnboardingPickButton" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
            <Setter Property="FontSize" Value="{StaticResource Font.Button.Size}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text2}" />
            <Setter Property="Background" Value="{DynamicResource Brush.Canvas}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line3}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Button}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Button}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Sel}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="{StaticResource Opacity.Disabled}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PasswordBox 默认样式与 TextBox 不同，这里对齐引导页的输入框。
             PasswordBox 会把控件 Padding 同步给 PART_ContentHost（内容宿主），
             模板 Border 再套一次同样的内边距就变成双份：30 高 + 8,6 只剩 4px 视口，
             密码点与光标被裁成一条细线。所以 Border 不再吃 Padding，只由内容宿主留白。 -->
        <Style x:Key="OnboardingPasswordBox" TargetType="PasswordBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
            <Setter Property="FontSize" Value="{StaticResource Font.Body.Size}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            <Setter Property="Background" Value="{DynamicResource Brush.Canvas}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line3}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="{StaticResource Pad.TextBox.Compact}" />
            <Setter Property="CaretBrush" Value="{DynamicResource Brush.Text}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Radius.Button}"
                                Padding="0"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="{StaticResource Thickness.Focus}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="{StaticResource Opacity.Disabled}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OnboardingComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                CornerRadius="{StaticResource Radius.Tree}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 默认 ComboBox 是 Aero 渐变样式，与引导页的平面表单不一致。 -->
        <Style x:Key="OnboardingComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
            <Setter Property="FontSize" Value="{StaticResource Font.Body.Size}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            <Setter Property="Background" Value="{DynamicResource Brush.Canvas}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line3}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MaxDropDownHeight" Value="240" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource OnboardingComboBoxItem}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          ClickMode="Press"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="{StaticResource Radius.Button}"
                                                SnapsToDevicePixels="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="26" />
                                                </Grid.ColumnDefinitions>

                                                <ContentPresenter Grid.Column="0"
                                                                  Margin="9,0,24,0"
                                                                  VerticalAlignment="Center"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentStringFormat="{Binding SelectionBoxItemStringFormat, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  IsHitTestVisible="False" />

                                                <Path Grid.Column="1"
                                                      Width="12"
                                                      Height="12"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Style="{StaticResource Icon}"
                                                      Data="{StaticResource Ico.ChevronDown}"
                                                      Fill="{DynamicResource Brush.Text3}" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="{StaticResource Opacity.Disabled}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <!-- 必须 AllowsTransparency：否则 Popup 由不透明 HWND 承载，卡片 4px 上边距与
                                 8px 圆角切掉的四个角会露出窗口底色（纯黑），在 125% 缩放下是一条贯穿全宽的黑带。 -->
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="None">
                                <Border MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Margin="0,4,0,0"
                                        Background="{DynamicResource Brush.Canvas}"
                                        BorderBrush="{DynamicResource Brush.Line2}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource Radius.Card}">
                                    <ScrollViewer Margin="2" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ToggleButton" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="{StaticResource Opacity.Disabled}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题栏：主窗口处于首次引导状态时，这 44px 就是窗口标题栏。 -->
        <Grid Grid.Row="0"
              Height="{StaticResource Metric.TopBar.Height}"
              Background="{DynamicResource Brush.Canvas}">
            <TextBlock Margin="16,0,0,0"
                       VerticalAlignment="Center"
                       Text="首次设置"
                       Style="{StaticResource Text.Meta}"
                       AutomationProperties.AutomationId="OnboardingTitle" />

            <StackPanel HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <Button x:Name="WindowMinimize"
                        Style="{StaticResource Button.Window}"
                        Click="OnMinimizeClick"
                        ToolTip="{x:Static res:Strings.WindowMinimize}"
                        AutomationProperties.AutomationId="WindowMinimize"
                        AutomationProperties.Name="{x:Static res:Strings.WindowMinimize}"
                        KeyboardNavigation.TabIndex="11"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path Style="{StaticResource Icon.WindowGlyph}"
                          Data="{StaticResource Ico.WindowMinimize}"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
                <Button x:Name="WindowMaximize"
                        Style="{StaticResource Button.Window}"
                        Click="OnMaximizeRestoreClick"
                        ToolTip="{x:Static res:Strings.WindowMaximize}"
                        AutomationProperties.AutomationId="WindowMaximize"
                        AutomationProperties.Name="{x:Static res:Strings.WindowMaximize}"
                        KeyboardNavigation.TabIndex="12"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                        <Path.Style>
                            <Style TargetType="Path" BasedOn="{StaticResource Icon.WindowGlyph}">
                                <Setter Property="Data" Value="{StaticResource Ico.WindowMaximize}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 Value="Maximized">
                                        <Setter Property="Data" Value="{StaticResource Ico.WindowRestore}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </Button>
                <Button x:Name="WindowClose"
                        Style="{StaticResource Button.WindowClose}"
                        Click="OnCloseClick"
                        ToolTip="{x:Static res:Strings.WindowClose}"
                        AutomationProperties.AutomationId="WindowClose"
                        AutomationProperties.Name="{x:Static res:Strings.WindowClose}"
                        KeyboardNavigation.TabIndex="13"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path Style="{StaticResource Icon.WindowGlyph}"
                          Data="{StaticResource Ico.WindowClose}"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <Grid MinHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                <Grid Margin="48,24,48,32"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      AutomationProperties.AutomationId="OnboardingColumns">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 左栏：图标 + 应用名 + 标语，三者居中。 -->
                    <StackPanel Width="{StaticResource Metric.Onboarding.Left.Width}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Image Width="{StaticResource Metric.Onboarding.Icon}"
                               Height="{StaticResource Metric.Onboarding.Icon}"
                               HorizontalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               SnapsToDevicePixels="True"
                               Source="pack://application:,,,/MiaoWu;component/Assets/Branding/MiaoWu.png" />

                        <TextBlock Margin="0,18,0,0"
                                   HorizontalAlignment="Center"
                                   Text="{x:Static res:Strings.AppName}"
                                   TextAlignment="Center"
                                   Style="{StaticResource Text.Brand}" />

                        <TextBlock Margin="0,4,0,0"
                                   HorizontalAlignment="Center"
                                   Text="本地优先的智能体工作台"
                                   TextAlignment="Center"
                                   Style="{StaticResource Text.Body}"
                                   Foreground="{DynamicResource Brush.Text2}" />
                    </StackPanel>

                    <Border Grid.Column="1"
                            Width="1"
                            Margin="40,10,40,10"
                            Background="{DynamicResource Brush.Line2}" />

                    <!-- 右栏：两行表单 + 主操作。 -->
                    <StackPanel Grid.Column="2"
                                Width="{StaticResource Metric.Onboarding.Form.Width}"
                                VerticalAlignment="Center">

                        <Border Background="{DynamicResource Brush.Side}"
                                BorderBrush="{DynamicResource Brush.Line2}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Notification}">
                            <StackPanel>
                                <!-- 1 开始工作 -->
                                <Grid MinHeight="{StaticResource Metric.Onboarding.Row.MinHeight}"
                                      Margin="20,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center"
                                                Margin="0,14,14,14">
                                        <TextBlock Text="开始工作" Style="{StaticResource Text.H3}" />
                                        <TextBlock Margin="0,3,0,0"
                                                   Text="创建你的第一个工作目录"
                                                   Style="{StaticResource Text.Meta}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <Grid Grid.Column="1"
                                          Width="{StaticResource Metric.Onboarding.Field.Width}"
                                          VerticalAlignment="Center">
                                        <Button x:Name="ChooseWorkspaceButton"
                                                HorizontalAlignment="Left"
                                                Command="{Binding PickWorkspaceCommand}"
                                                Style="{StaticResource OnboardingPickButton}"
                                                Visibility="{Binding HasWorkspace, Converter={StaticResource InverseBoolToVisibility}, FallbackValue=Visible}"
                                                AutomationProperties.AutomationId="OnboardingPickWorkspace"
                                                AutomationProperties.Name="选择第一个工作目录"
                                                KeyboardNavigation.TabIndex="1">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Width="14"
                                                      Height="14"
                                                      Margin="0,0,6,0"
                                                      Style="{StaticResource Icon}"
                                                      Data="{StaticResource Ico.FolderPlus}"
                                                      Fill="{DynamicResource Brush.Text3}" />
                                                <TextBlock Text="选择文件夹…"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Brush.Text2}" />
                                            </StackPanel>
                                        </Button>

                                        <Grid Visibility="{Binding HasWorkspace, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock Text="工作区"
                                                           Style="{StaticResource Text.ListRow}"
                                                           Foreground="{DynamicResource Brush.Text}"
                                                           FontWeight="{StaticResource Font.Weight.Medium}"
                                                           ToolTip="{Binding WorkspaceName}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding WorkspacePath}"
                                                           Style="{StaticResource Text.Meta}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding WorkspacePath}" />
                                            </StackPanel>

                                            <Button Grid.Column="1"
                                                    Height="{StaticResource Metric.Hit.Min}"
                                                    Padding="6,0"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding PickWorkspaceCommand}"
                                                    Style="{StaticResource Button.Ghost}"
                                                    AutomationProperties.AutomationId="OnboardingChangeWorkspace"
                                                    AutomationProperties.Name="更换工作目录"
                                                    KeyboardNavigation.TabIndex="2">
                                                <TextBlock Text="更换"
                                                           FontSize="{StaticResource Font.Meta.Size}"
                                                           Foreground="{DynamicResource Brush.Text2}" />
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Grid>

                                <Border Height="1"
                                        Margin="20,0"
                                        Background="{DynamicResource Brush.Line2}" />

                                <!-- 2 添加模型 -->
                                <Grid MinHeight="{StaticResource Metric.Onboarding.Row.Provider.MinHeight}"
                                      Margin="20,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center"
                                                Margin="0,14,14,14">
                                        <TextBlock Text="添加模型" Style="{StaticResource Text.H3}" />
                                        <TextBlock Margin="0,3,0,0"
                                                   Text="添加你的模型供应商密钥"
                                                   Style="{StaticResource Text.Meta}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1"
                                                Width="{StaticResource Metric.Onboarding.Field.Width}"
                                                VerticalAlignment="Center">
                                        <ComboBox x:Name="ProviderCombo"
                                                  Style="{StaticResource OnboardingComboBox}"
                                                  ItemsSource="{Binding ProviderChoices}"
                                                  SelectedItem="{Binding SelectedChoice, Mode=TwoWay}"
                                                  DisplayMemberPath="DisplayName"
                                                  AutomationProperties.AutomationId="OnboardingProvider"
                                                  AutomationProperties.Name="模型供应商"
                                                  KeyboardNavigation.TabIndex="3" />

                                        <Grid Margin="0,6,0,0">
                                            <PasswordBox x:Name="ApiKeyBox"
                                                         Style="{StaticResource OnboardingPasswordBox}"
                                                         PasswordChanged="OnApiKeyChanged"
                                                         GotKeyboardFocus="OnApiKeyFocusChanged"
                                                         LostKeyboardFocus="OnApiKeyFocusChanged"
                                                         AutomationProperties.AutomationId="OnboardingApiKey"
                                                         AutomationProperties.Name="模型供应密钥，可留空"
                                                         KeyboardNavigation.TabIndex="4" />
                                            <TextBlock x:Name="ApiKeyHint"
                                                       Margin="9,0,0,0"
                                                       VerticalAlignment="Center"
                                                       IsHitTestVisible="False"
                                                       Text="API Key（可留空）"
                                                       Style="{StaticResource Text.Meta}" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Grid Width="{StaticResource Metric.Onboarding.Form.Width}"
                              MinHeight="16"
                              Margin="0,14,0,0">
                            <TextBlock Text="{Binding HintText}"
                                       HorizontalAlignment="Center"
                                       Style="{StaticResource Text.Meta}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding HasError, Converter={StaticResource InverseBoolToVisibility}, FallbackValue=Visible}" />
                            <TextBlock Text="{Binding ErrorText}"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource Brush.Danger}"
                                       Style="{StaticResource Text.Meta}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                        </Grid>

                        <Button Width="{StaticResource Metric.Onboarding.Button.Width}"
                                Height="{StaticResource Metric.Onboarding.Button.Height}"
                                Margin="0,14,0,0"
                                HorizontalAlignment="Center"
                                FontSize="{StaticResource Font.Body.Size}"
                                Style="{StaticResource Button.Primary}"
                                Command="{Binding StartCommand}"
                                AutomationProperties.AutomationId="OnboardingStart"
                                AutomationProperties.Name="开始使用喵悟"
                                KeyboardNavigation.TabIndex="5">
                            <TextBlock Text="开始使用"
                                       FontSize="{StaticResource Font.Body.Size}"
                                       Foreground="{DynamicResource Brush.White}" />
                        </Button>

                        <Button Margin="0,10,0,0"
                                Height="{StaticResource Metric.Hit.Min}"
                                Padding="10,0"
                                HorizontalAlignment="Center"
                                Style="{StaticResource Button.Ghost}"
                                Command="{Binding CloseCommand}"
                                ToolTip="关闭并退出"
                                AutomationProperties.AutomationId="OnboardingClose"
                                AutomationProperties.Name="关闭并退出"
                                KeyboardNavigation.TabIndex="6">
                            <TextBlock Text="关闭"
                                       FontSize="{StaticResource Font.Meta.Size}"
                                       Foreground="{DynamicResource Brush.Text3}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
