<UserControl x:Class="MiaoWu.App.Views.SchedulesPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:MiaoWu.App.Converters"
             xmlns:res="clr-namespace:MiaoWu.App.Resources"
             mc:Ignorable="d"
             d:DesignWidth="1040"
             d:DesignHeight="760"
             x:Name="Root"
             Focusable="False"
             Background="{DynamicResource Brush.Canvas}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <conv:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibility" />

        <Style x:Key="PageChipItem" TargetType="ListBoxItem">
            <Setter Property="Height" Value="{StaticResource Metric.Schedules.Chip.Height}" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text2}" />
            <Setter Property="FontSize" Value="{StaticResource Font.Body.Size}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Button}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.ComposerButton}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Tab}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.TabBorder}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                                <Setter Property="FontWeight" Value="{StaticResource Font.Weight.Medium}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PageChipList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource PageChipItem}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PageTabItem" TargetType="ListBoxItem">
            <Setter Property="Height" Value="{StaticResource Metric.Segment.Height}" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text2}" />
            <Setter Property="FontSize" Value="{StaticResource Font.Segment.Size}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Button}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.SegmentItem}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Canvas}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.TabBorder}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                                <Setter Property="FontWeight" Value="{StaticResource Font.Weight.SemiBold}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 列表行：整行可点，图标 + 两行正文；选中用 Brush.Sel，悬停用 Brush.Hover。 -->
        <Style x:Key="PageTaskItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Padding" Value="{StaticResource Pad.Schedules.Row}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Button}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Row}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Sel}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PageTaskList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource PageTaskItem}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        </Style>

        <!-- 重复方式 / 执行位置：单选 pill，高度 28，选中用 1px 描边。 -->
        <Style x:Key="OptionPill" TargetType="RadioButton">
            <Setter Property="Height" Value="{StaticResource Metric.Schedules.Chip.Height}" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="{StaticResource Font.Body.Size}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text2}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Button}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.SegmentItem}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Canvas}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.TabBorder}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                                <Setter Property="FontWeight" Value="{StaticResource Font.Weight.SemiBold}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Meta}">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text2}" />
        </Style>

        <Style x:Key="FieldBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="{StaticResource Metric.Field.Height}" />
            <Setter Property="Padding" Value="{StaticResource Pad.Field}" />
        </Style>

        <Style x:Key="FieldBlock" TargetType="TextBox" BasedOn="{StaticResource FieldBox}">
            <Setter Property="Height" Value="{StaticResource Metric.Schedules.TextArea.Height}" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        </Style>

        <Style x:Key="MetaValue" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="{StaticResource Font.List.Size}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text2}" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="{StaticResource Pad.Schedules.Page}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头：时钟 + 标题 + 返回会话 -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Path Style="{StaticResource Icon.Stroke.Exact}"
                      Data="{StaticResource Ico.Clock}"
                      Stroke="{DynamicResource Brush.Text2}" />
                <TextBlock Margin="9,0,0,0"
                           VerticalAlignment="Center"
                           Text="{x:Static res:Strings.ScheduledTasks}"
                           Style="{StaticResource Text.PageTitle}" />
                <TextBlock Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           Text="到点把内容投递到会话；应用关闭时不投递。"
                           Style="{StaticResource Text.Meta}" />
            </StackPanel>
            <Button HorizontalAlignment="Right"
                    Style="{StaticResource Button.Icon}"
                    Command="{Binding CloseCommand}"
                    ToolTip="{x:Static res:Strings.SchedulesCloseTooltip}"
                    AutomationProperties.Name="{x:Static res:Strings.SchedulesCloseTooltip}"
                    KeyboardNavigation.TabIndex="0">
                <Path Style="{StaticResource Icon}"
                      Data="{StaticResource Ico.Close}"
                      Fill="{DynamicResource Brush.Text3}" />
            </Button>
        </Grid>

        <Grid Grid.Row="1"
              MaxWidth="{StaticResource Metric.Schedules.Content.MaxWidth}"
              HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="53*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="47*" />
            </Grid.ColumnDefinitions>

            <!-- 左列：筛选 + 搜索 + 新建 + 任务列表 -->
            <Grid Grid.Column="0" Margin="0,0,18,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ListBox Grid.Row="0"
                         Style="{StaticResource PageChipList}"
                         ItemsSource="{Binding Filters}"
                         SelectedItem="{Binding SelectedFilter, Mode=TwoWay}"
                         AutomationProperties.Name="{x:Static res:Strings.SchedulesFilterAutomation}"
                         KeyboardNavigation.TabIndex="1">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid Grid.Row="1" Margin="0,10,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <TextBox x:Name="SearchBox"
                                 Height="{StaticResource Metric.Field.Height}"
                                 Padding="{StaticResource Pad.Field}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center"
                                 AutomationProperties.Name="{x:Static res:Strings.SchedulesSearchHint}"
                                 KeyboardNavigation.TabIndex="2" />
                        <TextBlock Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Text="{x:Static res:Strings.SchedulesSearchHint}"
                                   Style="{StaticResource Text.Body}"
                                   Foreground="{DynamicResource Brush.Text3}"
                                   Visibility="{Binding SearchText, Converter={StaticResource EmptyStringToVisibility}}" />
                    </Grid>
                    <Button Grid.Column="1"
                            Margin="8,0,0,0"
                            Style="{StaticResource Button.Primary}"
                            Height="{StaticResource Metric.Field.Height}"
                            Command="{Binding NewCommand}"
                            Content="{x:Static res:Strings.SchedulesNew}"
                            AutomationProperties.Name="{x:Static res:Strings.SchedulesNew}"
                            KeyboardNavigation.TabIndex="3" />
                </Grid>

                <Grid Grid.Row="2">
                    <ListBox x:Name="TaskList"
                             Style="{StaticResource PageTaskList}"
                             ItemsSource="{Binding Items}"
                             SelectedItem="{Binding Selected, Mode=TwoWay}"
                             AutomationProperties.Name="{x:Static res:Strings.ScheduledTasks}"
                             KeyboardNavigation.TabIndex="4">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Style="{StaticResource Icon.Stroke.Exact}"
                                          Data="{StaticResource Ico.Clock}"
                                          Stroke="{DynamicResource Brush.Text3}"
                                          VerticalAlignment="Top"
                                          Margin="0,3,0,0" />
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding Title}"
                                                   Style="{StaticResource Text.H3}"
                                                   FontWeight="{StaticResource Font.Weight.Medium}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="0,2,0,0"
                                                   Text="{Binding Subtitle}"
                                                   Style="{StaticResource Text.Meta}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="{Binding EmptyText}"
                               Style="{StaticResource Text.Empty}"
                               MaxWidth="320"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding HasNoItems, Converter={StaticResource BoolToVisibility}}" />
                </Grid>

                <TextBlock Grid.Row="3"
                           Margin="0,8,0,0"
                           Text="{Binding StatusMessage}"
                           Style="{StaticResource Text.Meta}"
                           TextWrapping="Wrap" />
            </Grid>

            <Border Grid.Column="1"
                    Width="1"
                    Background="{DynamicResource Brush.Line2}" />

            <!-- 右列：详情 / 编辑 / 运行记录 -->
                    <Grid Grid.Column="2" Margin="{StaticResource Pad.Schedules.Detail}">
                <TextBlock Text="{Binding EmptyText}"
                           Style="{StaticResource Text.Empty}"
                           MaxWidth="300"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibility}}" />

                <Grid Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 详情头：标题 / 状态 + 动作 -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Editor.HeaderTitle}"
                                       Style="{StaticResource Text.H2}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <Border Style="{StaticResource Chip}"
                                    Margin="8,0,0,0"
                                    Visibility="{Binding Editor.IsExisting, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding Editor.StatusLabel}"
                                           Style="{StaticResource Text.Chip}"
                                           Foreground="{DynamicResource Brush.Text2}" />
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <Button Style="{StaticResource Button.Ghost}"
                                    Command="{Binding ToggleActiveCommand}"
                                    Content="{Binding Editor.ToggleActiveText}"
                                    AutomationProperties.Name="{Binding Editor.ToggleActiveText}"
                                    Visibility="{Binding Editor.IsExisting, Converter={StaticResource BoolToVisibility}}"
                                    KeyboardNavigation.TabIndex="10" />
                            <Button Style="{StaticResource Button.Ghost}"
                                    Margin="4,0,0,0"
                                    Command="{Binding RunNowCommand}"
                                    Content="{x:Static res:Strings.SchedulesRunNow}"
                                    AutomationProperties.Name="{x:Static res:Strings.SchedulesRunNow}"
                                    Visibility="{Binding Editor.IsExisting, Converter={StaticResource BoolToVisibility}}"
                                    KeyboardNavigation.TabIndex="11" />
                            <Button Style="{StaticResource Button.Ghost}"
                                    Margin="4,0,0,0"
                                    Foreground="{DynamicResource Brush.Danger}"
                                    Command="{Binding DeleteCommand}"
                                    Content="{x:Static res:Strings.SchedulesDelete}"
                                    AutomationProperties.Name="{x:Static res:Strings.SchedulesDelete}"
                                    Visibility="{Binding Editor.IsExisting, Converter={StaticResource BoolToVisibility}}"
                                    KeyboardNavigation.TabIndex="12" />
                        </StackPanel>
                    </Grid>

                    <!-- 冲突提示：保留本地修改或重新载入 -->
                    <Border Grid.Row="1"
                            Margin="0,0,0,10"
                            Padding="10,8"
                            CornerRadius="{StaticResource Radius.Button}"
                            Background="{DynamicResource Brush.WarningSoft}"
                            Visibility="{Binding Editor.IsConflict, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{Binding Editor.ConflictText}"
                                       Style="{StaticResource Text.Body}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource Brush.Text}" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Style="{StaticResource Button.Primary}"
                                        Command="{Binding ForceSaveCommand}"
                                        Content="{x:Static res:Strings.SchedulesOverwrite}"
                                        AutomationProperties.Name="{x:Static res:Strings.SchedulesOverwrite}"
                                        KeyboardNavigation.TabIndex="13" />
                                <Button Style="{StaticResource Button.Ghost}"
                                        Margin="8,0,0,0"
                                        Command="{Binding ReloadEditorCommand}"
                                        Content="{x:Static res:Strings.SchedulesReload}"
                                        AutomationProperties.Name="{x:Static res:Strings.SchedulesReload}"
                                        KeyboardNavigation.TabIndex="14" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ListBox Grid.Row="0"
                                 Style="{StaticResource PageChipList}"
                                 ItemsSource="{Binding Tabs}"
                                 SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                                 AutomationProperties.Name="{x:Static res:Strings.SchedulesTabsAutomation}"
                                 KeyboardNavigation.TabIndex="15">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource PageTabItem}" />
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- 规则页 -->
                        <ScrollViewer Grid.Row="1"
                                      Margin="0,10,0,0"
                                      Padding="0,0,12,0"
                                      Style="{StaticResource ScrollViewer.Overlay}"
                                      Visibility="{Binding IsHistoryTab, Converter={StaticResource InverseBoolToVisibility}}">
                            <StackPanel>
                                <StackPanel Margin="{StaticResource Margin.Schedules.Field}"
                                            Visibility="{Binding Editor.IsExisting, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="下次运行" Style="{StaticResource FieldLabel}" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding Editor.NextRunLabel}" Style="{StaticResource MetaValue}" />
                                        <TextBlock Text="上次" Style="{StaticResource FieldLabel}" Margin="16,0,6,0" />
                                        <TextBlock Text="{Binding Editor.LastRunLabel}" Style="{StaticResource MetaValue}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="执行位置" Style="{StaticResource FieldLabel}" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding Editor.SessionLabel}" Style="{StaticResource MetaValue}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="工作区" Style="{StaticResource FieldLabel}" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding Editor.WorkspaceLabel}" Style="{StaticResource MetaValue}" />
                                    </StackPanel>
                                </StackPanel>

                                <Border Height="1" Background="{DynamicResource Brush.Line2}" Margin="0,0,0,12" />

                                <TextBlock Text="名称" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Editor.Title, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FieldBox}"
                                         Margin="{StaticResource Margin.Schedules.Field}"
                                         MaxLength="120"
                                         AutomationProperties.Name="{x:Static res:Strings.SchedulesNameLabel}"
                                         KeyboardNavigation.TabIndex="20" />

                                <TextBlock Text="内容" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Editor.Prompt, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FieldBlock}"
                                         Margin="{StaticResource Margin.Schedules.Field}"
                                         AutomationProperties.Name="{x:Static res:Strings.SchedulesContentLabel}"
                                         KeyboardNavigation.TabIndex="21" />

                                <TextBlock Text="重复" Style="{StaticResource FieldLabel}" />
                                <WrapPanel Margin="0,0,0,12">
                                    <RadioButton Style="{StaticResource OptionPill}"
                                                 GroupName="ScheduleRepeatMode"
                                                 Content="仅一次"
                                                 IsChecked="{Binding Editor.IsOnce, Mode=TwoWay}"
                                                 AutomationProperties.Name="仅一次" />
                                    <RadioButton Style="{StaticResource OptionPill}"
                                                 GroupName="ScheduleRepeatMode"
                                                 Content="每天"
                                                 IsChecked="{Binding Editor.IsDaily, Mode=TwoWay}"
                                                 AutomationProperties.Name="每天" />
                                    <RadioButton Style="{StaticResource OptionPill}"
                                                 GroupName="ScheduleRepeatMode"
                                                 Content="每周"
                                                 IsChecked="{Binding Editor.IsWeekly, Mode=TwoWay}"
                                                 AutomationProperties.Name="每周" />
                                    <RadioButton Style="{StaticResource OptionPill}"
                                                 GroupName="ScheduleRepeatMode"
                                                 Content="每月"
                                                 IsChecked="{Binding Editor.IsMonthly, Mode=TwoWay}"
                                                 AutomationProperties.Name="每月" />
                                    <RadioButton Style="{StaticResource OptionPill}"
                                                 GroupName="ScheduleRepeatMode"
                                                 Content="自定义"
                                                 IsChecked="{Binding Editor.IsCustom, Mode=TwoWay}"
                                                 AutomationProperties.Name="自定义规则" />
                                </WrapPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,0,12"
                                            Visibility="{Binding Editor.IsCustom, Converter={StaticResource InverseBoolToVisibility}}">
                                    <StackPanel>
                                        <TextBlock Text="时间" Style="{StaticResource FieldLabel}" />
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBox Width="44"
                                                     Style="{StaticResource FieldBox}"
                                                     Text="{Binding Editor.HourText, UpdateSourceTrigger=PropertyChanged}"
                                                     MaxLength="2"
                                                     HorizontalContentAlignment="Center"
                                                     AutomationProperties.Name="小时"
                                                     KeyboardNavigation.TabIndex="22" />
                                            <TextBlock Text=":" Margin="4,0" VerticalAlignment="Center" Style="{StaticResource Text.Body}" />
                                            <TextBox Width="44"
                                                     Style="{StaticResource FieldBox}"
                                                     Text="{Binding Editor.MinuteText, UpdateSourceTrigger=PropertyChanged}"
                                                     MaxLength="2"
                                                     HorizontalContentAlignment="Center"
                                                     AutomationProperties.Name="分钟"
                                                     KeyboardNavigation.TabIndex="23" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Margin="16,0,0,0"
                                                Visibility="{Binding Editor.ShowsInterval, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="间隔" Style="{StaticResource FieldLabel}" />
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="每" Margin="0,0,6,0" VerticalAlignment="Center" Style="{StaticResource Text.Body}" />
                                            <TextBox Width="56"
                                                     Style="{StaticResource FieldBox}"
                                                     Text="{Binding Editor.IntervalText, UpdateSourceTrigger=PropertyChanged}"
                                                     MaxLength="3"
                                                     HorizontalContentAlignment="Center"
                                                     AutomationProperties.Name="间隔"
                                                     KeyboardNavigation.TabIndex="24" />
                                            <TextBlock Text="{Binding Editor.IntervalUnit}" Margin="6,0,0,0" VerticalAlignment="Center" Style="{StaticResource Text.Body}" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,12"
                                            Visibility="{Binding Editor.ShowsWeekdays, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="星期" Style="{StaticResource FieldLabel}" />
                                    <WrapPanel>
                                        <CheckBox Content="一" Margin="0,0,10,0" IsChecked="{Binding Editor.Monday, Mode=TwoWay}" />
                                        <CheckBox Content="二" Margin="0,0,10,0" IsChecked="{Binding Editor.Tuesday, Mode=TwoWay}" />
                                        <CheckBox Content="三" Margin="0,0,10,0" IsChecked="{Binding Editor.Wednesday, Mode=TwoWay}" />
                                        <CheckBox Content="四" Margin="0,0,10,0" IsChecked="{Binding Editor.Thursday, Mode=TwoWay}" />
                                        <CheckBox Content="五" Margin="0,0,10,0" IsChecked="{Binding Editor.Friday, Mode=TwoWay}" />
                                        <CheckBox Content="六" Margin="0,0,10,0" IsChecked="{Binding Editor.Saturday, Mode=TwoWay}" />
                                        <CheckBox Content="日" IsChecked="{Binding Editor.Sunday, Mode=TwoWay}" />
                                    </WrapPanel>
                                </StackPanel>

                                <StackPanel Margin="{StaticResource Margin.Schedules.Field}"
                                            Visibility="{Binding Editor.ShowsCustomRule, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="自定义规则" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding Editor.CustomRule, UpdateSourceTrigger=PropertyChanged}"
                                             Height="{StaticResource Metric.Schedules.RuleArea.Height}"
                                             AcceptsReturn="True"
                                             TextWrapping="NoWrap"
                                             FontFamily="{StaticResource Font.Family.Code}"
                                             FontSize="{StaticResource Font.Code.Size}"
                                             VerticalContentAlignment="Top"
                                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             AutomationProperties.Name="自定义规则"
                                             KeyboardNavigation.TabIndex="25" />
                                    <TextBlock Margin="0,4,0,0"
                                               Text="两行：DTSTART:20260101T090000 与 RRULE:FREQ=DAILY"
                                               Style="{StaticResource Text.Meta}" />
                                </StackPanel>

                                <TextBlock Text="{Binding Editor.ErrorMessage}"
                                           Style="{StaticResource Text.Body}"
                                           Foreground="{DynamicResource Brush.Danger}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,8"
                                           Visibility="{Binding Editor.HasError, Converter={StaticResource BoolToVisibility}}" />

                                <StackPanel Margin="{StaticResource Margin.Schedules.Preview}"
                                            Visibility="{Binding Editor.ShowsPreview, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="规则预览" Style="{StaticResource Text.Meta}" />
                                        <TextBlock Text="{Binding Editor.RulePreview}" Style="{StaticResource Text.Meta}" Margin="8,0,0,0" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="下次预览" Style="{StaticResource Text.Meta}" />
                                        <TextBlock Text="{Binding Editor.NextRunPreview}" Style="{StaticResource Text.Meta}" Margin="8,0,0,0" />
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Text="执行位置" Style="{StaticResource FieldLabel}" Margin="0,16,0,4" />
                                <WrapPanel Margin="0,0,0,4">
                                    <RadioButton Style="{StaticResource OptionPill}"
                                                 GroupName="ScheduleTarget"
                                                 Content="新建会话并复用"
                                                 IsChecked="{Binding Editor.IsTargetNewOnce, Mode=TwoWay}"
                                                 AutomationProperties.Name="新建会话并复用" />
                                    <RadioButton Style="{StaticResource OptionPill}"
                                                 GroupName="ScheduleTarget"
                                                 Content="当前会话"
                                                 IsChecked="{Binding Editor.IsTargetThisSession, Mode=TwoWay}"
                                                 AutomationProperties.Name="当前会话" />
                                    <RadioButton Style="{StaticResource OptionPill}"
                                                 GroupName="ScheduleTarget"
                                                 Content="每次新建会话"
                                                 IsChecked="{Binding Editor.IsTargetNew, Mode=TwoWay}"
                                                 AutomationProperties.Name="每次新建会话" />
                                </WrapPanel>
                                <TextBlock Text="{Binding Editor.SessionLabel}" Style="{StaticResource Text.Meta}" />
                            </StackPanel>
                        </ScrollViewer>

                        <!-- 运行记录页 -->
                        <ScrollViewer Grid.Row="1"
                                      Margin="0,10,0,0"
                                      Padding="0,0,12,0"
                                      Style="{StaticResource ScrollViewer.Overlay}"
                                      Visibility="{Binding IsHistoryTab, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="运行记录只证明消息已经排进会话，不代表模型执行成功；删除任务不会撤回已排进会话的消息。"
                                           Style="{StaticResource Text.Meta}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,10" />
                                <ItemsControl ItemsSource="{Binding Editor.History}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="0,8,0,8"
                                                    BorderBrush="{DynamicResource Brush.Line2}"
                                                    BorderThickness="0,0,0,1">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding TimeText}" Style="{StaticResource Text.Meta}" />
                                                        <TextBlock Text="{Binding KindText}" Style="{StaticResource Text.Meta}" Margin="10,0,0,0" />
                                                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Meta}" Margin="10,0,0,0" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Prompt}"
                                                               Style="{StaticResource Text.Body}"
                                                               TextWrapping="Wrap"
                                                               Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding Editor.HistoryEmptyText}"
                                           Style="{StaticResource Text.Empty}"
                                           Margin="0,24,0,0"
                                           Visibility="{Binding Editor.HasHistory, Converter={StaticResource InverseBoolToVisibility}}" />
                            </StackPanel>
                        </ScrollViewer>

                        <!-- 底栏：放弃 / 保存；运行记录页没有可保存的字段，整行收起。 -->
                        <Border Grid.Row="2"
                                BorderBrush="{DynamicResource Brush.Line2}"
                                BorderThickness="0,1,0,0"
                                Padding="0,10,0,0"
                                Visibility="{Binding IsHistoryTab, Converter={StaticResource InverseBoolToVisibility}}">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right">
                                <Button Style="{StaticResource Button.Ghost}"
                                        Command="{Binding DiscardCommand}"
                                        Content="{x:Static res:Strings.SchedulesDiscard}"
                                        AutomationProperties.Name="{x:Static res:Strings.SchedulesDiscard}"
                                        KeyboardNavigation.TabIndex="30" />
                                <Button Style="{StaticResource Button.Primary}"
                                        Margin="8,0,0,0"
                                        Height="{StaticResource Metric.Field.Height}"
                                        Command="{Binding SaveCommand}"
                                        IsEnabled="{Binding Editor.CanSave}"
                                        Content="{x:Static res:Strings.SchedulesSave}"
                                        AutomationProperties.Name="{x:Static res:Strings.SchedulesSave}"
                                        KeyboardNavigation.TabIndex="31" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
