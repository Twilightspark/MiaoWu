<UserControl x:Class="MiaoWu.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MiaoWu.App.ViewModels"
             xmlns:res="clr-namespace:MiaoWu.App.Resources"
             xmlns:conv="clr-namespace:MiaoWu.App.Converters"
             mc:Ignorable="d"
             d:DesignWidth="1440"
             d:DesignHeight="900"
             x:Name="Root"
             Focusable="False"
             Background="Transparent">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />

        <Style x:Key="SettingsNavItem" TargetType="ListBoxItem">
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="NavBorder"
                                Background="Transparent"
                                CornerRadius="{StaticResource Radius.Row}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource Brush.Sel}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsSelected" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource Brush.Hover}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Meta}">
            <Setter Property="Margin" Value="0,8,0,4" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text2}" />
        </Style>

        <Style x:Key="SettingsSection" TargetType="TextBlock" BasedOn="{StaticResource Text.H3}">
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>

        <!-- 表单输入：与协议下拉同高（Metric.Field.Height），不要一个 36 一个 29。 -->
        <!-- TextBox 模板与 TextBoxView 各应用一次 Padding，所以用 4,4：
             文字左缩进与下拉的 10+1 对齐，垂直方向也留得住 18px 行高。 -->
        <Style x:Key="SettingsField" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="{StaticResource Metric.Field.Height}" />
            <Setter Property="Padding" Value="{StaticResource Pad.Field}" />
        </Style>

        <!-- API Key 用密码框；模板与 TextBox 保持一致，焦点环也用 Thickness.Focus。 -->
        <Style x:Key="SettingsPasswordField" TargetType="PasswordBox">
            <Setter Property="Height" Value="{StaticResource Metric.Field.Height}" />
            <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
            <Setter Property="FontSize" Value="{StaticResource Font.Body.Size}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            <Setter Property="Background" Value="{DynamicResource Brush.Canvas}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line3}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="{StaticResource Pad.Field}" />
            <Setter Property="CaretBrush" Value="{DynamicResource Brush.Text}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Radius.Button}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="{StaticResource Thickness.Focus}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="{StaticResource Opacity.Disabled}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModelCardLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Meta}">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text2}" />
        </Style>

        <!-- 分段选项：外观 / 语言 / 关闭共用，选中态用 1px 描边而不是投影。 -->
        <Style x:Key="SettingsSegmentItem" TargetType="ListBoxItem">
            <Setter Property="Height" Value="{StaticResource Metric.Segment.Height}" />
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="Padding" Value="{StaticResource Pad.Segment}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text2}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Button}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.SegmentItem}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Canvas}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.TabBorder}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                                <Setter Property="FontWeight" Value="{StaticResource Font.Weight.SemiBold}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="{StaticResource Opacity.Disabled}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsSegmentList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource SettingsSegmentItem}" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 表单顶部的两个标签切换按钮。 -->
        <Style x:Key="SettingsTabItem" TargetType="ListBoxItem" BasedOn="{StaticResource SettingsSegmentItem}">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="112" />
            <Setter Property="Padding" Value="14,0" />
        </Style>

        <Style x:Key="SettingsTabList" TargetType="ListBox" BasedOn="{StaticResource SettingsSegmentList}">
            <Setter Property="ItemContainerStyle" Value="{StaticResource SettingsTabItem}" />
        </Style>

        <!-- 已配置供应商：整行卡片按钮，编辑态用 1px 主题色描边。 -->
        <Style x:Key="ProviderCardButton" TargetType="Button" BasedOn="{StaticResource Button.Base}">
            <Setter Property="Height" Value="46" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{DynamicResource Brush.Canvas}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line2}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Radius.Card}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Line3}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Sel}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Sel}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            </DataTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="{StaticResource Opacity.Disabled}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 添加供应商 / 添加模型：与卡片同尺寸同圆角，边框为虚线。 -->
        <Style x:Key="ProviderAddButton" TargetType="Button" BasedOn="{StaticResource Button.Base}">
            <Setter Property="Height" Value="46" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bd"
                                    Background="Transparent"
                                    CornerRadius="{StaticResource Radius.Card}"
                                    SnapsToDevicePixels="True" />
                            <Rectangle x:Name="Ring"
                                       Margin="0.5"
                                       RadiusX="7.5"
                                       RadiusY="7.5"
                                       Stroke="{DynamicResource Brush.Line3}"
                                       StrokeThickness="1"
                                       StrokeDashArray="4 3"
                                       SnapsToDevicePixels="True" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Brush.Accent}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Sel}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="{StaticResource Opacity.Disabled}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 第三方供应商预设：3 列卡片，选中态与菜单选中一致。 -->
        <Style x:Key="PresetChoiceItem" TargetType="ListBoxItem">
            <Setter Property="Height" Value="48" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text2}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Card}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="{DynamicResource Brush.Canvas}"
                                BorderBrush="{DynamicResource Brush.Line2}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Card}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Line3}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Sel}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="{StaticResource Opacity.Disabled}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PresetChoiceList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource PresetChoiceItem}" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 协议下拉：用菜单卡片而不是系统 Aero 下拉。 -->
        <Style x:Key="SettingsComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
            <Setter Property="FontSize" Value="{StaticResource Font.List.Size}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text2}" />
            <Setter Property="Height" Value="{StaticResource Metric.Menu.RowHeight}" />
            <Setter Property="Padding" Value="{StaticResource Pad.MenuItem}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd"
                                Height="{StaticResource Metric.Menu.RowHeight}"
                                Margin="{StaticResource Margin.MenuItem}"
                                Background="Transparent"
                                CornerRadius="{StaticResource Radius.MenuItem}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Sel}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsComboBox" TargetType="ComboBox">
            <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
            <Setter Property="FontSize" Value="{StaticResource Font.Body.Size}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            <Setter Property="Height" Value="{StaticResource Metric.Field.Height}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource SettingsComboBoxItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Bd"
                                    Background="{DynamicResource Brush.Canvas}"
                                    BorderBrush="{DynamicResource Brush.Line3}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource Radius.Button}"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <ContentPresenter Margin="10,0,32,0"
                                                      VerticalAlignment="Center"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                      IsHitTestVisible="False"
                                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                                    <ToggleButton x:Name="ToggleButton"
                                                  Focusable="False"
                                                  IsTabStop="False"
                                                  ClickMode="Press"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <Path Margin="0,0,10,0"
                                          HorizontalAlignment="Right"
                                          Style="{StaticResource Icon}"
                                          Data="{StaticResource Ico.ChevronDown}"
                                          Fill="{DynamicResource Brush.Text3}" />
                                </Grid>
                            </Border>

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                                   PopupAnimation="{DynamicResource {x:Static SystemParameters.MenuPopupAnimationKey}}"
                                   StaysOpen="False">
                                <Border Background="Transparent"
                                        BorderBrush="{DynamicResource Brush.MenuHairline}"
                                        BorderThickness="{StaticResource Thickness.MenuHairline}"
                                        CornerRadius="{StaticResource Radius.MenuHairline}"
                                        SnapsToDevicePixels="False"
                                        UseLayoutRounding="False">
                                    <Border Style="{StaticResource Menu.Surface}">
                                        <ScrollViewer MaxHeight="240"
                                                      Focusable="False"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                                        </ScrollViewer>
                                    </Border>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="{StaticResource Opacity.Disabled}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Border Background="{DynamicResource Brush.Scrim}" MouseLeftButtonDown="OnScrimClick" />

        <Border Width="960"
                Height="620"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource Brush.Canvas}"
                BorderBrush="{DynamicResource Brush.Line2}"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius.Notification}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="44" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="18,0,10,0">
                    <TextBlock VerticalAlignment="Center"
                               Text="设置"
                               Style="{StaticResource Text.Section}" />
                    <Button HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Style="{StaticResource Button.Icon}"
                            Command="{Binding CloseCommand}"
                            AutomationProperties.Name="关闭设置">
                        <Path Style="{StaticResource Icon}"
                              Data="{StaticResource Ico.Close}"
                              Fill="{DynamicResource Brush.Text3}" />
                    </Button>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ListBox Grid.Column="0"
                             Margin="10,0,10,16"
                             ItemsSource="{Binding Pages}"
                             SelectedItem="{Binding SelectedPage, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource SettingsNavItem}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="设置导航">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.ListRow}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Column="1" Background="{DynamicResource Brush.Line2}" />

                    <ScrollViewer x:Name="SettingsScroller"
                                  Grid.Column="2"
                                  Padding="18,0,18,18"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                            <!-- 通用 -->
                            <StackPanel Visibility="{Binding IsGeneralPage, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="通用" Style="{StaticResource Text.Section}" Margin="0,14,0,4" />

                                <TextBlock Text="外观" Style="{StaticResource SettingsSection}" />
                                <Border HorizontalAlignment="Left"
                                        Padding="1"
                                        Background="{DynamicResource Brush.Sel}"
                                        CornerRadius="{StaticResource Radius.Segment}">
                                    <ListBox Style="{StaticResource SettingsSegmentList}"
                                             ItemsSource="{Binding ThemeOptions}"
                                             SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                                             AutomationProperties.Name="外观">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="{StaticResource Font.Segment.Size}"
                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                           VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>

                                <TextBlock Text="语言" Style="{StaticResource SettingsSection}" />
                                <Border HorizontalAlignment="Left"
                                        Padding="1"
                                        Background="{DynamicResource Brush.Sel}"
                                        CornerRadius="{StaticResource Radius.Segment}">
                                    <ListBox Style="{StaticResource SettingsSegmentList}"
                                             ItemsSource="{Binding LanguageOptions}"
                                             SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                                             AutomationProperties.Name="语言">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="{StaticResource Font.Segment.Size}"
                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                           VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>

                                <TextBlock Text="关闭" Style="{StaticResource SettingsSection}" />
                                <Border HorizontalAlignment="Left"
                                        Padding="1"
                                        Background="{DynamicResource Brush.Sel}"
                                        CornerRadius="{StaticResource Radius.Segment}">
                                    <ListBox Style="{StaticResource SettingsSegmentList}"
                                             ItemsSource="{Binding CloseActionOptions}"
                                             SelectedItem="{Binding SelectedCloseAction, Mode=TwoWay}"
                                             AutomationProperties.Name="关闭窗口时的行为">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="{StaticResource Font.Segment.Size}"
                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                           VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>

                                <TextBlock Margin="0,12,0,0"
                                           Text="{Binding StatusText}"
                                           Style="{StaticResource Text.Meta}"
                                           Foreground="{DynamicResource Brush.Danger}"
                                           Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>

                            <!-- 模型 -->
                            <StackPanel Visibility="{Binding IsModelsPage, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="模型" Style="{StaticResource Text.Section}" Margin="0,14,0,8" />

                                <ItemsControl ItemsSource="{Binding ProviderEditors}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource ProviderCardButton}"
                                                    Command="{Binding DataContext.EditProviderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    AutomationProperties.Name="{Binding DisplayName}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   Style="{StaticResource Text.ListRow}"
                                                                   FontWeight="{StaticResource Font.Weight.Medium}"
                                                                   Foreground="{DynamicResource Brush.Text}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Margin="0,2,0,0"
                                                                   Text="{Binding BaseUrl}"
                                                                   Style="{StaticResource Text.Meta}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1"
                                                               Margin="10,0,0,0"
                                                               VerticalAlignment="Center"
                                                               Text="{Binding ModelCountText}"
                                                               Style="{StaticResource Text.Meta}" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button Style="{StaticResource ProviderAddButton}"
                                        Command="{Binding AddProviderCommand}"
                                        AutomationProperties.Name="添加供应商">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Style="{StaticResource Icon}"
                                              Data="{StaticResource Ico.Plus}"
                                              Fill="{DynamicResource Brush.Text3}" />
                                        <TextBlock Margin="6,0,0,0"
                                                   Text="添加供应商"
                                                   Style="{StaticResource Text.ListRow}"
                                                   Foreground="{DynamicResource Brush.Text2}" />
                                    </StackPanel>
                                </Button>

                                <TextBlock Margin="0,10,0,0"
                                           Text="{Binding ProviderStatus}"
                                           Style="{StaticResource Text.Meta}"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding HasProviderStatus, Converter={StaticResource BoolToVisibility}}" />

                                <StackPanel x:Name="ProviderFormPanel"
                                            Margin="0,14,0,0"
                                            Visibility="{Binding HasProviderForm, Converter={StaticResource BoolToVisibility}}">
                                    <Border Padding="0,14,0,0"
                                            BorderBrush="{DynamicResource Brush.Line2}"
                                            BorderThickness="0,1,0,0">
                                        <StackPanel>
                                            <StackPanel Visibility="{Binding IsAddingProvider, Converter={StaticResource BoolToVisibility}}">
                                                <Border HorizontalAlignment="Left"
                                                        Padding="1"
                                                        Background="{DynamicResource Brush.Sel}"
                                                        CornerRadius="{StaticResource Radius.Segment}">
                                                    <ListBox Style="{StaticResource SettingsTabList}"
                                                             ItemsSource="{Binding ProviderFormModeOptions}"
                                                             SelectedItem="{Binding SelectedProviderFormMode, Mode=TwoWay}"
                                                             AutomationProperties.Name="供应商类型">
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Title}"
                                                                           FontSize="{StaticResource Font.Segment.Size}"
                                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                                           VerticalAlignment="Center" />
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                </Border>
                                            </StackPanel>

                                            <TextBlock Text="{Binding ProviderFormTitle}"
                                                       Style="{StaticResource Text.H3}"
                                                       Margin="0,2,0,0"
                                                       Visibility="{Binding IsAddingProvider, Converter={StaticResource InverseBoolToVisibility}}" />

                                            <!-- 第三方供应商：选择预设 + API Key -->
                                            <StackPanel Visibility="{Binding IsThirdPartyMode, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="供应商" Style="{StaticResource SettingsLabel}" />
                                                <ListBox Style="{StaticResource PresetChoiceList}"
                                                         ItemsSource="{Binding PresetChoices}"
                                                         SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                                                         AutomationProperties.Name="第三方供应商">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding DisplayName}"
                                                                           Style="{StaticResource Text.ListRow}"
                                                                           Foreground="{DynamicResource Brush.Text}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Margin="0,2,0,0"
                                                                           Text="{Binding BaseUrl}"
                                                                           Style="{StaticResource Text.Meta}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>

                                                <TextBlock Text="API Key" Style="{StaticResource SettingsLabel}" />
                                                <PasswordBox x:Name="ThirdPartyKeyBox"
                                                             Style="{StaticResource SettingsPasswordField}"
                                                             PasswordChanged="OnThirdPartyKeyChanged"
                                                             AutomationProperties.Name="第三方供应商 API Key" />
                                                <TextBlock Margin="0,4,0,0"
                                                           Text="{Binding ThirdPartyKeyStatus}"
                                                           Style="{StaticResource Text.Meta}" />
                                            </StackPanel>

                                            <!-- 自定义供应商：完整字段 + 模型卡片 -->
                                            <StackPanel Visibility="{Binding IsCustomMode, Converter={StaticResource BoolToVisibility}}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,6,0">
                                                        <TextBlock Text="名称" Style="{StaticResource SettingsLabel}" />
                                                        <TextBox Style="{StaticResource SettingsField}"
                                                                 Text="{Binding DraftProvider.DisplayName, UpdateSourceTrigger=PropertyChanged}"
                                                                 AutomationProperties.Name="供应商名称" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="6,0,0,0">
                                                        <TextBlock Text="标识（Provider ID）" Style="{StaticResource SettingsLabel}" />
                                                        <TextBox Style="{StaticResource SettingsField}"
                                                                 Text="{Binding DraftProvider.Id, UpdateSourceTrigger=PropertyChanged}"
                                                                 AutomationProperties.Name="供应商标识" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,6,0">
                                                        <TextBlock Text="协议" Style="{StaticResource SettingsLabel}" />
                                                        <ComboBox Style="{StaticResource SettingsComboBox}"
                                                                  ItemsSource="{Binding DataContext.ApiOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                  SelectedItem="{Binding DraftProvider.Api, Mode=TwoWay}"
                                                                  AutomationProperties.Name="协议" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="6,0,0,0">
                                                        <TextBlock Text="Base URL" Style="{StaticResource SettingsLabel}" />
                                                        <TextBox Style="{StaticResource SettingsField}"
                                                                 Text="{Binding DraftProvider.BaseUrl, UpdateSourceTrigger=PropertyChanged}"
                                                                 AutomationProperties.Name="Base URL" />
                                                    </StackPanel>
                                                </Grid>

                                                <TextBlock Text="API Key" Style="{StaticResource SettingsLabel}" />
                                                <PasswordBox x:Name="CustomKeyBox"
                                                             Style="{StaticResource SettingsPasswordField}"
                                                             PasswordChanged="OnCustomKeyChanged"
                                                             AutomationProperties.Name="API Key" />
                                                <TextBlock Margin="0,4,0,0"
                                                           Text="{Binding DraftProvider.KeyStatus}"
                                                           Style="{StaticResource Text.Meta}" />

                                                <Grid Margin="0,20,0,6">
                                                    <TextBlock Text="模型"
                                                               Style="{StaticResource SettingsSection}"
                                                               Margin="0"
                                                               VerticalAlignment="Center" />
                                                    <Button HorizontalAlignment="Right"
                                                            VerticalAlignment="Center"
                                                            Padding="10,0"
                                                            Content="自动获取"
                                                            Style="{StaticResource Button.Ghost}"
                                                            Command="{Binding FetchModelsCommand}"
                                                            IsEnabled="{Binding CanFetchModels}"
                                                            AutomationProperties.Name="自动获取模型" />
                                                </Grid>
                                                <TextBlock Margin="0,0,0,6"
                                                           Text="{Binding ModelFetchStatus}"
                                                           Style="{StaticResource Text.Meta}"
                                                           TextWrapping="Wrap"
                                                           Visibility="{Binding HasModelFetchStatus, Converter={StaticResource BoolToVisibility}}" />

                                                <ItemsControl ItemsSource="{Binding DraftProvider.Models}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Margin="0,0,0,8"
                                                                    Padding="10"
                                                                    Background="{DynamicResource Brush.Canvas}"
                                                                    BorderBrush="{DynamicResource Brush.Line2}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="{StaticResource Radius.Card}">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                                        <TextBlock Text="模型 ID" Style="{StaticResource ModelCardLabel}" />
                                                                        <TextBox Style="{StaticResource SettingsField}"
                                                                                 Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}"
                                                                                 AutomationProperties.Name="模型 ID" />
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="1" Margin="8,0,8,0">
                                                                        <TextBlock Text="显示名称" Style="{StaticResource ModelCardLabel}" />
                                                                        <TextBox Style="{StaticResource SettingsField}"
                                                                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                                                 AutomationProperties.Name="模型显示名称" />
                                                                    </StackPanel>
                                                                    <Button Grid.Column="2"
                                                                            Width="28"
                                                                            Height="28"
                                                                            VerticalAlignment="Bottom"
                                                                            Style="{StaticResource Button.Icon}"
                                                                            Command="{Binding DataContext.DraftProvider.RemoveModelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                            CommandParameter="{Binding}"
                                                                            ToolTip="删除模型"
                                                                            AutomationProperties.Name="删除模型">
                                                                        <Path Style="{StaticResource Icon}"
                                                                              Data="{StaticResource Ico.Trash}"
                                                                              Fill="{DynamicResource Brush.Danger}" />
                                                                    </Button>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <Button Height="40"
                                                        Style="{StaticResource ProviderAddButton}"
                                                        Command="{Binding DraftProvider.AddModelCommand}"
                                                        AutomationProperties.Name="添加模型">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Path Style="{StaticResource Icon}"
                                                              Data="{StaticResource Ico.Plus}"
                                                              Fill="{DynamicResource Brush.Text3}" />
                                                        <TextBlock Margin="6,0,0,0"
                                                                   Text="添加模型"
                                                                   Style="{StaticResource Text.ListRow}"
                                                                   Foreground="{DynamicResource Brush.Text2}" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>

                                            <TextBlock Margin="0,12,0,0"
                                                       Text="{Binding ProviderFormStatus}"
                                                       Style="{StaticResource Text.Meta}"
                                                       Foreground="{DynamicResource Brush.Accent}"
                                                       TextWrapping="Wrap"
                                                       Visibility="{Binding HasProviderFormStatus, Converter={StaticResource BoolToVisibility}}" />

                                            <Border Margin="0,12,0,0"
                                                    Padding="0,10,0,0"
                                                    BorderBrush="{DynamicResource Brush.Line2}"
                                                    BorderThickness="0,1,0,0">
                                                <Grid>
                                                    <Button HorizontalAlignment="Left"
                                                            Content="移除供应商"
                                                            Style="{StaticResource Button.Ghost}"
                                                            Foreground="{DynamicResource Brush.Danger}"
                                                            Command="{Binding RemoveProviderCommand}"
                                                            Visibility="{Binding CanRemoveProvider, Converter={StaticResource BoolToVisibility}}"
                                                            AutomationProperties.Name="移除供应商" />
                                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                                        <Button Content="测试连接"
                                                                Style="{StaticResource Button.Ghost}"
                                                                Command="{Binding TestProviderCommand}"
                                                                IsEnabled="{Binding IsNotTesting}"
                                                                AutomationProperties.Name="测试连接" />
                                                        <Button Margin="6,0,0,0"
                                                                Content="取消"
                                                                Style="{StaticResource Button.Ghost}"
                                                                Command="{Binding CancelProviderCommand}"
                                                                AutomationProperties.Name="取消编辑" />
                                                        <Button Margin="6,0,0,0"
                                                                Content="保存"
                                                                Style="{StaticResource Button.Primary}"
                                                                Command="{Binding SaveProviderCommand}"
                                                                IsEnabled="{Binding IsNotTesting}"
                                                                AutomationProperties.Name="保存供应商" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <!-- 关于 -->
                            <Grid MinHeight="440" Visibility="{Binding IsAboutPage, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Image Width="84"
                                           Height="84"
                                           HorizontalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           SnapsToDevicePixels="True"
                                           Source="pack://application:,,,/MiaoWu;component/Assets/Branding/MiaoWu.png" />
                                    <TextBlock Margin="0,18,0,0"
                                               HorizontalAlignment="Center"
                                               Text="{x:Static res:Strings.AppName}"
                                               Style="{StaticResource Text.Brand}" />
                                    <TextBlock Margin="0,6,0,0"
                                               HorizontalAlignment="Center"
                                               Text="{Binding AboutLine}"
                                               Style="{StaticResource Text.Body}"
                                               Foreground="{DynamicResource Brush.Text2}"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap" />
                                    <Button Margin="0,24,0,0"
                                            MinWidth="120"
                                            HorizontalAlignment="Center"
                                            Content="检查更新"
                                            Style="{StaticResource Button.Primary}"
                                            Foreground="{DynamicResource Brush.White}"
                                            Command="{Binding CheckUpdateCommand}"
                                            AutomationProperties.Name="检查更新" />
                                    <TextBlock Margin="0,8,0,0"
                                               HorizontalAlignment="Center"
                                               Text="{Binding UpdateStatus}"
                                               Style="{StaticResource Text.Meta}"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding HasUpdateStatus, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
