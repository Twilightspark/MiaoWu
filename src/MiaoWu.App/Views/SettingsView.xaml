<UserControl x:Class="MiaoWu.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MiaoWu.App.ViewModels"
             xmlns:res="clr-namespace:MiaoWu.App.Resources"
             mc:Ignorable="d"
             d:DesignWidth="1440"
             d:DesignHeight="900"
             x:Name="Root"
             Focusable="False"
             Background="Transparent">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="SettingsNavItem" TargetType="ListBoxItem">
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="NavBorder"
                                Background="Transparent"
                                CornerRadius="{StaticResource Radius.Row}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource Brush.Sel}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsSelected" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource Brush.Hover}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Meta}">
            <Setter Property="Margin" Value="0,8,0,4" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text2}" />
        </Style>

        <Style x:Key="SettingsSection" TargetType="TextBlock" BasedOn="{StaticResource Text.H3}">
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Border Background="{DynamicResource Brush.Scrim}" MouseLeftButtonDown="OnScrimClick" />

        <Border Width="960"
                Height="620"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource Brush.Canvas}"
                BorderBrush="{DynamicResource Brush.Line2}"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius.Notification}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="44" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="18,0,10,0">
                    <TextBlock VerticalAlignment="Center"
                               Text="设置"
                               Style="{StaticResource Text.Section}" />
                    <Button HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Style="{StaticResource Button.Icon}"
                            Command="{Binding CloseCommand}"
                            AutomationProperties.Name="关闭设置">
                        <Path Style="{StaticResource Icon}"
                              Data="{StaticResource Ico.Close}"
                              Fill="{DynamicResource Brush.Text3}" />
                    </Button>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ListBox Grid.Column="0"
                             Margin="10,0,10,16"
                             ItemsSource="{Binding Pages}"
                             SelectedItem="{Binding SelectedPage, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource SettingsNavItem}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.ListRow}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Column="1" Background="{DynamicResource Brush.Line2}" />

                    <ScrollViewer Grid.Column="2"
                                  Padding="18,0,18,18"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                            <!-- 通用 -->
                            <StackPanel Visibility="{Binding IsGeneralPage, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="通用" Style="{StaticResource Text.Section}" Margin="0,14,0,4" />

                                <TextBlock Text="启动与后台" Style="{StaticResource SettingsSection}" />
                                <CheckBox Content="关闭窗口后继续在托盘运行" IsChecked="{Binding KeepRunningInTray}" />
                                <CheckBox Margin="0,6,0,0" Content="启动时隐藏主窗口，只显示托盘" IsChecked="{Binding StartMinimized}" />
                                <CheckBox Margin="0,6,0,0" Content="启动时检查更新" IsChecked="{Binding CheckUpdatesOnStartup}" />
                                <CheckBox Margin="0,6,0,0" Content="出错时在设置中显示日志入口" IsChecked="{Binding ShowLogOnError}" />

                                <TextBlock Text="系统提示" Style="{StaticResource SettingsSection}" />
                                <TextBox Height="96"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         Text="{Binding SystemPrompt, UpdateSourceTrigger=LostFocus}" />
                                <TextBlock Margin="0,4,0,0"
                                           Text="系统提示决定助手的默认语气与边界；修改后下一条消息生效。"
                                           Style="{StaticResource Text.Meta}" />

                                <TextBlock Text="网络代理" Style="{StaticResource SettingsSection}" />
                                <ComboBox Width="220"
                                          HorizontalAlignment="Left"
                                          SelectedValue="{Binding ProxyMode, Mode=TwoWay}"
                                          SelectedValuePath="Tag">
                                    <ComboBoxItem Content="跟随系统" Tag="system" />
                                    <ComboBoxItem Content="直连（不使用代理）" Tag="direct" />
                                    <ComboBoxItem Content="手动" Tag="manual" />
                                </ComboBox>
                                <TextBox Margin="0,6,0,0"
                                         Width="360"
                                         HorizontalAlignment="Left"
                                         Text="{Binding ProxyUrl, UpdateSourceTrigger=LostFocus}"
                                         ToolTip="例如 http://127.0.0.1:7890" />
                                <TextBlock Margin="0,4,0,0"
                                           Text="手动代理修改后下一条消息生效；正在生成的回答不受影响。"
                                           Style="{StaticResource Text.Meta}" />

                                <TextBlock Margin="0,12,0,0"
                                           Text="{Binding StatusText}"
                                           Style="{StaticResource Text.Meta}"
                                           Foreground="{DynamicResource Brush.Accent}"
                                           Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>

                            <!-- Provider -->
                            <Grid Visibility="{Binding IsProvidersPage, Converter={StaticResource BoolToVisibility}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="模型与 Provider" Style="{StaticResource Text.Section}" Margin="0,14,0,8" />

                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <ListBox Height="360"
                                                 ItemsSource="{Binding ProviderEditors}"
                                                 SelectedItem="{Binding SelectedProvider, Mode=TwoWay}"
                                                 BorderBrush="{DynamicResource Brush.Line2}"
                                                 BorderThickness="1"
                                                 Background="Transparent">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="2">
                                                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource Text.ListRow}" />
                                                        <TextBlock Text="{Binding BaseUrl}" Style="{StaticResource Text.Meta}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                                            <Button Content="添加" Style="{StaticResource Button.Ghost}" Command="{Binding AddProviderCommand}" />
                                            <Button Margin="6,0,0,0"
                                                    Content="移除"
                                                    Style="{StaticResource Button.Ghost}"
                                                    Command="{Binding RemoveProviderCommand}"
                                                    CommandParameter="{Binding SelectedProvider}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <ScrollViewer Grid.Column="1" DataContext="{Binding SelectedProvider}" VerticalScrollBarVisibility="Auto">
                                        <StackPanel>
                                            <TextBlock Text="名称" Style="{StaticResource SettingsLabel}" />
                                            <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Text="Provider ID" Style="{StaticResource SettingsLabel}" />
                                            <TextBox Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Text="协议" Style="{StaticResource SettingsLabel}" />
                                            <ComboBox Width="220"
                                                      HorizontalAlignment="Left"
                                                      ItemsSource="{Binding DataContext.ApiOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      SelectedItem="{Binding Api, Mode=TwoWay}" />
                                            <TextBlock Text="Base URL" Style="{StaticResource SettingsLabel}" />
                                            <TextBox Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Text="API Key" Style="{StaticResource SettingsLabel}" />
                                            <TextBox Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Text="{Binding KeyStatus}" Style="{StaticResource Text.Meta}" />

                                            <TextBlock Text="模型" Style="{StaticResource SettingsSection}" />
                                            <ListBox Height="92"
                                                     ItemsSource="{Binding Models}"
                                                     SelectedItem="{Binding SelectedModel, Mode=TwoWay}"
                                                     BorderBrush="{DynamicResource Brush.Line2}"
                                                     BorderThickness="1"
                                                     Background="Transparent">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Id}" Style="{StaticResource Text.Code}" />
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                                <Button Content="添加模型" Style="{StaticResource Button.Ghost}" Command="{Binding AddModelCommand}" />
                                                <Button Margin="6,0,0,0"
                                                        Content="移除模型"
                                                        Style="{StaticResource Button.Ghost}"
                                                        Command="{Binding RemoveModelCommand}"
                                                        CommandParameter="{Binding SelectedModel}" />
                                            </StackPanel>

                                            <Grid Margin="0,8,0,0" DataContext="{Binding SelectedModel}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                    <TextBlock Text="模型 ID" Style="{StaticResource SettingsLabel}" />
                                                    <TextBox Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBlock Text="显示名" Style="{StaticResource SettingsLabel}" />
                                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                    <TextBlock Text="上下文窗口" Style="{StaticResource SettingsLabel}" />
                                                    <TextBox Text="{Binding ContextWindow}" />
                                                    <TextBlock Text="最大输出" Style="{StaticResource SettingsLabel}" />
                                                    <TextBox Text="{Binding MaxOutputTokens}" />
                                                </StackPanel>
                                            </Grid>
                                            <Grid Margin="0,8,0,0" DataContext="{Binding SelectedModel}">
                                                <CheckBox Content="支持图片" IsChecked="{Binding SupportsImages}" />
                                                <CheckBox Margin="120,0,0,0" Content="支持推理" IsChecked="{Binding SupportsReasoning}" />
                                            </Grid>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>

                                <StackPanel Grid.Row="0" HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,14,0,8">
                                    <Button Content="测试连接" Style="{StaticResource Button.Ghost}" Command="{Binding TestProviderCommand}" />
                                    <Button Margin="8,0,0,0" Content="保存全部" Style="{StaticResource Button.Primary}" Command="{Binding SaveProvidersCommand}" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Visibility="{Binding IsProvidersPage, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding ProviderStatus}"
                                           Style="{StaticResource Text.Meta}"
                                           TextWrapping="Wrap"
                                           Margin="0,380,0,0" />
                                <TextBlock Margin="0,6,0,0"
                                           Text="{Binding TestStatus}"
                                           Style="{StaticResource Text.Meta}"
                                           Foreground="{DynamicResource Brush.Accent}"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding HasTestStatus, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>

                            <!-- 工具 -->
                            <StackPanel Visibility="{Binding IsToolsPage, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="工具与权限" Style="{StaticResource Text.Section}" Margin="0,14,0,4" />
                                <CheckBox Content="允许模型调用内置工具（读文件、搜索、写文件、执行命令）"
                                          IsChecked="{Binding ToolsEnabled}" />
                                <TextBlock Margin="0,4,0,0"
                                           Text="关闭后模型只回答问题，不读取或修改工作区。写文件与命令始终需要逐次审批。"
                                           Style="{StaticResource Text.Meta}"
                                           TextWrapping="Wrap" />

                                <TextBlock Text="轮次预算" Style="{StaticResource SettingsSection}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                        <TextBlock Text="每次回答最多轮次" Style="{StaticResource SettingsLabel}" />
                                        <TextBox Text="{Binding MaxTurnsPerRun}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="6,0">
                                        <TextBlock Text="每轮最多工具调用" Style="{StaticResource SettingsLabel}" />
                                        <TextBox Text="{Binding MaxToolCallsPerTurn}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="6,0">
                                        <TextBlock Text="只读工具并发" Style="{StaticResource SettingsLabel}" />
                                        <TextBox Text="{Binding MaxParallelReadTools}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Margin="6,0,0,0">
                                        <TextBlock Text="工具输出最多行数" Style="{StaticResource SettingsLabel}" />
                                        <TextBox Text="{Binding ToolOutputMaxLines}" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="审计" Style="{StaticResource SettingsSection}" />
                                <TextBlock Text="{Binding AuditFileSummary}" Style="{StaticResource Text.Meta}" />
                                <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                    <Button Content="查看审计" Style="{StaticResource Button.Ghost}" Command="{Binding RefreshAuditCommand}" />
                                    <Button Margin="6,0,0,0" Content="导出审计" Style="{StaticResource Button.Ghost}" Command="{Binding ExportAuditCommand}" />
                                    <Button Margin="6,0,0,0" Content="清空审计" Style="{StaticResource Button.Ghost}" Command="{Binding ClearAuditCommand}" />
                                </StackPanel>
                                <TextBox Margin="0,8,0,0"
                                         Height="160"
                                         IsReadOnly="True"
                                         AcceptsReturn="True"
                                         TextWrapping="NoWrap"
                                         HorizontalScrollBarVisibility="Auto"
                                         VerticalScrollBarVisibility="Auto"
                                         FontFamily="{StaticResource Font.Family.Code}"
                                         Text="{Binding AuditText, Mode=OneWay}"
                                         Visibility="{Binding IsAuditVisible, Converter={StaticResource BoolToVisibility}}" />

                                <TextBlock Margin="0,10,0,0"
                                           Text="{Binding DataStatus}"
                                           Style="{StaticResource Text.Meta}"
                                           Foreground="{DynamicResource Brush.Accent}" />
                            </StackPanel>

                            <!-- 外观 -->
                            <StackPanel Visibility="{Binding IsAppearancePage, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="外观" Style="{StaticResource Text.Section}" Margin="0,14,0,4" />
                                <CheckBox Content="启动时折叠右栏对话" IsChecked="{Binding RightPaneCollapsedByDefault}" />
                                <TextBlock Margin="0,6,0,0"
                                           Text="高对比模式：跟随系统设置；开启后品牌绿替换为系统强调色，边框与选中态加强。"
                                           Style="{StaticResource Text.Meta}"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,2,0,0"
                                           Text="界面缩放与「减少动画」跟随 Windows 设置，不单独覆盖。"
                                           Style="{StaticResource Text.Meta}"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,14,0,0"
                                           Text="当前主题：浅色（V1 不提供深色主题）"
                                           Style="{StaticResource Text.Body}" />
                            </StackPanel>

                            <!-- 快捷键 -->
                            <StackPanel Visibility="{Binding IsShortcutsPage, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="快捷键" Style="{StaticResource Text.Section}" Margin="0,14,0,4" />
                                <ItemsControl ItemsSource="{Binding Shortcuts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="30">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Keys}"
                                                           Style="{StaticResource Text.Code}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Action}"
                                                           Style="{StaticResource Text.Body}"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Margin="0,10,0,0"
                                           Text="所有 P0 操作都可以只用键盘完成：发送、停止、切换会话、审批、关闭浮层。"
                                           Style="{StaticResource Text.Meta}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- 数据 -->
                            <StackPanel Visibility="{Binding IsDataPage, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="数据与隐私" Style="{StaticResource Text.Section}" Margin="0,14,0,4" />
                                <TextBlock Text="数据目录" Style="{StaticResource SettingsLabel}" />
                                <TextBox IsReadOnly="True" Text="{Binding DataDirectory, Mode=OneWay}" />
                                <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                    <Button Content="打开数据目录" Style="{StaticResource Button.Ghost}" Command="{Binding OpenDataFolderCommand}" />
                                    <Button Margin="6,0,0,0" Content="打开导出目录" Style="{StaticResource Button.Ghost}" Command="{Binding OpenExportsFolderCommand}" />
                                </StackPanel>

                                <TextBlock Text="导出" Style="{StaticResource SettingsSection}" />
                                <TextBlock Text="导出全部会话：Markdown + JSON，不含 API Key；冲突时新建目录，不覆盖。"
                                           Style="{StaticResource Text.Meta}"
                                           TextWrapping="Wrap" />
                                <Button Margin="0,6,0,0"
                                        HorizontalAlignment="Left"
                                        Content="导出全部会话"
                                        Style="{StaticResource Button.Ghost}"
                                        Command="{Binding ExportAllCommand}" />

                                <TextBlock Text="日志" Style="{StaticResource SettingsSection}" />
                                <TextBlock Text="{Binding LogFileSummary}" Style="{StaticResource Text.Meta}" />
                                <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                    <Button Content="查看日志" Style="{StaticResource Button.Ghost}" Command="{Binding RefreshLogsCommand}" />
                                    <Button Margin="6,0,0,0" Content="导出诊断包" Style="{StaticResource Button.Ghost}" Command="{Binding ExportDiagnosticsCommand}" />
                                    <Button Margin="6,0,0,0" Content="清空日志" Style="{StaticResource Button.Ghost}" Command="{Binding ClearLogsCommand}" />
                                </StackPanel>
                                <TextBox Margin="0,8,0,0"
                                         Height="140"
                                         IsReadOnly="True"
                                         AcceptsReturn="True"
                                         TextWrapping="NoWrap"
                                         HorizontalScrollBarVisibility="Auto"
                                         VerticalScrollBarVisibility="Auto"
                                         FontFamily="{StaticResource Font.Family.Code}"
                                         Text="{Binding LogText, Mode=OneWay}"
                                         Visibility="{Binding IsLogVisible, Converter={StaticResource BoolToVisibility}}" />

                                <TextBlock Text="工具输出缓存" Style="{StaticResource SettingsSection}" />
                                <TextBlock Text="{Binding ToolOutputSummary}" Style="{StaticResource Text.Meta}" />
                                <Button Margin="0,6,0,0"
                                        HorizontalAlignment="Left"
                                        Content="清空缓存"
                                        Style="{StaticResource Button.Ghost}"
                                        Command="{Binding ClearToolOutputCommand}" />

                                <TextBlock Margin="0,10,0,0"
                                           Text="{Binding DataStatus}"
                                           Style="{StaticResource Text.Meta}"
                                           Foreground="{DynamicResource Brush.Accent}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- 关于 -->
                            <StackPanel Visibility="{Binding IsAboutPage, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="关于与更新" Style="{StaticResource Text.Section}" Margin="0,14,0,4" />
                                <TextBlock Text="{Binding VersionText}" Style="{StaticResource Text.H2}" />
                                <TextBlock Margin="0,4,0,0" Text="{Binding RuntimeText}" Style="{StaticResource Text.Body}" />
                                <TextBlock Margin="0,2,0,0" Text="{Binding OsText}" Style="{StaticResource Text.Body}" />
                                <TextBlock Margin="0,12,0,0"
                                           Text="MiaoWu 是本地桌面智能体工作台。会话保存在工作区 .agent 目录，API Key 用 DPAPI 加密，只保存在本机。"
                                           Style="{StaticResource Text.Meta}"
                                           TextWrapping="Wrap" />
                                <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                                    <Button Content="检查更新" Style="{StaticResource Button.Primary}" Command="{Binding CheckUpdateCommand}" />
                                    <Button Margin="8,0,0,0" Content="打开下载页" Style="{StaticResource Button.Ghost}" Command="{Binding OpenDownloadCommand}" />
                                </StackPanel>
                                <TextBlock Margin="0,8,0,0"
                                           Text="{Binding UpdateStatus}"
                                           Style="{StaticResource Text.Meta}"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,18,0,0"
                                           Text="第三方组件：无运行时 NuGet；JSON、Markdown、diff、SSE 均为本仓库手写实现。"
                                           Style="{StaticResource Text.Meta}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
