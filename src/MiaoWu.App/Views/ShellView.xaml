<UserControl x:Class="MiaoWu.App.Views.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             xmlns:controls="clr-namespace:MiaoWu.App.Controls"
             xmlns:conv="clr-namespace:MiaoWu.App.Converters"
             xmlns:views="clr-namespace:MiaoWu.App.Views"
             xmlns:res="clr-namespace:MiaoWu.App.Resources"
             mc:Ignorable="d"
             d:DesignWidth="1440"
             d:DesignHeight="900"
             x:Name="ShellRoot"
             Focusable="False"
             Background="{DynamicResource Brush.Side}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             AutomationProperties.AutomationId="Shell">

    <UserControl.InputBindings>
        <KeyBinding Key="J" Modifiers="Control" Command="{Binding ToggleRightPaneCommand}" />
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewSessionCommand}" />
        <KeyBinding Key="OemComma" Modifiers="Control" Command="{Binding OpenSettingsCommand}" />
        <KeyBinding Key="Escape" Command="{Binding Overlay.CloseCommand}" />
    </UserControl.InputBindings>

    <UserControl.Resources>
        <conv:DoubleToGridLengthConverter x:Key="DoubleToGridLength" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
    </UserControl.Resources>

    <Grid x:Name="Root"
          Background="{DynamicResource Brush.Side}"
          SizeChanged="OnRootSizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶栏 -->
        <Grid x:Name="TopBar"
              Grid.Row="0"
              Height="{StaticResource Metric.TopBar.Height}"
              Background="{DynamicResource Brush.Canvas}"
              AutomationProperties.AutomationId="TopBar"
              AutomationProperties.Name="{x:Static res:Strings.TopBarAutomation}">

            <Rectangle Width="{Binding LeftPaneWidth}"
                       HorizontalAlignment="Left"
                       Fill="{DynamicResource Brush.Side}"
                       IsHitTestVisible="False" />

            <StackPanel Orientation="Horizontal"
                        Margin="{StaticResource Pad.TopBar}"
                        VerticalAlignment="Center">
                <Image Width="{StaticResource Metric.Icon.Brand}"
                       Height="{StaticResource Metric.Icon.Brand}"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Source="pack://application:,,,/MiaoWu;component/Assets/Branding/MiaoWu.ico" />
                <TextBlock Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           Text="{x:Static res:Strings.AppName}"
                           Style="{StaticResource Text.AppName}" />
            </StackPanel>

            <Button x:Name="TopBarToggle"
                    Width="{StaticResource Metric.TopBar.ToggleSize}"
                    Height="{StaticResource Metric.TopBar.ToggleSize}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Style="{StaticResource Button.Icon}"
                    Command="{Binding ToggleRightPaneCommand}"
                    ToolTip="{Binding ToggleRightPaneToolTip}"
                    AutomationProperties.AutomationId="TopBarToggle"
                    AutomationProperties.Name="{Binding ToggleRightPaneToolTip}"
                    KeyboardNavigation.TabIndex="100"
                    Margin="{Binding TopBarToggleMargin}"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Grid Width="{StaticResource Metric.Icon}" Height="{StaticResource Metric.Icon}">
                    <Path Fill="{DynamicResource Brush.Text2}">
                        <Path.Style>
                            <Style TargetType="Path" BasedOn="{StaticResource Icon}">
                                <Setter Property="Data" Value="{StaticResource Ico.PanelCollapse}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRightPaneCollapsed}" Value="True">
                                        <Setter Property="Data" Value="{StaticResource Ico.PanelExpand}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                    <Ellipse Width="6"
                             Height="6"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Top"
                             Margin="0,-2,-2,0"
                             Fill="{DynamicResource Brush.Warning}"
                             Visibility="{Binding HasPendingApproval, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Button>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <Button x:Name="WindowMinimize"
                        Style="{StaticResource Button.Window}"
                        Click="OnMinimizeClick"
                        ToolTip="{x:Static res:Strings.WindowMinimize}"
                        AutomationProperties.AutomationId="WindowMinimize"
                        AutomationProperties.Name="{x:Static res:Strings.WindowMinimize}"
                        KeyboardNavigation.TabIndex="110"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path Style="{StaticResource Icon.WindowGlyph}"
                          Data="{StaticResource Ico.WindowMinimize}"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
                <Button x:Name="WindowMaximize"
                        Style="{StaticResource Button.Window}"
                        Click="OnMaximizeRestoreClick"
                        ToolTip="{x:Static res:Strings.WindowMaximize}"
                        AutomationProperties.AutomationId="WindowMaximize"
                        AutomationProperties.Name="{x:Static res:Strings.WindowMaximize}"
                        KeyboardNavigation.TabIndex="111"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                        <Path.Style>
                            <Style TargetType="Path" BasedOn="{StaticResource Icon.WindowGlyph}">
                                <Setter Property="Data" Value="{StaticResource Ico.WindowMaximize}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMaximized}" Value="True">
                                        <Setter Property="Data" Value="{StaticResource Ico.WindowRestore}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </Button>
                <Button x:Name="WindowClose"
                        Style="{StaticResource Button.WindowClose}"
                        Click="OnCloseClick"
                        ToolTip="{x:Static res:Strings.WindowClose}"
                        AutomationProperties.AutomationId="WindowClose"
                        AutomationProperties.Name="{x:Static res:Strings.WindowClose}"
                        KeyboardNavigation.TabIndex="112"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path Style="{StaticResource Icon.WindowGlyph}"
                          Data="{StaticResource Ico.WindowClose}"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- 三栏主体 -->
        <Grid x:Name="Body"
              Grid.Row="1"
              Background="{DynamicResource Brush.Canvas}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumn"
                                  Width="{Binding LeftPaneWidth, Converter={StaticResource DoubleToGridLength}}"
                                  MinWidth="{StaticResource Metric.Left.Min}"
                                  MaxWidth="{StaticResource Metric.Left.Max}" />
                <ColumnDefinition Width="{StaticResource GridLength.Splitter}" />
                <ColumnDefinition Width="*" MinWidth="{StaticResource Metric.Middle.Min}" />
                <ColumnDefinition Width="{StaticResource GridLength.Splitter}" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <views:LeftPaneView x:Name="LeftPane"
                                Grid.Column="0"
                                DataContext="{Binding Left}" />

            <controls:PaneSplitter x:Name="LeftSplitter"
                                   Grid.Column="1"
                                   Panel.ZIndex="10"
                                   Style="{StaticResource PaneSplitter}"
                                   Value="{Binding LeftPaneWidth, Mode=TwoWay}"
                                   Minimum="{StaticResource Metric.Left.Min}"
                                   Maximum="{Binding LeftPaneMax}"
                                   IsRight="False"
                                   AutomationProperties.AutomationId="LeftSplitter"
                                   AutomationProperties.Name="{x:Static res:Strings.LeftSplitterAutomation}" />

            <views:CanvasPaneView x:Name="MiddlePane"
                                  Grid.Column="2"
                                  DataContext="{Binding Canvas}" />

            <controls:PaneSplitter x:Name="RightSplitter"
                                   Grid.Column="3"
                                   Panel.ZIndex="10"
                                   Style="{StaticResource PaneSplitter}"
                                   Value="{Binding RightExpandedWidth, Mode=TwoWay}"
                                   Minimum="{StaticResource Metric.Right.Min}"
                                   Maximum="{Binding RightPaneMax}"
                                   IsRight="True"
                                   IdleLineVisible="True"
                                   Visibility="{Binding IsRightPaneCollapsed, Converter={StaticResource InverseBoolToVisibility}}"
                                   AutomationProperties.AutomationId="RightSplitter"
                                   AutomationProperties.Name="{x:Static res:Strings.RightSplitterAutomation}" />

            <!-- 右栏（P3 接对话；P2 保留 P1 轮廓用于布局回归） -->
            <controls:CollapsiblePane x:Name="RightPane"
                                      Grid.Column="4"
                                      Style="{StaticResource CollapsiblePane}"
                                      Background="{DynamicResource Brush.Canvas}"
                                      ExpandedWidth="{Binding RightExpandedWidth}"
                                      IsCollapsed="{Binding IsRightPaneCollapsed, Mode=OneWay}"
                                      DurationMilliseconds="{StaticResource Motion.PanelMs}"
                                      AutomationProperties.AutomationId="RightPane"
                                      AutomationProperties.Name="{x:Static res:Strings.RightPaneAutomation}">
                <Grid>
                    <views:ConversationPaneView x:Name="ConversationPane"
                                                DataContext="{Binding Conversation}" />

                    <!-- P2 的静态占位已由真实对话替换；保留为折叠的布局回归样本。 -->
                    <Grid Visibility="Collapsed" Background="{DynamicResource Brush.Canvas}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Height="{StaticResource Metric.RightTitle.Height}" Margin="14,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{x:Static res:Strings.PlaceholderConversationTitle}"
                                       Style="{StaticResource Text.Section}" />
                            <Path Margin="4,0,0,0"
                                  Style="{StaticResource Icon}"
                                  Data="{StaticResource Ico.ChevronDown}"
                                  Fill="{DynamicResource Brush.Text3}" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                            <Path Margin="0,0,10,0"
                                  Style="{StaticResource Icon}"
                                  Data="{StaticResource Ico.Pin}"
                                  Fill="{DynamicResource Brush.Text3}" />
                            <Path Style="{StaticResource Icon.Solid}"
                                  Data="{StaticResource Ico.More}"
                                  Fill="{DynamicResource Brush.Text3}" />
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="14,16,16,16">
                            <StackPanel Margin="0,0,0,17">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="{StaticResource Metric.Avatar}"
                                            Height="{StaticResource Metric.Avatar}"
                                            Background="{DynamicResource Brush.Sel}"
                                            CornerRadius="11">
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Text="{x:Static res:Strings.UserInitial}"
                                                   FontSize="{StaticResource Font.Group.Size}"
                                                   Foreground="{DynamicResource Brush.Text2}" />
                                    </Border>
                                    <TextBlock Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               Text="{x:Static res:Strings.UserInitial}"
                                               Style="{StaticResource Text.Time}"
                                               Foreground="{DynamicResource Brush.Text}"
                                               FontWeight="{StaticResource Font.Weight.SemiBold}" />
                                    <TextBlock Margin="6,0,0,0"
                                               VerticalAlignment="Center"
                                               Text="10:38"
                                               Style="{StaticResource Text.Time}" />
                                </StackPanel>
                                <TextBlock Margin="30,4,0,0"
                                           Text="{x:Static res:Strings.PlaceholderMessageUser}"
                                           Style="{StaticResource Text.Body}" />
                            </StackPanel>

                            <StackPanel Margin="0,0,0,17">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="{StaticResource Metric.Avatar}"
                                            Height="{StaticResource Metric.Avatar}"
                                            Background="{DynamicResource Brush.AccentSoft}"
                                            CornerRadius="11">
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Text="{x:Static res:Strings.AssistantInitial}"
                                                   FontSize="{StaticResource Font.Group.Size}"
                                                   Foreground="{DynamicResource Brush.Accent}" />
                                    </Border>
                                    <TextBlock Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               Text="{x:Static res:Strings.AppName}"
                                               Style="{StaticResource Text.Time}"
                                               Foreground="{DynamicResource Brush.Text}"
                                               FontWeight="{StaticResource Font.Weight.SemiBold}" />
                                    <TextBlock Margin="6,0,0,0"
                                               VerticalAlignment="Center"
                                               Text="{x:Static res:Strings.PlaceholderMessageMeta}"
                                               Style="{StaticResource Text.Time}" />
                                </StackPanel>
                                <TextBlock Margin="30,4,0,0"
                                           Text="{x:Static res:Strings.PlaceholderMessageAssistant}"
                                           Style="{StaticResource Text.Body}" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <Border x:Name="RightInputShell"
                            Grid.Row="2"
                            Height="{StaticResource Metric.Input.Height}"
                            Margin="14,0,14,14"
                            Padding="{StaticResource Pad.Input}"
                            Background="{DynamicResource Brush.Canvas}"
                            BorderBrush="{DynamicResource Brush.Line3}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Input}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Height="{StaticResource Metric.Input.AttachmentRow}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Style="{StaticResource Chip}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{x:Static res:Strings.PlaceholderDocumentTitle}"
                                                       Style="{StaticResource Text.Chip}" />
                                            <Path Width="12" Height="12" Margin="4,0,0,0"
                                                  Style="{StaticResource Icon}"
                                                  Data="{StaticResource Ico.Close}"
                                                  Fill="{DynamicResource Brush.Text3}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Chip}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{x:Static res:Strings.PlaceholderImageName}"
                                                       Style="{StaticResource Text.Chip}" />
                                            <Path Width="12" Height="12" Margin="4,0,0,0"
                                                  Style="{StaticResource Icon}"
                                                  Data="{StaticResource Ico.Close}"
                                                  Fill="{DynamicResource Brush.Text3}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <TextBlock HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Text="{x:Static res:Strings.PlaceholderUsage}"
                                           Style="{StaticResource Text.Time}" />
                            </Grid>

                            <TextBlock Grid.Row="1"
                                       VerticalAlignment="Center"
                                       Text="{x:Static res:Strings.PlaceholderInput}"
                                       Style="{StaticResource Text.Body}" />

                            <Grid Grid.Row="2" Height="{StaticResource Metric.Input.ToolsRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Height="22"
                                        Padding="8,0"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource Brush.Tab}"
                                        CornerRadius="6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Static res:Strings.PlaceholderModel}"
                                                   Style="{StaticResource Text.Chip}" />
                                        <Path Margin="4,0,0,0"
                                              Style="{StaticResource Icon}"
                                              Data="{StaticResource Ico.ChevronDown}"
                                              Fill="{DynamicResource Brush.Text3}" />
                                    </StackPanel>
                                </Border>

                                <StackPanel Grid.Column="1"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal">
                                    <!-- 过渡：paperclip.svg 在 16px 下糊成一团 -->
                                    <Path Margin="0,0,10,0"
                                          Style="{StaticResource Icon.Stroke}"
                                          Data="{StaticResource Ico.Paperclip}"
                                          Stroke="{DynamicResource Brush.Text3}" />
                                    <Path Style="{StaticResource Icon}"
                                          Data="{StaticResource Ico.Image}"
                                          Fill="{DynamicResource Brush.Text3}" />
                                </StackPanel>

                                <TextBlock Grid.Column="3"
                                           Margin="8,0"
                                           VerticalAlignment="Center"
                                           Text="{x:Static res:Strings.PlaceholderSendHint}"
                                           Style="{StaticResource Text.Time}" />

                                <Border Grid.Column="4"
                                        Width="27"
                                        Height="27"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource Brush.Accent}"
                                        CornerRadius="{StaticResource Radius.Button}">
                                    <Path Width="14"
                                          Height="14"
                                          Style="{StaticResource Icon}"
                                          Data="{StaticResource Ico.Send}"
                                          Fill="{DynamicResource Brush.White}" />
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
                </Grid>
            </controls:CollapsiblePane>
        </Grid>

        <!-- 浮层：设置 / 应用内通知 -->
        <views:SettingsView Grid.RowSpan="2"
                            Panel.ZIndex="200"
                            DataContext="{Binding Settings}"
                            Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />

        <views:NotificationHost Grid.Row="1"
                                Panel.ZIndex="130"
                                Width="{StaticResource Metric.Notification.Width}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                DataContext="{Binding}" />

        <views:OverlayView Grid.RowSpan="2"
                           Panel.ZIndex="220"
                           DataContext="{Binding Overlay}" />
    </Grid>
</UserControl>
