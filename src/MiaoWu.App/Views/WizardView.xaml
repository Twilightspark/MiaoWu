<UserControl x:Class="MiaoWu.App.Views.WizardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:res="clr-namespace:MiaoWu.App.Resources"
             mc:Ignorable="d"
             d:DesignWidth="1440"
             d:DesignHeight="900"
             x:Name="Root"
             Focusable="False"
             Background="Transparent">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid>
        <Border Background="{DynamicResource Brush.Scrim}" />

        <Border Width="760"
                Height="540"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource Brush.Canvas}"
                BorderBrush="{DynamicResource Brush.Line2}"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius.Notification}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="58" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="22,0,14,0">
                    <TextBlock VerticalAlignment="Center"
                               Text="欢迎使用 MiaoWu"
                               Style="{StaticResource Text.Section}" />
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center"
                                   Text="{Binding StepText}"
                                   Style="{StaticResource Text.Meta}" />
                        <Button Margin="10,0,0,0"
                                Style="{StaticResource Button.Icon}"
                                Command="{Binding CloseCommand}"
                                ToolTip="稍后再说"
                                AutomationProperties.Name="关闭向导">
                            <Path Style="{StaticResource Icon}"
                                  Data="{StaticResource Ico.Close}"
                                  Fill="{DynamicResource Brush.Text3}" />
                        </Button>
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="1"
                              Padding="22,0,22,0"
                              VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <!-- 1 欢迎 / 隐私 -->
                        <StackPanel Visibility="{Binding IsWelcomeStep, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="本地优先的智能体工作台"
                                       Style="{StaticResource Text.H1}" />
                            <TextBlock Margin="0,10,0,0"
                                       Text="MiaoWu 在你的电脑上运行。会话保存在每个工作区的 .agent 目录，API Key 用 Windows DPAPI 加密后只保存在本机。"
                                       Style="{StaticResource Text.Body}"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,14,0,0"
                                       Text="隐私要点"
                                       Style="{StaticResource Text.H3}" />
                            <TextBlock Margin="0,6,0,0"
                                       Text="· 只有你发送的消息与必要上下文会发给你配置的模型服务商。&#10;· 读写文件与执行命令都需要你逐次审批；危险操作会被直接拦截。&#10;· 日志不含消息正文与密钥，可随时清空或导出诊断包。"
                                       Style="{StaticResource Text.Body}"
                                       TextWrapping="Wrap"
                                       LineHeight="{StaticResource Font.Body.Line}" />
                        </StackPanel>

                        <!-- 2 数据目录 -->
                        <StackPanel Visibility="{Binding IsDataStep, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="数据目录" Style="{StaticResource Text.H1}" />
                            <TextBlock Margin="0,10,0,0"
                                       Text="全局配置、密钥备份、日志与导出默认放在这里。改变位置需要重启应用；首次启动使用默认目录即可。"
                                       Style="{StaticResource Text.Body}"
                                       TextWrapping="Wrap" />
                            <TextBox Margin="0,14,0,0" IsReadOnly="True" Text="{Binding DataDirectory, Mode=OneWay}" />
                            <TextBlock Margin="0,8,0,0"
                                       Text="工作区内的 .agent 目录不受这里影响，它会跟随工作区一起备份。"
                                       Style="{StaticResource Text.Meta}" />
                        </StackPanel>

                        <!-- 3 Provider -->
                        <StackPanel Visibility="{Binding IsProviderStep, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="连接模型（可跳过）" Style="{StaticResource Text.H1}" />
                            <TextBlock Margin="0,8,0,0"
                                       Text="填一个 API Key 就能开始对话。也可以稍后在“设置 → 模型与 Provider”配置。"
                                       Style="{StaticResource Text.Body}"
                                       TextWrapping="Wrap" />

                            <TextBlock Margin="0,14,0,4" Text="服务商" Style="{StaticResource Text.Meta}" />
                            <ComboBox Width="300"
                                      HorizontalAlignment="Left"
                                      ItemsSource="{Binding ProviderChoices}"
                                      SelectedItem="{Binding SelectedChoice, Mode=TwoWay}"
                                      DisplayMemberPath="DisplayName" />

                            <TextBlock Margin="0,10,0,4" Text="API Key" Style="{StaticResource Text.Meta}" />
                            <PasswordBox x:Name="ApiKeyBox"
                                         Width="420"
                                         HorizontalAlignment="Left"
                                         PasswordChanged="OnApiKeyChanged" />
                            <TextBlock Margin="0,6,0,0"
                                       Text="{Binding ProviderStatus}"
                                       Style="{StaticResource Text.Meta}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- 4 工作区 -->
                        <StackPanel Visibility="{Binding IsWorkspaceStep, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="选择工作区" Style="{StaticResource Text.H1}" />
                            <TextBlock Margin="0,8,0,0"
                                       Text="工作区是 MiaoWu 读写文件的范围；会话记录也保存在它的 .agent 目录里。"
                                       Style="{StaticResource Text.Body}"
                                       TextWrapping="Wrap" />

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding WorkspacePath, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1"
                                        Margin="8,0,0,0"
                                        Content="浏览…"
                                        Style="{StaticResource Button.Ghost}"
                                        Command="{Binding PickWorkspaceCommand}" />
                            </Grid>
                            <TextBlock Margin="0,8,0,0"
                                       Text="建议选择一个代码仓库或文档目录；之后可以在左栏继续添加。"
                                       Style="{StaticResource Text.Meta}" />
                        </StackPanel>

                        <!-- 5 完成 -->
                        <StackPanel Visibility="{Binding IsFinishStep, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="准备就绪" Style="{StaticResource Text.H1}" />
                            <TextBlock Margin="0,8,0,0"
                                       Text="点“完成”进入主窗口。左侧是工作区与会话，中间是文件预览，右侧是对话。"
                                       Style="{StaticResource Text.Body}"
                                       TextWrapping="Wrap" />
                            <CheckBox Margin="0,16,0,0"
                                      Content="允许模型使用内置工具（读文件、搜索、写文件、执行命令）"
                                      IsChecked="{Binding EnableTools}" />
                            <TextBlock Margin="0,6,0,0"
                                       Text="随时可以在设置里关闭；写文件与命令始终需要审批。"
                                       Style="{StaticResource Text.Meta}" />
                            <Border Margin="0,18,0,0"
                                    Padding="12,10"
                                    Background="{DynamicResource Brush.WarningSoft}"
                                    CornerRadius="{StaticResource Radius.Card}"
                                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding ErrorText}"
                                           Style="{StaticResource Text.Meta}"
                                           Foreground="{DynamicResource Brush.Danger}"
                                           TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <Grid Grid.Row="2" Margin="22,0,22,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="上一步"
                                Style="{StaticResource Button.Ghost}"
                                Command="{Binding BackCommand}"
                                Visibility="{Binding CanBack, Converter={StaticResource BoolToVisibility}}" />
                        <Button Margin="8,0,0,0"
                                Content="稍后配置"
                                Style="{StaticResource Button.Ghost}"
                                Command="{Binding SkipCommand}"
                                Visibility="{Binding IsProviderStep, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="下一步"
                                Style="{StaticResource Button.Primary}"
                                Command="{Binding NextCommand}"
                                Visibility="{Binding ShowNext, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="完成"
                                Style="{StaticResource Button.Primary}"
                                Command="{Binding FinishCommand}"
                                Visibility="{Binding IsFinishStep, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
