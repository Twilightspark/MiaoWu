<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>MiaoWu.Infrastructure</RootNamespace>
    <AssemblyName>MiaoWu.Infrastructure</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- DPAPI（secrets.dat）与 HTTP 流式请求都是框架程序集，不引入 NuGet。 -->
    <Reference Include="System.Security" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <!-- 文件删除到回收站；Microsoft.VisualBasic 属于 .NET Framework 自带程序集。 -->
    <Reference Include="Microsoft.VisualBasic" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MiaoWu.Core\MiaoWu.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 程序预设技能：技能正文、示例与 WPS 桥 exe 都嵌进程序集，
         启动时由 PresetSkillInstaller 释放到用户级技能目录，能力市场默认可见。 -->
    <EmbeddedResource Include="..\..\skills\office-wps\SKILL.md">
      <LogicalName>MiaoWu.Presets.office-wps.SKILL.md</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\skills\office-wps\bin\miaowu_office.exe">
      <LogicalName>MiaoWu.Presets.office-wps.bin.miaowu_office.exe</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\skills\office-wps\examples\*.json">
      <LogicalName>MiaoWu.Presets.office-wps.examples.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
